H.decodeLogoBase64 = function(data)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #alphabet do lookup[string.sub(alphabet, i, i)] = i - 1 end
    local chunks, pending = {}, {}
    local accumulator, bitCount = 0, 0
    for i = 1, #data do
        local value = lookup[string.sub(data, i, i)]
        if value ~= nil then
            accumulator = accumulator * 64 + value
            bitCount = bitCount + 6
            if bitCount >= 8 then
                bitCount = bitCount - 8
                local byteValue = math.floor(accumulator / (2 ^ bitCount)) % 256
                pending[#pending + 1] = string.char(byteValue)
                accumulator = accumulator % (2 ^ bitCount)
                if #pending >= 256 then
                    chunks[#chunks + 1] = table.concat(pending)
                    pending = {}
                end
            end
        end
    end
    if #pending > 0 then chunks[#chunks + 1] = table.concat(pending) end
    return table.concat(chunks)
end

H.EMBEDDED_LOGO_PALETTE = {}
for i, rgb in ipairs(H.EMBEDDED_LOGO_PALETTE_RGB) do
    H.EMBEDDED_LOGO_PALETTE[i] = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

H.getEmbeddedLogoIndexes = function()
    if H.embeddedLogoRawIndexes then return H.embeddedLogoRawIndexes end
    local indexes = H.decodeLogoBase64(H.EMBEDDED_LOGO_DATA_BASE64)
    if #indexes ~= H.EMBEDDED_LOGO_SIZE * H.EMBEDDED_LOGO_SIZE then
        error("Nexus Hub logo data is incomplete")
    end
    H.embeddedLogoRawIndexes = indexes
    return indexes
end

H.createEmbeddedLogoEditableImage = function()
    local ok, result = pcall(function()
        local AssetService = game:GetService("AssetService")
        local size = H.EMBEDDED_LOGO_SIZE
        local indexes = H.getEmbeddedLogoIndexes()
        local editable = AssetService:CreateEditableImage({Size = Vector2.new(size, size)})
        if not editable then error("CreateEditableImage returned nil") end
        local pixelBuffer = buffer.create(size * size * 4)
        for i = 1, size * size do
            local paletteIndex = string.byte(indexes, i)
            local offset = (i - 1) * 4
            if paletteIndex == 0 then
                buffer.writeu8(pixelBuffer, offset, 0)
                buffer.writeu8(pixelBuffer, offset + 1, 0)
                buffer.writeu8(pixelBuffer, offset + 2, 0)
                buffer.writeu8(pixelBuffer, offset + 3, 0)
            else
                local rgb = H.EMBEDDED_LOGO_PALETTE_RGB[paletteIndex]
                if rgb then
                    buffer.writeu8(pixelBuffer, offset, rgb[1])
                    buffer.writeu8(pixelBuffer, offset + 1, rgb[2])
                    buffer.writeu8(pixelBuffer, offset + 2, rgb[3])
                    buffer.writeu8(pixelBuffer, offset + 3, 255)
                else
                    buffer.writeu8(pixelBuffer, offset, 0)
                    buffer.writeu8(pixelBuffer, offset + 1, 0)
                    buffer.writeu8(pixelBuffer, offset + 2, 0)
                    buffer.writeu8(pixelBuffer, offset + 3, 0)
                end
            end
        end
        editable:WritePixelsBuffer(Vector2.zero, Vector2.new(size, size), pixelBuffer)
        return editable
    end)
    if ok then
        H.embeddedLogoEditableImage = result
        return result
    end
    warn("[Nexus Hub] EditableImage unavailable; using embedded raster fallback: " .. tostring(result))
    return nil
end

H.buildEmbeddedLogoFallback = function(parent, zIndex)
    local indexes = H.getEmbeddedLogoIndexes()
    local sourceSize = H.EMBEDDED_LOGO_SIZE
    local size = H.EMBEDDED_LOGO_FALLBACK_SIZE
    local canvas = Instance.new("Frame")
    canvas.Name = "NexusEmbeddedLogoCanvas"
    canvas.BackgroundTransparency = 1
    canvas.BorderSizePixel = 0
    canvas.Position = UDim2.fromScale(0, 0)
    canvas.Size = UDim2.fromScale(1, 1)
    canvas.ClipsDescendants = true
    canvas.ZIndex = zIndex or ((parent.ZIndex or 1) + 1)
    canvas.Parent = parent

    local sampledRows = {}
    for y = 1, size do
        local sy = math.clamp(math.floor((y - 0.5) * sourceSize / size) + 1, 1, sourceSize)
        local row = {}
        for x = 1, size do
            local sx = math.clamp(math.floor((x - 0.5) * sourceSize / size) + 1, 1, sourceSize)
            row[x] = string.byte(indexes, (sy - 1) * sourceSize + sx) or 0
        end
        sampledRows[y] = row
    end

    -- Merge same-colour horizontal runs vertically where possible to keep the UI object count lower.
    local activeRuns = {}
    for y, row in ipairs(sampledRows) do
        local nextActive = {}
        local x = 1
        while x <= size do
            local code = row[x]
            if code == 0 then
                x = x + 1
            else
                local runStart = x
                x = x + 1
                while x <= size and row[x] == code do x = x + 1 end
                local key = tostring(runStart) .. ":" .. tostring(x) .. ":" .. tostring(code)
                local entry = activeRuns[key]
                if entry then
                    entry.rows = entry.rows + 1
                    entry.frame.Size = UDim2.new((x - runStart) / size, 0, entry.rows / size, 0)
                    nextActive[key] = entry
                else
                    local pixel = Instance.new("Frame")
                    pixel.Name = "LogoPixel"
                    pixel.BorderSizePixel = 0
                    pixel.BackgroundTransparency = 0
                    pixel.BackgroundColor3 = H.EMBEDDED_LOGO_PALETTE[code] or Color3.fromRGB(120, 40, 220)
                    pixel.Position = UDim2.new((runStart - 1) / size, 0, (y - 1) / size, 0)
                    pixel.Size = UDim2.new((x - runStart) / size, 0, 1 / size, 0)
                    pixel.ZIndex = canvas.ZIndex + 1
                    pixel.Parent = canvas
                    nextActive[key] = {frame = pixel, rows = 1}
                end
            end
        end
        activeRuns = nextActive
    end
    return canvas
end

H.buildEmbeddedLogoCanvas = function(parent, zIndex)
    if H.hasNexusLogoAsset or not parent then return nil end
    local editable = H.createEmbeddedLogoEditableImage()
    if editable then
        local ok, imageLabel = pcall(function()
            local label = Instance.new("ImageLabel")
            label.Name = "NexusEmbeddedLogoCanvas"
            label.BackgroundTransparency = 1
            label.BorderSizePixel = 0
            label.Position = UDim2.fromScale(0, 0)
            label.Size = UDim2.fromScale(1, 1)
            label.ScaleType = Enum.ScaleType.Fit
            label.ResampleMode = Enum.ResamplerMode.Default
            label.ZIndex = zIndex or ((parent.ZIndex or 1) + 1)
            label.ImageContent = Content.fromObject(editable)
            label.Parent = parent
            return label
        end)
        if ok then return imageLabel end
        pcall(function() editable:Destroy() end)
        warn("[Nexus Hub] Could not attach EditableImage to ImageLabel; using raster fallback: " .. tostring(imageLabel))
    end
    return H.buildEmbeddedLogoFallback(parent, zIndex)
end

H.mountEmbeddedLogo = function(parent, zIndex)
    if H.hasNexusLogoAsset or not H.embeddedLogoCanvas or not parent then return end
    H.embeddedLogoCanvas.Parent = parent
    H.embeddedLogoCanvas.Position = UDim2.fromScale(0, 0)
    H.embeddedLogoCanvas.Size = UDim2.fromScale(1, 1)
    H.embeddedLogoCanvas.ZIndex = zIndex or ((parent.ZIndex or 1) + 1)
    H.embeddedLogoCanvas.BackgroundTransparency = 1
    for _, pixel in ipairs(H.embeddedLogoCanvas:GetChildren()) do
        if pixel:IsA("Frame") then
            pixel.ZIndex = H.embeddedLogoCanvas.ZIndex + 1
            pixel.BackgroundTransparency = 0
        end
    end
    if H.brandGlyph then H.brandGlyph.Visible = false end
    if H.loadingLogoText then H.loadingLogoText.Visible = false end
    if H.openButton then H.openButton.Text = "" end
    local dark = Color3.fromRGB(5, 2, 14)
    if H.brandMark then H.brandMark.BackgroundColor3 = dark end
    if H.loadingLogo then H.loadingLogo.BackgroundColor3 = dark end
    if H.openButton then H.openButton.BackgroundColor3 = dark end
    if H.openButtonGradient then
        H.openButtonGradient.Color = ColorSequence.new(Color3.fromRGB(24, 5, 50), dark)
    end
end

