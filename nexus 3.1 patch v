H.toastLayout = Instance.new("UIListLayout")
H.toastLayout.FillDirection = Enum.FillDirection.Vertical
H.toastLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
H.toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
H.toastLayout.Padding = UDim.new(0, 7)
H.toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
H.toastLayout.Parent = H.toastContainer
H.showToast = function(message, isError)
    if not H.toastContainer or not H.toastContainer.Parent then return end
    H.toastSequence += 1
    local toast = Instance.new("Frame")
    toast.Name = "Toast_" .. tostring(H.toastSequence)
    toast.LayoutOrder = H.toastSequence
    toast.Size = UDim2.new(1, -16, 0, 42)
    toast.BackgroundColor3 = H.activeTheme.panel
    toast.BackgroundTransparency = 0.08
    toast.BorderSizePixel = 0
    toast.ZIndex = 181
    toast.Parent = H.toastContainer
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 11)
    local stroke = Instance.new("UIStroke", toast)
    stroke.Color = isError and H.activeTheme.danger or H.activeTheme.accent
    stroke.Transparency = 0.38
    stroke.Thickness = 1
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromOffset(12, 0)
    label.Size = UDim2.new(1, -24, 1, 0)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 11
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextColor3 = H.activeTheme.text
    label.Text = tostring(message)
    label.ZIndex = 182
    label.Parent = toast
    local scale = Instance.new("UIScale")
    scale.Scale = 0.94
    scale.Parent = toast
    toast.BackgroundTransparency = 1
    stroke.Transparency = 1
    label.TextTransparency = 1
    H.playSmoothTween(scale, 0.18, {Scale = 1}, Enum.EasingStyle.Back)
    H.playSmoothTween(toast, 0.18, {BackgroundTransparency = 0.08}, Enum.EasingStyle.Quint)
    H.playSmoothTween(stroke, 0.18, {Transparency = 0.38}, Enum.EasingStyle.Sine)
    H.playSmoothTween(label, 0.18, {TextTransparency = 0}, Enum.EasingStyle.Sine)
    task.delay(2.6, function()
        if not toast.Parent then return end
        H.playSmoothTween(scale, 0.16, {Scale = 0.96}, Enum.EasingStyle.Quad)
        H.playSmoothTween(toast, 0.16, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
        H.playSmoothTween(stroke, 0.14, {Transparency = 1}, Enum.EasingStyle.Quad)
        H.playSmoothTween(label, 0.14, {TextTransparency = 1}, Enum.EasingStyle.Quad)
        task.wait(0.18)
        if toast.Parent then toast:Destroy() end
    end)
    -- Keep the notification stack small, deleting only oldest toast frames.
    local toasts = {}
    for _, child in ipairs(H.toastContainer:GetChildren()) do if child:IsA("Frame") and child.Name:match("^Toast_") then table.insert(toasts, child) end end
    table.sort(toasts, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    while #toasts > 3 do local oldest = table.remove(toasts, 1); if oldest then oldest:Destroy() end end
end

-- Persistent favorites: store IDs in a JSON string so they travel through existing config/autosave.
H.syncFavoritesFromSetting = function()
    H.favorites = {}
    local raw = H.settings.FavoriteSettingsJSON
    if type(raw) == "string" then
        local ok, decoded = pcall(function() return H.HttpService:JSONDecode(raw) end)
        if ok and type(decoded) == "table" then
            for _, key in ipairs(decoded) do if type(key) == "string" and #key <= 180 then H.favorites[key] = true end end
        end
    end
    if H.updateFavoritePins then H.updateFavoritePins() end
    if H.renderFavorites then H.renderFavorites() end
end
H.saveFavoritesSetting = function()
    local keys = {}
    for key, enabled in pairs(H.favorites or {}) do if enabled then table.insert(keys, key) end end
    table.sort(keys)
    local ok, encoded = pcall(function() return H.HttpService:JSONEncode(keys) end)
    if ok then H.settings.FavoriteSettingsJSON = encoded end
end
H.addFavoritePin = function(control, pageName, label, key, valueLabel)
    local id = tostring(pageName .. "|" .. (key or label))
    H.favoriteControls[id] = {id = id, pageName = pageName, label = label, control = control}
    if control:IsA("TextButton") then
        local pad = control:FindFirstChildOfClass("UIPadding")
        if pad then pad.PaddingRight = UDim.new(0, 42) end
    end
    if valueLabel and valueLabel:IsA("TextLabel") then valueLabel.Size = UDim2.new(1, -43, 0, 23) end
    local pin = Instance.new("TextButton")
    pin.Name = "FavoritePin"
    pin:SetAttribute("NoLocalize", true)
    pin.BackgroundTransparency = 1
    pin.BorderSizePixel = 0
    pin.AnchorPoint = Vector2.new(1, 0)
    pin.Position = UDim2.new(1, -4, 0, 3)
    pin.Size = UDim2.fromOffset(25, 25)
    pin.Text = H.favorites[id] and "★" or "☆"
    pin.TextColor3 = H.favorites[id] and H.activeTheme.accent or H.activeTheme.muted
    pin.Font = Enum.Font.GothamBold
    pin.TextSize = 17
    pin.ZIndex = (control.ZIndex or 1) + 4
    pin.Parent = control
    control:SetAttribute("FavoriteId", id)
    H.favoriteControls[id].pin = pin
    pin.MouseEnter:Connect(function() H.playSmoothTween(pin, 0.12, {TextColor3 = H.activeTheme.accent}, Enum.EasingStyle.Sine) end)
    pin.MouseLeave:Connect(function() H.playSmoothTween(pin, 0.12, {TextColor3 = H.favorites[id] and H.activeTheme.accent or H.activeTheme.muted}, Enum.EasingStyle.Sine) end)
    pin.Activated:Connect(function()
        H.favorites[id] = not H.favorites[id] and true or nil
        H.saveFavoritesSetting()
        if H.updateFavoritePins then H.updateFavoritePins() end
        if H.renderFavorites then H.renderFavorites() end
        if H.savePersistentSettings then task.defer(function() pcall(H.savePersistentSettings, false) end) end
        if H.showToast then H.showToast((H.favorites[id] and "Добавлено в избранное: " or "Убрано из избранного: ") .. label) end
    end)
end
H.updateFavoritePins = function()
    for id, data in pairs(H.favoriteControls or {}) do
        if data.pin and data.pin.Parent then
            data.pin.Text = H.favorites[id] and "★" or "☆"
            data.pin.TextColor3 = H.favorites[id] and H.activeTheme.accent or H.activeTheme.muted
        end
    end
end
H.renderFavorites = function()
    local page = H.pages["Избранное"]
    if not page or not H.makeButton then return end
    for _, child in ipairs(page:GetChildren()) do
        if child:GetAttribute("FavoriteEntry") then child:Destroy() end
    end
    local favoriteControlsForSearch = H.pageControls["Избранное"] or {}
    for index = #favoriteControlsForSearch, 1, -1 do
        local control = favoriteControlsForSearch[index]
        if not control or not control.Parent or control:GetAttribute("FavoriteEntry") then
            table.remove(favoriteControlsForSearch, index)
        end
    end
    local entries = {}
    for id, enabled in pairs(H.favorites or {}) do
        local data = H.favoriteControls[id]
        if enabled and data and data.control and data.control.Parent then table.insert(entries, data) end
    end
    table.sort(entries, function(a, b) return (a.label or a.id) < (b.label or b.id) end)
    if H.favoriteEmptyLabel then H.favoriteEmptyLabel.Visible = #entries == 0 end
    for index, data in ipairs(entries) do
        local destinationPage, destinationLabel = data.pageName, data.label
        local entry = H.makeButton(page, "★  " .. H.tr(destinationLabel) .. "     ·     " .. H.tr(destinationPage), function()
            H.selectCategory(destinationPage)
            H.searchBox.Text = destinationLabel
            H.applySearchFilter()
            task.defer(function()
                local targetPage = H.pages[destinationPage]
                if not targetPage then return end
                for _, item in ipairs(H.pageControls[destinationPage] or {}) do
                    if item and item.Parent and item:GetAttribute("SearchText") == destinationLabel then
                        local y = item.AbsolutePosition.Y - targetPage.AbsolutePosition.Y
                        targetPage.CanvasPosition = Vector2.new(0, math.max(0, y))
                        break
                    end
                end
            end)
        end)
        entry:SetAttribute("FavoriteEntry", true)
        entry:SetAttribute("SearchText", destinationLabel .. " " .. destinationPage)
        entry.LayoutOrder = 100 + index
        entry.Size = UDim2.new(1, -5, 0, 42)
    end
end

