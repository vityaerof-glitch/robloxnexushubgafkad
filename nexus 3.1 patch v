H.findPaletteChoice = function(choices, key)
    for _, choice in ipairs(choices) do
        if choice.key == key then return choice end
    end
    return choices[1]
end
H.rgbArrayFromColor = function(color)
    return {
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5),
    }
end
H.colorFromRGBArray = function(values)
    if type(values) ~= "table" or #values < 3 then return nil end
    local r, g, b = tonumber(values[1]), tonumber(values[2]), tonumber(values[3])
    if not r or not g or not b then return nil end
    return Color3.fromRGB(
        math.clamp(math.floor(r + 0.5), 0, 255),
        math.clamp(math.floor(g + 0.5), 0, 255),
        math.clamp(math.floor(b + 0.5), 0, 255)
    )
end
H.applyGuiAccentByName = function(key)
    local choice = H.findPaletteChoice(H.guiAccentChoices, key)
    H.guiAccentName = choice.key
    H.guiAccentCustomRGB = nil
    if choice.key == "DEFAULT" then
        H.guiAccentColor = nil
    else
        H.guiAccentColor = choice.color
    end
    if H.applyTheme then H.applyTheme(H.themeIndex) end
end
H.applyGuiAccentColor = function(color)
    if typeof(color) ~= "Color3" then return end
    H.guiAccentName = "CUSTOM"
    H.guiAccentColor = color
    H.guiAccentCustomRGB = H.rgbArrayFromColor(color)
    if H.applyTheme then H.applyTheme(H.themeIndex) end
end
H.applyESPColorByName = function(key)
    local choice = H.findPaletteChoice(H.espColorChoices, key)
    H.espColorName = choice.key
    H.espColorCustomRGB = nil
    if choice.key == "TEAM" then
        H.espColorOverride = nil
    else
        H.espColorOverride = choice.color
    end
    if H.refreshVisuals then pcall(H.refreshVisuals) end
    if H.espPaletteRefresh then pcall(H.espPaletteRefresh) end
    if H.espColorPickerRefresh then pcall(H.espColorPickerRefresh) end
end
H.applyESPColor = function(color)
    if typeof(color) ~= "Color3" then return end
    H.espColorName = "CUSTOM"
    H.espColorOverride = color
    H.espColorCustomRGB = H.rgbArrayFromColor(color)
    if H.refreshVisuals then pcall(H.refreshVisuals) end
