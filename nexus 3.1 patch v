    local hue, saturation, value = getColor():ToHSV()
    local syncing = false
    local function updateReadouts(color)
        local red = math.floor(color.R * 255 + 0.5)
        local green = math.floor(color.G * 255 + 0.5)
        local blue = math.floor(color.B * 255 + 0.5)
        hexBox.Text = string.format("#%02X%02X%02X", red, green, blue)
        metricLabels.RGB.Text = string.format("%d, %d, %d", red, green, blue)
        local maxC = math.max(color.R, color.G, color.B)
        local minC = math.min(color.R, color.G, color.B)
        local delta = maxC - minC
        local k = 1 - maxC
        local c, m, y = 0, 0, 0
        if k < 0.999999 then
            c = (1 - color.R - k) / (1 - k)
            m = (1 - color.G - k) / (1 - k)
            y = (1 - color.B - k) / (1 - k)
        end
        metricLabels.CMYK.Text = string.format("%d %d %d %d", math.floor(c*100+0.5), math.floor(m*100+0.5), math.floor(y*100+0.5), math.floor(k*100+0.5))
        metricLabels.HSV.Text = string.format("%d° %d%% %d%%", math.floor(hue*360+0.5), math.floor(saturation*100+0.5), math.floor(value*100+0.5))
        local lightness = (maxC + minC) / 2
        local hslS = 0
        if delta > 0 then hslS = delta / (1 - math.abs(2 * lightness - 1)) end
        metricLabels.HSL.Text = string.format("%d° %d%% %d%%", math.floor(hue*360+0.5), math.floor(hslS*100+0.5), math.floor(lightness*100+0.5))
        preview.BackgroundColor3 = color
        colorPreviewPanel.BackgroundColor3 = color
    end
    local function renderPicker(notify)
        local color = Color3.fromHSV(hue, saturation, value)
        svField.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        svKnob.Position = UDim2.new(saturation, 0, 1 - value, 0)
        hueKnob.Position = UDim2.new(hue, 0, 0.5, 0)
        updateReadouts(color)
        if notify then setColor(color) end
    end
    local function setFromColor(color, notify)
        if typeof(color) ~= "Color3" then return end
        hue, saturation, value = color:ToHSV()
        renderPicker(notify)
    end
    local draggingSV = false
    local draggingHue = false
    local function setSVFromPosition(position)
        local width = math.max(svField.AbsoluteSize.X, 1)
        local height = math.max(svField.AbsoluteSize.Y, 1)
        saturation = math.clamp((position.X - svField.AbsolutePosition.X) / width, 0, 1)
        value = 1 - math.clamp((position.Y - svField.AbsolutePosition.Y) / height, 0, 1)
        renderPicker(true)
    end
    local function setHueFromPosition(position)
        local width = math.max(hueBar.AbsoluteSize.X, 1)
        hue = math.clamp((position.X - hueBar.AbsolutePosition.X) / width, 0, 1)
        renderPicker(true)
    end
    svField.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            setSVFromPosition(input.Position)
        end
    end)
    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            setHueFromPosition(input.Position)
        end
    end)
    H.UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSV then setSVFromPosition(input.Position) end
            if draggingHue then setHueFromPosition(input.Position) end
        end
    end)
    H.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false
            draggingHue = false
        end
    end)
    hexBox.FocusLost:Connect(function(enterPressed)
        local raw = hexBox.Text:gsub("#", ""):gsub("%s", "")
        if #raw == 6 and raw:match("^%x%x%x%x%x%x$") then
            local number = tonumber(raw, 16)
            if number then
                local color = Color3.fromRGB(math.floor(number / 65536) % 256, math.floor(number / 256) % 256, number % 256)
                setFromColor(color, true)
            end
        else
            setFromColor(getColor(), false)
        end
    end)
    local refresh = function()
        if not holder.Parent then return end
        -- Do not resync HSV from the current RGB value while the user is dragging.
        -- In particular, grayscale colors have no defined hue and would reset the hue knob.
        if not draggingSV and not draggingHue and not hexBox:IsFocused() then
            local current = getColor()
            if typeof(current) == "Color3" then setFromColor(current, false) end
        end
        title.TextColor3 = H.activeTheme.text
        hexLabel.TextColor3 = H.activeTheme.muted
        holderStroke.Color = H.activeTheme.track
        previewStroke.Color = H.activeTheme.track
        colorPreviewStroke.Color = H.activeTheme.track
        hexStroke.Color = H.activeTheme.track
    end
    renderPicker(false)
    return refresh
end
