    if H.miniLogoCorner then H.miniLogoCorner.CornerRadius = UDim.new(0, math.clamp(math.floor(size * 0.21 + 0.5), 6, 20)) end
    if H.openStroke then H.openStroke.Thickness = math.clamp(size * 0.026, 1, 3) end
    local dockPosition = H.miniDockPosition or H.openButton.Position
    H.miniDockCenter = UDim2.fromOffset(dockPosition.X.Offset + size / 2, dockPosition.Y.Offset + size / 2)
end
