H.scanNPCs = function()
    if not H.settings.NPCESP and not H.settings.NPCAimAssist then return end
    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Model") and object:FindFirstChildOfClass("Humanoid") then H.registerNPC(object) end
    end
end

H.refreshNPCESP = function()
    if H.settings.NPCESP or H.settings.NPCAimAssist then H.scanNPCs() end
    for model, data in pairs(H.npcHighlights) do
        if not model.Parent or not model:IsDescendantOf(workspace) or H.isPlayerCharacterModel(model) then
            H.removeNPCESP(model)
        elseif data.highlight then
            -- RenderStepped owns visibility/range state; this is an immediate safe reset.
            data.highlight.Enabled = false
            if data.infoFrame then data.infoFrame.Visible = false end
            if data.boxFrame then data.boxFrame.Visible = false end
            if data.tracerFrame then data.tracerFrame.Visible = false end
            if data.lookDirectionFrame then data.lookDirectionFrame.Visible = false end
            if data.healthBarBack then data.healthBarBack.Visible = false end
            for _, line in ipairs(data.skeletonLines or {}) do line.Visible = false end
        end
    end
end

