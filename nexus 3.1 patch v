    if H.mainStroke then H.TweenService:Create(H.mainStroke, info, {Transparency = 0.14}):Play() end
    scaleTween.Completed:Connect(function()
        if not H.main or not H.main.Parent then return end
        H.main.Position = H.menuTargetPosition
        H.menuScaleValue.Value = 1
        H.menuAnimating = false
    end)
    scaleTween:Play()
end

