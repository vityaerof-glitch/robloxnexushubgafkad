    Instance.new("UICorner", accentBar).CornerRadius = UDim.new(1, 0)
    button.MouseEnter:Connect(function()
        local toggleKey = button:GetAttribute("ToggleSetting")
        local hoverColor = toggleKey and H.settings[toggleKey] and H.activeTheme.active or H.activeTheme.control:Lerp(H.activeTheme.accent, 0.16)
        H.playSmoothTween(button, 0.20, {BackgroundColor3 = hoverColor}, Enum.EasingStyle.Quint)
        H.playSmoothTween(hoverStroke, 0.22, {Transparency = 0.28}, Enum.EasingStyle.Sine)
        H.playSmoothTween(buttonScale, 0.20, {Scale = 1.012}, Enum.EasingStyle.Quint)
        if accentBar then H.playSmoothTween(accentBar, 0.20, {BackgroundTransparency = 0.10}, Enum.EasingStyle.Sine) end
    end)
    button.MouseLeave:Connect(function()
        local toggleKey = button:GetAttribute("ToggleSetting")
        local baseColor = (toggleKey and H.settings[toggleKey]) and H.activeTheme.active or H.activeTheme.control
        H.playSmoothTween(button, 0.24, {BackgroundColor3 = baseColor}, Enum.EasingStyle.Quint)
        H.playSmoothTween(hoverStroke, 0.22, {Transparency = 1}, Enum.EasingStyle.Sine)
        H.playSmoothTween(buttonScale, 0.23, {Scale = 1}, Enum.EasingStyle.Quint)
        if accentBar then
            local toggleEnabled = toggleKey and H.settings[toggleKey]
            H.playSmoothTween(accentBar, 0.22, {BackgroundTransparency = toggleEnabled and 0.18 or 0.72}, Enum.EasingStyle.Sine)
        end
    end)
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            H.playSmoothTween(buttonScale, 0.075, {Scale = 0.978}, Enum.EasingStyle.Quad)
        end
    end)
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local hovered = false
            pcall(function() hovered = button:IsDescendantOf(game) and H.UserInputService:GetMouseLocation() and button.AbsolutePosition.X <= H.UserInputService:GetMouseLocation().X and H.UserInputService:GetMouseLocation().X <= button.AbsolutePosition.X + button.AbsoluteSize.X and button.AbsolutePosition.Y <= H.UserInputService:GetMouseLocation().Y and H.UserInputService:GetMouseLocation().Y <= button.AbsolutePosition.Y + button.AbsoluteSize.Y end)
            H.playSmoothTween(buttonScale, 0.18, {Scale = hovered and 1.012 or 1}, Enum.EasingStyle.Back)
        end
    end)
    button:SetAttribute("SearchText", text)
    button.LayoutOrder = #parent:GetChildren() + 1
    button.Parent = parent
    local buttonScale = H.ensureHoverScale(button, "ButtonHoverScale")
    local buttonPadding = Instance.new("UIPadding", button)
    buttonPadding.PaddingLeft = UDim.new(0, 12)
    buttonPadding.PaddingRight = UDim.new(0, 10)
    if parent:IsA("ScrollingFrame") and H.pageControls[parent.Name:gsub("^Page_", "")] then
        table.insert(H.pageControls[parent.Name:gsub("^Page_", "")], button)
    end
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    button.Activated:Connect(callback)
    return button
end

