H.setLoadingProgress = function(percent, message)
    percent = math.clamp(tonumber(percent) or 0, 0, 1)
    if H.loadingStatus and H.loadingStatus.Parent and message then H.loadingStatus.Text = message end
    if H.loadingPercent and H.loadingPercent.Parent then H.loadingPercent.Text = tostring(math.floor(percent * 100 + 0.5)) .. "%" end
    if H.loadingFill and H.loadingFill.Parent then
        H.TweenService:Create(H.loadingFill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(percent, 0, 1, 0)}):Play()
    end
    -- Yield briefly so the splash screen can paint each milestone before more UI is built.
    task.wait(0.025)
end

H.showLoadFailure = function(message)
    warn("[Nexus Hub] Initialization failed:\n" .. tostring(message))
    if H.loadingSpinnerTween then pcall(function() H.loadingSpinnerTween:Cancel() end) end
    if H.loadingTitle and H.loadingTitle.Parent then H.loadingTitle.Text = "NEXUS HUB • LOAD FAILED" end
    if H.loadingStatus and H.loadingStatus.Parent then H.loadingStatus.Text = "Загрузка остановлена из-за ошибки" end
    if H.loadingHint and H.loadingHint.Parent then
        local detail = tostring(message):gsub("\n", " ")
        H.loadingHint.Text = string.sub(detail, 1, 270)
        H.loadingHint.TextColor3 = Color3.fromRGB(255, 135, 145)
        H.loadingHint.Size = UDim2.new(1, -56, 0, 48)
        H.loadingHint.TextYAlignment = Enum.TextYAlignment.Top
        H.loadingHint.TextWrapped = true
    end
    if H.loadingFill and H.loadingFill.Parent then
        H.loadingFill.BackgroundColor3 = Color3.fromRGB(235, 72, 92)
        H.loadingFill.Size = UDim2.new(1, 0, 1, 0)
    end
    if H.loadingPercent and H.loadingPercent.Parent then H.loadingPercent.Text = "ERROR" end
end

