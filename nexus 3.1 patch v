H.showReleaseNotes = function()
    if H.releaseOverlay and H.releaseOverlay.Parent then H.releaseOverlay:Destroy() end
    if H.main then H.main.Visible = false end
    if H.openButton then H.openButton.Visible = false end

    H.releaseOverlay = Instance.new("Frame")
    H.releaseOverlay.Name = "NexusReleaseNotesOverlay"
    H.releaseOverlay.Size = UDim2.fromScale(1, 1)
    H.releaseOverlay.Position = UDim2.fromScale(0, 0)
    H.releaseOverlay.BackgroundColor3 = Color3.fromRGB(3, 5, 10)
    H.releaseOverlay.BackgroundTransparency = 1
    H.releaseOverlay.BorderSizePixel = 0
    H.releaseOverlay.Active = true
    H.releaseOverlay.ZIndex = 150
    H.releaseOverlay.Parent = H.gui

    H.releaseCard = Instance.new("Frame")
    H.releaseCard.Name = "ReleaseNotesCard"
    H.releaseCard.AnchorPoint = Vector2.new(0.5, 0.5)
    H.releaseCard.Position = UDim2.new(0.5, 0, 0.5, 8)
    H.releaseCard.Size = UDim2.fromOffset(780, 570)
    H.releaseCard.BackgroundColor3 = H.activeTheme.background
    H.releaseCard.BorderSizePixel = 0
    H.releaseCard.ClipsDescendants = true
    H.releaseCard.ZIndex = 151
    H.releaseCard.Parent = H.releaseOverlay
    Instance.new("UICorner", H.releaseCard).CornerRadius = UDim.new(0, 18)
    H.releaseCardStroke = Instance.new("UIStroke", H.releaseCard)
    H.releaseCardStroke.Color = H.activeTheme.accent
    H.releaseCardStroke.Thickness = 1.4
    H.releaseCardStroke.Transparency = 0.12

    H.releaseScale = Instance.new("UIScale")
    H.releaseScale.Name = "ReleaseCardScale"
    H.releaseScale.Scale = 0.93
    H.releaseScale.Parent = H.releaseCard
    H.releaseScaleTarget = 1
    H.releaseAnimating = true
    H.updateReleaseScale = function()
        local camera = workspace.CurrentCamera
        if not camera or not H.releaseScale or not H.releaseScale.Parent then return end
        local viewport = camera.ViewportSize
        H.releaseScaleTarget = math.clamp(math.min((viewport.X - 28) / 780, (viewport.Y - 28) / 570), 0.55, 1)
        if not H.releaseAnimating then H.releaseScale.Scale = H.releaseScaleTarget end
    end
    H.updateReleaseScale()
    if H.releaseViewportConnection then pcall(function() H.releaseViewportConnection:Disconnect() end) end
    if workspace.CurrentCamera then
        H.releaseViewportConnection = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(H.updateReleaseScale)
    end

    H.releaseHeader = Instance.new("Frame")
    H.releaseHeader.Name = "ReleaseHeader"
    H.releaseHeader.Size = UDim2.new(1, 0, 0, 82)
    H.releaseHeader.BackgroundColor3 = H.activeTheme.header
    H.releaseHeader.BorderSizePixel = 0
    H.releaseHeader.ZIndex = 152
    H.releaseHeader.Parent = H.releaseCard
    Instance.new("UICorner", H.releaseHeader).CornerRadius = UDim.new(0, 18)
    H.releaseHeaderGradient = Instance.new("UIGradient")
    H.releaseHeaderGradient.Color = ColorSequence.new(H.activeTheme.header, H.activeTheme.background)
    H.releaseHeaderGradient.Rotation = 12
    H.releaseHeaderGradient.Parent = H.releaseHeader

    H.releaseVersion = Instance.new("TextLabel")
    H.releaseVersion.Name = "VersionBadge"
    H.releaseVersion.Position = UDim2.fromOffset(20, 15)
    H.releaseVersion.Size = UDim2.fromOffset(84, 26)
    H.releaseVersion.BackgroundColor3 = H.activeTheme.accent
    H.releaseVersion.BorderSizePixel = 0
    H.releaseVersion.Text = H.VERSION
    H.releaseVersion.TextColor3 = Color3.fromRGB(8, 18, 28)
    H.releaseVersion.Font = Enum.Font.Code
    H.releaseVersion.TextSize = 13
    H.releaseVersion.TextScaled = false
    H.releaseVersion.TextWrapped = false
    H.releaseVersion.ZIndex = 154
    H.releaseVersion.Parent = H.releaseHeader
    Instance.new("UICorner", H.releaseVersion).CornerRadius = UDim.new(0, 7)

    H.releaseTitle = Instance.new("TextLabel")
    H.releaseTitle.Name = "ReleaseTitle"
    H.releaseTitle.Position = UDim2.fromOffset(110, 9)
    H.releaseTitle.Size = UDim2.new(1, -260, 0, 30)
    H.releaseTitle.BackgroundTransparency = 1
    H.releaseTitle.Text = H.currentLanguage == "RU" and "ИСТОРИЯ ОБНОВЛЕНИЙ" or "UPDATE HISTORY"
    H.releaseTitle.TextColor3 = H.activeTheme.accent
    H.releaseTitle.Font = Enum.Font.GothamBlack
    H.releaseTitle.TextSize = 19
    H.releaseTitle.TextXAlignment = Enum.TextXAlignment.Left
    H.releaseTitle.ZIndex = 154
    H.releaseTitle.Parent = H.releaseHeader

    H.releaseSubtitle = Instance.new("TextLabel")
    H.releaseSubtitle.Name = "ReleaseSubtitle"
    H.releaseSubtitle.Position = UDim2.fromOffset(111, 40)
    H.releaseSubtitle.Size = UDim2.new(1, -250, 0, 20)
    H.releaseSubtitle.BackgroundTransparency = 1
    H.releaseSubtitle.Text = H.currentLanguage == "RU" and "Предыдущие изменения и последняя сборка" or "Previous changes and latest build"
    H.releaseSubtitle.TextColor3 = H.activeTheme.muted
    H.releaseSubtitle.Font = Enum.Font.GothamMedium
    H.releaseSubtitle.TextSize = 10
    H.releaseSubtitle.TextXAlignment = Enum.TextXAlignment.Left
    H.releaseSubtitle.ZIndex = 154
    H.releaseSubtitle.Parent = H.releaseHeader

    H.releaseLatestBadge = Instance.new("TextLabel")
    H.releaseLatestBadge.Name = "LatestBadge"
    H.releaseLatestBadge.AnchorPoint = Vector2.new(1, 0)
    H.releaseLatestBadge.Position = UDim2.new(1, -20, 0, 16)
