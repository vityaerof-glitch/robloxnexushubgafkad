end)

H.applyWorldSettings = function()
    H.applyLowGraphicsSetting()
    if H.settings.FullBright then
        if not H.worldState.fullBrightApplied then
            H.worldState.savedFullBright = {
                Ambient = H.Lighting.Ambient,
                OutdoorAmbient = H.Lighting.OutdoorAmbient,
                Brightness = H.Lighting.Brightness,
                ExposureCompensation = H.Lighting.ExposureCompensation,
            }
            H.worldState.fullBrightApplied = true
        end
        H.Lighting.Ambient = Color3.fromRGB(190, 190, 190)
        H.Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
        H.Lighting.Brightness = 3
        H.Lighting.ExposureCompensation = 0.25
    elseif H.worldState.fullBrightApplied then
        local saved = H.worldState.savedFullBright or H.originalLighting
        H.Lighting.Ambient = saved.Ambient
        H.Lighting.OutdoorAmbient = saved.OutdoorAmbient
        H.Lighting.Brightness = saved.Brightness
        H.Lighting.ExposureCompensation = saved.ExposureCompensation
        H.worldState.fullBrightApplied = false
        H.worldState.savedFullBright = nil
    end

    if H.settings.NoFog then
        if not H.worldState.noFogApplied then
            H.worldState.savedFog = {FogStart = H.Lighting.FogStart, FogEnd = H.Lighting.FogEnd}
            H.worldState.noFogApplied = true
        end
        H.Lighting.FogStart = 0
        H.Lighting.FogEnd = 1000000
    elseif H.worldState.noFogApplied then
        local saved = H.worldState.savedFog or H.originalLighting
        H.Lighting.FogStart = saved.FogStart
        H.Lighting.FogEnd = saved.FogEnd
        H.worldState.noFogApplied = false
        H.worldState.savedFog = nil
    end

    if H.settings.NightMode then
        if not H.worldState.nightApplied then
            H.worldState.savedClockTime = H.Lighting.ClockTime
            H.worldState.nightApplied = true
        end
        H.Lighting.ClockTime = 0
    elseif H.worldState.nightApplied then
        H.Lighting.ClockTime = H.worldState.savedClockTime or H.originalLighting.ClockTime
        H.worldState.nightApplied = false
        H.worldState.savedClockTime = nil
    end
end

H.restoreMovementOverrides = function(humanoid)
    if humanoid then
        if H.oldWalkSpeed ~= nil then humanoid.WalkSpeed = H.oldWalkSpeed end
        if H.oldJumpPower ~= nil and H.oldUseJumpPower ~= nil then
            humanoid.UseJumpPower = H.oldUseJumpPower
            humanoid.JumpPower = H.oldJumpPower
            if H.oldJumpHeight ~= nil then humanoid.JumpHeight = H.oldJumpHeight end
        end
    end
    H.oldWalkSpeed, H.oldJumpPower, H.oldJumpHeight, H.oldUseJumpPower = nil, nil, nil, nil
    for part, canCollide in pairs(H.savedCollision) do
        if part and part.Parent then pcall(function() part.CanCollide = canCollide end) end
    end
    table.clear(H.savedCollision)
    H.noclipCharacter = nil
end

H.applyMovementSettings = function()
    local character = H.LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local sprintHeld = H.settings.Sprint and H.UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        if H.settings.WalkSpeedBoost or sprintHeld then
            if H.oldWalkSpeed == nil then H.oldWalkSpeed = humanoid.WalkSpeed end
            local desiredSpeed = H.settings.WalkSpeedBoost and H.settings.WalkSpeed or H.oldWalkSpeed
            if sprintHeld then desiredSpeed = math.max(desiredSpeed, H.settings.SprintSpeed) end
            humanoid.WalkSpeed = desiredSpeed
        elseif H.oldWalkSpeed ~= nil then
            humanoid.WalkSpeed = H.oldWalkSpeed
            H.oldWalkSpeed = nil
        end
        if H.settings.JumpBoost then
            if H.oldJumpPower == nil then
                H.oldJumpPower = humanoid.JumpPower
                H.oldJumpHeight = humanoid.JumpHeight
                H.oldUseJumpPower = humanoid.UseJumpPower
            end
            if humanoid.UseJumpPower then humanoid.JumpPower = H.settings.JumpPower
            else humanoid.JumpHeight = math.max(7, H.settings.JumpPower / 7) end
        elseif H.oldJumpPower ~= nil then
            humanoid.UseJumpPower = H.oldUseJumpPower
            humanoid.JumpPower = H.oldJumpPower
            if H.oldJumpHeight ~= nil then humanoid.JumpHeight = H.oldJumpHeight end
            H.oldWalkSpeed = H.oldWalkSpeed
            H.oldJumpPower, H.oldJumpHeight, H.oldUseJumpPower = nil, nil, nil
        end
    end
    if H.settings.Noclip and character then
        if H.noclipCharacter ~= character then
            for part, canCollide in pairs(H.savedCollision) do
                if part and part.Parent then pcall(function() part.CanCollide = canCollide end) end
            end
            table.clear(H.savedCollision)
            H.noclipCharacter = character
        end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if H.savedCollision[part] == nil then H.savedCollision[part] = part.CanCollide end
                part.CanCollide = false
            end
        end
    elseif next(H.savedCollision) ~= nil then
        for part, canCollide in pairs(H.savedCollision) do
            if part and part.Parent then pcall(function() part.CanCollide = canCollide end) end
        end
        table.clear(H.savedCollision)
        H.noclipCharacter = nil
    end
end

H.applyCameraSettings = function(camera)
    if not camera then return end
    if H.settings.CustomCameraFOV then
        if not H.cameraFOVWasApplied then H.oldCameraFOV = camera.FieldOfView end
        camera.FieldOfView = H.settings.CameraFOV
