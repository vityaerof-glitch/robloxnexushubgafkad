H.refreshTargetStatus = function()
    if not H.targetStatusLabel then return end
    if not H.selectedTarget or H.selectedTarget.Parent ~= H.Players then
        H.targetStatusLabel.Text = H.tr("Цель: не выбрана")
        return
    end
    local character = H.selectedTarget.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local myRoot = H.LocalPlayer.Character and H.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local distanceText = (root and myRoot) and string.format("%.0f studs", (root.Position - myRoot.Position).Magnitude) or "--"
    H.targetStatusLabel.Text = string.format("%s: %s (@%s)\nUserId: %d | HP: %s | %s: %s",
        H.tr("Цель"), H.selectedTarget.DisplayName, H.selectedTarget.Name, H.selectedTarget.UserId,
        humanoid and tostring(math.floor(humanoid.Health + 0.5)) or "--", H.tr("Дистанция"), distanceText)
end
H.moveTargetSelection = function(delta)
    local list = H.otherPlayers()
    if #list == 0 then
        H.selectedTarget = nil
        H.refreshTargetStatus()
        return
    end
    local index = 0
    for i, player in ipairs(list) do if player == H.selectedTarget then index = i break end end
    index = ((index - 1 + delta) % #list) + 1
    H.selectedTarget = list[index]
    H.refreshTargetStatus()
end
