H.copySettings = function()
    local copy = {}
    for key, value in pairs(H.settings) do
        if type(value) == "boolean" or type(value) == "number" or type(value) == "string" then copy[key] = value end
    end
    return copy
end
H.applyImportedConfig = function(payload)
    if type(payload) ~= "table" then return false end
    local incoming = type(payload.settings) == "table" and payload.settings or payload
    for key, defaultValue in pairs(H.defaultSettings) do
        local value = incoming[key]
        if value ~= nil and type(value) == type(defaultValue) then
            if (key == "AimPart" or key == "NPCAimPart") and value ~= "Head" and value ~= "Torso" then
                -- ignore invalid target-part value
            elseif type(value) == "number" then
                local bounds = H.configBounds[key]
                if bounds then value = math.clamp(value, bounds[1], bounds[2]) end
                H.settings[key] = value
            else
                H.settings[key] = value
            end
        end
    end
    local language = payload.language
    if type(language) == "string" and table.find(H.languageOrder, language) then H.currentLanguage = language end
    if type(payload.themeIndex) == "number" and H.applyTheme then H.applyTheme(payload.themeIndex) end
    local guiCustom = H.colorFromRGBArray(payload.guiAccentRGB)
    local espCustom = H.colorFromRGBArray(payload.espColorRGB)
    if payload.guiAccentName == "CUSTOM" and guiCustom then
        H.applyGuiAccentColor(guiCustom)
    elseif type(payload.guiAccentName) == "string" and H.applyGuiAccentByName then
        H.applyGuiAccentByName(payload.guiAccentName)
    end
    if payload.espColorName == "CUSTOM" and espCustom then
        H.applyESPColor(espCustom)
    elseif type(payload.espColorName) == "string" and H.applyESPColorByName then
        H.applyESPColorByName(payload.espColorName)
    end
    local aimCustom = H.colorFromRGBArray(payload.aimColorRGB)
    if payload.aimColorName == "CUSTOM" and aimCustom and H.applyAimColor then
        H.applyAimColor(aimCustom)
    elseif type(payload.aimColorName) == "string" and H.applyAimColorByName then
        H.applyAimColorByName(payload.aimColorName)
    end
    local npcCustom = H.colorFromRGBArray(payload.npcColorRGB)
    if payload.npcColorName == "CUSTOM" and npcCustom then
        H.applyNPCColor(npcCustom)
    elseif type(payload.npcColorName) == "string" and H.applyNPCColorByName then
        H.applyNPCColorByName(payload.npcColorName)
    end
    -- Validate imported keybind strings without accepting arbitrary invalid names.
    local allowedMouseBindings = {MouseButton1 = true, MouseButton2 = true, MouseButton3 = true}
    for _, bindSetting in ipairs({"MenuBind", "ServerHopBind", "ESPToggleBind", "AimToggleBind", "FlyToggleBind", "NoclipToggleBind", "BunnyHopToggleBind", "CrosshairToggleBind", "AimHoldBind", "AimThroughWallsToggleBind", "FOVCircleToggleBind", "InfiniteJumpToggleBind", "WalkSpeedBoostToggleBind", "JumpBoostToggleBind", "FullBrightToggleBind", "NoFogToggleBind"}) do
        local importedKey = H.settings[bindSetting]
        local valid = importedKey == "None" or (type(importedKey) == "string" and allowedMouseBindings[importedKey] == true)
        if type(importedKey) == "string" and not valid then
            local ok, item = pcall(function() return Enum.KeyCode[importedKey] end)
            valid = ok and item ~= nil and item ~= Enum.KeyCode.Unknown
        end
        if not valid then H.settings[bindSetting] = H.defaultSettings[bindSetting] end
    end
    -- Keep the two UI toggles in sync, including configs created by older versions.
    H.settings.AimVisibleCheck = not H.settings.AimThroughWalls
    for key, render in pairs(H.toggleRenderers) do pcall(render) end
    for key, setter in pairs(H.sliderSetters) do
        if type(H.settings[key]) == "number" then pcall(setter, H.settings[key]) end
    end
    if H.syncFavoritesFromSetting then H.syncFavoritesFromSetting() end
    for _, refresher in ipairs(H.languageRefreshers) do pcall(refresher) end
    H.refreshLanguage()
    H.aimTargetPlayer = nil
    if H.refreshVisuals then H.refreshVisuals() end
    if H.refreshNPCESP then H.refreshNPCESP() end
    if H.updateTeamStatus then H.updateTeamStatus() end
    if H.targetStatusLabel and H.refreshTargetStatus then H.refreshTargetStatus() end
    return true
end
-- Single-file persistence layer.
-- Some script runtimes expose readfile/writefile; when present, the whole profile (including
-- custom named configs) is stored in one JSON file without a companion script. Roblox Studio's
-- standard LocalScript does not expose these APIs, so it falls back to the optional DataStore bridge.
H.CONFIG_FILE_PATH = "NexusHub_v2_2_settings.json"
H.filePersistenceAvailable = type(readfile) == "function" and type(writefile) == "function"
H.persistenceMode = "none"
H.persistenceRemote = nil
H.persistenceReady = false
H.persistenceBusy = false
H.persistenceLastJSON = nil
H.persistenceStatus = function(ru, en)
    if H.persistenceStatusLabel then
        H.persistenceStatusLabel.Text = (H.currentLanguage == "RU" and ru or en)
    end
end
H.collectNamedConfigs = function()
    local saved = {}
    local count = 0
    for name, profile in pairs(H.configPresets or {}) do
        if count >= 100 then break end
        if type(name) == "string" and #name > 0 and #name <= 64
            and type(profile) == "table" and type(profile.settings) == "table"
            and not (H.builtinConfigPresets and H.builtinConfigPresets[name]) then
            local cleanSettings = {}
            for key, defaultValue in pairs(H.defaultSettings) do
                local value = profile.settings[key]
                if value ~= nil and type(value) == type(defaultValue) then
                    if type(value) == "number" then
                        local bounds = H.configBounds[key]
                        if bounds then value = math.clamp(value, bounds[1], bounds[2]) end
                    end
                    cleanSettings[key] = value
                end
            end
            saved[name] = {
                schemaVersion = 1,
                settings = cleanSettings,
                language = type(profile.language) == "string" and profile.language or nil,
                themeIndex = type(profile.themeIndex) == "number" and profile.themeIndex or nil,
                guiAccentName = type(profile.guiAccentName) == "string" and profile.guiAccentName or nil,
                guiAccentRGB = type(profile.guiAccentRGB) == "table" and profile.guiAccentRGB or nil,
                espColorName = type(profile.espColorName) == "string" and profile.espColorName or nil,
                espColorRGB = type(profile.espColorRGB) == "table" and profile.espColorRGB or nil,
                npcColorName = type(profile.npcColorName) == "string" and profile.npcColorName or nil,
                npcColorRGB = type(profile.npcColorRGB) == "table" and profile.npcColorRGB or nil,
                aimColorName = type(profile.aimColorName) == "string" and profile.aimColorName or nil,
                aimColorRGB = type(profile.aimColorRGB) == "table" and profile.aimColorRGB or nil,
            }
            count += 1
        end
    end
    return saved
end
H.restoreNamedConfigs = function(saved)
    if type(saved) ~= "table" then return end
    local count = 0
    for name, profile in pairs(saved) do
        if count >= 100 then break end
        if type(name) == "string" and #name > 0 and #name <= 64
            and type(profile) == "table" and type(profile.settings) == "table"
            and not (H.builtinConfigPresets and H.builtinConfigPresets[name]) then
            local cleanSettings = {}
            for key, defaultValue in pairs(H.defaultSettings) do
                local value = profile.settings[key]
                if value ~= nil and type(value) == type(defaultValue) then
                    if type(value) == "number" then
                        local bounds = H.configBounds[key]
                        if bounds then value = math.clamp(value, bounds[1], bounds[2]) end
                    end
                    cleanSettings[key] = value
                end
            end
            H.configPresets[name] = {
                schemaVersion = 1,
                settings = cleanSettings,
                language = profile.language,
                themeIndex = profile.themeIndex,
                guiAccentName = profile.guiAccentName,
                guiAccentRGB = profile.guiAccentRGB,
                espColorName = profile.espColorName,
                espColorRGB = profile.espColorRGB,
                npcColorName = profile.npcColorName,
                npcColorRGB = profile.npcColorRGB,
                aimColorName = profile.aimColorName,
                aimColorRGB = profile.aimColorRGB,
            }
            count += 1
        end
    end
end
H.buildPersistencePayload = function()
    return {
        schemaVersion = 2,
        language = H.currentLanguage,
        themeIndex = H.themeIndex,
        guiAccentName = H.guiAccentName,
        guiAccentRGB = H.guiAccentCustomRGB,
        espColorName = H.espColorName,
        espColorRGB = H.espColorCustomRGB,
        npcColorName = H.npcColorName,
        npcColorRGB = H.npcColorCustomRGB,
        aimColorName = H.aimColorName,
        aimColorRGB = H.aimColorCustomRGB,
        settings = H.copySettings(),
        namedConfigs = H.collectNamedConfigs(),
    }
end
H.encodePersistencePayload = function()
    local payload = H.buildPersistencePayload()
    local ok, encoded = pcall(function() return H.HttpService:JSONEncode(payload) end)
    if not ok then return nil, encoded end
    return encoded, payload
end
H.savePersistentSettings = function(force)
    if not H.persistenceReady then
        H.persistenceStatus("Сохранение ещё загружается. Повтори через секунду.", "Persistence is still initializing. Try again in a second.")
        return false
    end
    if H.persistenceBusy then return false end
    local encoded, payloadOrError = H.encodePersistencePayload()
    if not encoded then
        H.persistenceStatus("Не удалось подготовить настройки к сохранению.", "Could not prepare settings for saving.")
        return false
    end
    if not force and encoded == H.persistenceLastJSON then return true end

    if H.persistenceMode == "file" then
        H.persistenceBusy = true
        local writeOK, writeError = pcall(function() writefile(H.CONFIG_FILE_PATH, encoded) end)
        H.persistenceBusy = false
        if writeOK then
            H.persistenceLastJSON = encoded
            H.persistenceStatus("Настройки и конфиги сохранены в локальный JSON-файл.", "Settings and configs saved to the local JSON file.")
            return true
        end
        H.persistenceStatus("Ошибка записи файла: " .. tostring(writeError), "File write error: " .. tostring(writeError))
        return false
    end

    if H.persistenceMode ~= "datastore" or not H.persistenceRemote then
        H.persistenceStatus("Автосохранение недоступно в этой среде. Используй экспорт JSON или подключи DataStore.", "Autosave is unavailable in this runtime. Use JSON export or connect DataStore.")
        return false
    end
    H.persistenceBusy = true
    task.spawn(function()
        local callOK, saved, message = pcall(function()
            return H.persistenceRemote:InvokeServer(force and "SaveNow" or "Save", payloadOrError)
        end)
        H.persistenceBusy = false
        if callOK and saved == true then
            H.persistenceLastJSON = encoded
            H.persistenceStatus("Настройки отправлены на сервер и будут сохранены автоматически.", "Settings sent to the server and will be persisted automatically.")
        else
            local reason = callOK and tostring(message or "server rejected save") or tostring(saved)
            H.persistenceStatus("Ошибка автосохранения: " .. reason, "Autosave error: " .. reason)
        end
    end)
    return true
end
H.startPersistenceAutosave = function()
    task.spawn(function()
        while H.LocalPlayer and H.LocalPlayer.Parent do
            task.wait(5)
            if H.persistenceReady then H.savePersistentSettings(false) end
        end
    end)
end
H.initializePersistence = function()
    -- Preferred one-file mode: store settings and named configs in a persistent local JSON file.
    if H.filePersistenceAvailable then
        H.persistenceMode = "file"
        local exists = false
        local validFile = false
        local raw = nil
        local readOK, readResult = pcall(function() return readfile(H.CONFIG_FILE_PATH) end)
        if readOK and type(readResult) == "string" and #readResult > 0 then
            raw = readResult
            exists = true
        end
        if exists then
            local decodeOK, decoded = pcall(function() return H.HttpService:JSONDecode(raw) end)
            if decodeOK and type(decoded) == "table" then
                validFile = true
                H.restoreNamedConfigs(decoded.namedConfigs)
                local applied = H.applyImportedConfig(decoded)
                if applied then
                    H.persistenceStatus("Локальные настройки и конфиги загружены.", "Local settings and configs loaded.")
                else
                    H.persistenceStatus("Файл найден, но формат настроек не распознан.", "File found, but settings format was not recognized.")
                end
            else
                H.persistenceStatus("Файл настроек повреждён; будет создан новый после сохранения.", "Settings file is invalid; a new one will be created on save.")
            end
        else
            H.persistenceStatus("Первый запуск: настройки будут записаны в локальный JSON-файл.", "First run: settings will be written to a local JSON file.")
        end
        local encoded = H.encodePersistencePayload()
        H.persistenceLastJSON = validFile and encoded or nil
        H.persistenceReady = true
        if not validFile then H.savePersistentSettings(true) end
        H.startPersistenceAutosave()
        return
    end

    -- Standard Roblox LocalScripts cannot read/write disk. Use the optional server DataStore bridge.
    local remote = H.ReplicatedStorage:WaitForChild("NexusHubSettingsRemote", 12)
    if not remote or not remote:IsA("RemoteFunction") then
        H.persistenceMode = "none"
        H.persistenceStatus("В обычном Studio нужен серверный DataStore-скрипт; LocalScript не может писать на диск.", "Standard Studio needs the server DataStore script; a LocalScript cannot write to disk.")
        return
    end
    H.persistenceMode = "datastore"
    H.persistenceRemote = remote
    local callOK, loaded, profileOrMessage = pcall(function() return remote:InvokeServer("Load") end)
    if not callOK then
        H.persistenceStatus("DataStore недоступен. Проверь публикацию игры и API Services.", "DataStore unavailable. Check game publishing and API Services.")
        return
    end
    if loaded ~= true then
        H.persistenceStatus("Не удалось загрузить настройки: " .. tostring(profileOrMessage or "ошибка сервера"), "Could not load settings: " .. tostring(profileOrMessage or "server error"))
        return
    end
    if type(profileOrMessage) == "table" and H.applyImportedConfig then
        if H.applyImportedConfig(profileOrMessage) then
            H.persistenceStatus("Сохранённые настройки загружены.", "Saved settings loaded.")
        else
            H.persistenceStatus("Сохранение найдено, но формат не распознан.", "Saved data was found, but its format was invalid.")
        end
    else
        H.persistenceStatus("Первый запуск: текущие настройки будут сохранены автоматически.", "First run: current settings will be saved automatically.")
    end
    local encoded = H.encodePersistencePayload()
    H.persistenceLastJSON = encoded
    H.persistenceReady = true
    H.savePersistentSettings(true)
    H.startPersistenceAutosave()
end

H.saveConfigAction = function()
    local name = string.gsub(H.configNameBox and H.configNameBox.Text or "", "^%s*(.-)%s*$", "%1")
    if name == "" then H.configMessage("Сначала введи имя конфига."); return end
    H.configPresets[name] = {settings = H.copySettings(), language = H.currentLanguage, themeIndex = H.themeIndex, guiAccentName = H.guiAccentName, guiAccentRGB = H.guiAccentCustomRGB, espColorName = H.espColorName, espColorRGB = H.espColorCustomRGB, npcColorName = H.npcColorName, npcColorRGB = H.npcColorCustomRGB, aimColorName = H.aimColorName, aimColorRGB = H.aimColorCustomRGB, schemaVersion = 1}
    H.configMessage("Конфиг сохранён.")
    if H.savePersistentSettings then H.savePersistentSettings(true) end
end
H.loadConfigAction = function()
    local name = string.gsub(H.configNameBox and H.configNameBox.Text or "", "^%s*(.-)%s*$", "%1")
    if name == "" then H.configMessage("Сначала введи имя конфига."); return end
    local profile = H.configPresets[name]
    if not profile then H.configMessage("Конфиг с таким именем не найден."); return end
    if H.applyImportedConfig(profile) then
        H.configMessage("Конфиг загружен.")
        if H.savePersistentSettings then H.savePersistentSettings(true) end
    end
end
H.deleteConfigAction = function()
    local name = string.gsub(H.configNameBox and H.configNameBox.Text or "", "^%s*(.-)%s*$", "%1")
    if name == "" then H.configMessage("Сначала введи имя конфига."); return end
    if H.configPresets[name] then
        H.configPresets[name] = nil
        H.configMessage("Конфиг удалён.")
        if H.savePersistentSettings then H.savePersistentSettings(true) end
    else
        H.configMessage("Конфиг с таким именем не найден.")
    end
end
H.exportConfigAction = function()
    local payload = {schemaVersion = 1, language = H.currentLanguage, themeIndex = H.themeIndex, guiAccentName = H.guiAccentName, guiAccentRGB = H.guiAccentCustomRGB, espColorName = H.espColorName, espColorRGB = H.espColorCustomRGB, npcColorName = H.npcColorName, npcColorRGB = H.npcColorCustomRGB, aimColorName = H.aimColorName, aimColorRGB = H.aimColorCustomRGB, settings = H.copySettings()}
    local ok, encoded = pcall(function() return H.HttpService:JSONEncode(payload) end)
    if not ok then H.configMessage("Ошибка JSON: проверь скопированный текст."); return end
    if H.configJsonBox then H.configJsonBox.Text = encoded end
    H.configMessage("JSON готов к копированию. Скопируй текст вручную.")
end
H.importConfigAction = function()
    local raw = H.configJsonBox and H.configJsonBox.Text or ""
    local ok, decoded = pcall(function() return H.HttpService:JSONDecode(raw) end)
    if not ok or type(decoded) ~= "table" or not H.applyImportedConfig(decoded) then
        H.configMessage("Ошибка JSON: проверь скопированный текст.")
        return
    end
    H.configMessage("Конфиг импортирован.")
    if H.savePersistentSettings then H.savePersistentSettings(true) end
end

