-- Cancellable, configurable tweens: rapid mouse movement will not leave stale tweens fighting each other.
H.activeUITweens = setmetatable({}, {__mode = "k"})
H.playSmoothTween = function(instance, duration, goals, style, direction)
    if not instance or not instance.Parent then return nil end
    if not H.settings or H.settings.UIAnimations == false then
        for property, value in pairs(goals) do pcall(function() instance[property] = value end) end
        return nil
    end
    local speed = math.clamp((tonumber(H.settings.AnimationSpeedPercent) or 100) / 100, 0.5, 1.5)
    if H.settings.ReduceMotion then
        duration = 0.055
    elseif H.settings.SoftOptimization then
        duration = math.clamp((tonumber(duration) or 0.18) / speed, 0.035, 0.11)
        style = Enum.EasingStyle.Quad
    else
        duration = math.clamp((tonumber(duration) or 0.18) / speed, 0.045, 0.9)
    end
    local bucket = H.activeUITweens[instance]
    if not bucket then bucket = {}; H.activeUITweens[instance] = bucket end
    for property in pairs(goals) do
        local previous = bucket[property]
        if previous then pcall(function() previous:Cancel() end) end
    end
    local tweenInfo = TweenInfo.new(duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
    local tween = H.TweenService:Create(instance, tweenInfo, goals)
    for property in pairs(goals) do bucket[property] = tween end
    tween.Completed:Connect(function()
        for property in pairs(goals) do
            if bucket[property] == tween then bucket[property] = nil end
        end
        if next(bucket) == nil then H.activeUITweens[instance] = nil end
    end)
    tween:Play()
    return tween
end

H.ensureHoverScale = function(guiObject, name)
    local scale = guiObject:FindFirstChild(name or "NexusHoverScale")
    if scale and scale:IsA("UIScale") then return scale end
    scale = Instance.new("UIScale")
    scale.Name = name or "NexusHoverScale"
    scale.Scale = 1
    scale.Parent = guiObject
    return scale
end

