H.finishLoadingScreen = function()
    if H.loadingStatus and H.loadingStatus.Parent then H.loadingStatus.Text = "Nexus Hub готов к работе" end
    if H.loadingHint and H.loadingHint.Parent then H.loadingHint.Text = "Открываем интерфейс..." end
    if H.loadingPercent and H.loadingPercent.Parent then H.loadingPercent.Text = "100%" end
    if H.loadingFill and H.loadingFill.Parent then H.loadingFill.Size = UDim2.new(1, 0, 1, 0) end
    if H.loadingSpinnerTween then pcall(function() H.loadingSpinnerTween:Cancel() end) end
    task.wait(0.12)
    if not H.loadingLayer or not H.loadingLayer.Parent then return end
    local fadeInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for _, object in ipairs(H.loadingLayer:GetDescendants()) do
        local goals = {}
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then goals.TextTransparency = 1 end
        if object:IsA("Frame") or object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then goals.BackgroundTransparency = 1 end
        if object:IsA("UIStroke") then goals.Transparency = 1 end
        if next(goals) then pcall(function() H.TweenService:Create(object, fadeInfo, goals):Play() end) end
    end
    H.TweenService:Create(H.loadingLayer, fadeInfo, {BackgroundTransparency = 1}):Play()
    task.wait(0.22)
    -- The loading overlay is about to be destroyed; move the embedded logo to the permanent header first.
    if H.embeddedLogoCanvas and H.brandMark and H.mountEmbeddedLogo then
        H.mountEmbeddedLogo(H.brandMark, H.brandMark.ZIndex + 1)
    end
    if H.loadingLayer and H.loadingLayer.Parent then H.loadingLayer:Destroy() end
    if H.showReleaseNotes then
        local notesOK, notesError = pcall(H.showReleaseNotes)
        if not notesOK then
            warn("[Nexus Hub] Could not display release notes: " .. tostring(notesError))
            if H.openMainAnimated then H.openMainAnimated() end
        end
    elseif H.openMainAnimated then
        H.openMainAnimated()
    end
end

