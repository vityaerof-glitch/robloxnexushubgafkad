        elseif role == "headerGradient" then
            if object:IsA("UIGradient") then object.Color = ColorSequence.new(H.activeTheme.header, H.activeTheme.background) end
        elseif role == "miniGradient" then
            if object:IsA("UIGradient") then object.Color = ColorSequence.new(H.activeTheme.accent, H.activeTheme.header) end
