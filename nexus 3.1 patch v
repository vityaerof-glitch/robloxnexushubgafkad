            end
        end
    end
    H.updateSpawnMarkers()

    -- Aim assist runs below at Camera priority + 1 so the default camera does not overwrite it.

    if H.selectedTarget and os.clock() - H.lastTargetRefresh > 0.5 then
        H.lastTargetRefresh = os.clock()
        H.refreshTargetStatus()
    end
    if os.clock() - H.lastTeamRefresh > 1 then
        H.lastTeamRefresh = os.clock()
        H.updateTeamStatus()
    end
end)

