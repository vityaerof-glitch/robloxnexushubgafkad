                if ok and type(value) == "number" then pingText = tostring(math.floor(value * 1000 + 0.5)) .. " ms" end
                table.insert(fields, "PING " .. pingText)
            end
            if H.settings.ShowMemory then
                local memoryText = "--"
                local ok, value = pcall(function() return H.Stats:GetTotalMemoryUsageMb() end)
                if ok and type(value) == "number" then memoryText = string.format("%.0f MB", value) end
                table.insert(fields, "MEM " .. memoryText)
            end
            if H.settings.ShowPlayerCount then table.insert(fields, "PLAYERS " .. tostring(#H.Players:GetPlayers())) end
            H.runtimeMetricsLabel.Text = table.concat(fields, "  •  ")
            H.runtimeMetricsLabel.Size = UDim2.fromOffset(math.clamp(110 + #H.runtimeMetricsLabel.Text * 4.4, 180, 330), 22)
        end
        if H.dashboardStatusLabel then
            local uptime = math.floor(os.clock() - H.scriptStartedAt)
            local targetName = H.selectedTarget and H.selectedTarget.Parent == H.Players and H.selectedTarget.Name or (H.currentLanguage == "RU" and "не выбран" or "none")
            if H.currentLanguage == "RU" then
                H.dashboardStatusLabel.Text = string.format("PlaceId: %s  |  Игроки: %d  |  Время: %02d:%02d\nВыбранная цель: %s  |  HP: %s", tostring(game.PlaceId), #H.Players:GetPlayers(), math.floor(uptime / 60), uptime % 60, targetName, healthText)
