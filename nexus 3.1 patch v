H.updateResponsiveScale = function()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local responsive = math.clamp(math.min((viewport.X - 28) / 1120, (viewport.Y - 36) / 760), 0.58, 1)
    local userScale = math.clamp((tonumber(H.settings and H.settings.UIScalePercent) or 100) / 100, 0.70, 1.15)
    H.responsiveScaleTarget = responsive * userScale
    H.responsiveScale.Scale = H.responsiveScaleTarget * (H.menuAnimationFactor or 1)
end
