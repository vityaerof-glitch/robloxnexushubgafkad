H.getAimPart = function(player)
    local character = player and player.Character
    if not character then return nil end
    if H.settings.AimPart == "Torso" then
        return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    end
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

H.validAimTarget = function(player, camera, center)
    if not player or player == H.LocalPlayer or player.Parent ~= H.Players then return nil end
    if H.settings.AimTeamCheck and not H.isEnemy(player) then return nil end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local part = H.getAimPart(player)
    if not humanoid or humanoid.Health <= 0 or not part then return nil end
    local point, onScreen = camera:WorldToViewportPoint(part.Position)
    if not onScreen or point.Z <= 0 then return nil end
    local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
    if distance > H.settings.FOVRadius then return nil end
    if not H.settings.AimThroughWalls and H.settings.AimVisibleCheck and not H.isVisibleToCamera(player, part, camera) then return nil end
    return part, distance
end

-- Bind after Roblox's default camera controller. This makes aim response reliable in the default camera.
pcall(function() H.RunService:UnbindFromRenderStep("DevToolsAimAssist") end)
H.setAimStatus = function(ruText, enText)
    if H.aimStatusLabel then
        H.aimStatusLabel.Text = H.currentLanguage == "RU" and ruText or enText
    end
end
H.RunService:BindToRenderStep("DevToolsAimAssist", Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
    local camera = workspace.CurrentCamera
    local aimBindDown = H.isBindDown(H.settings.AimHoldBind)
    local npcAimHasPriority = H.settings.NPCAimAssist and aimBindDown
    local holdingAim = H.settings.AimAssist and aimBindDown and not npcAimHasPriority
    if not holdingAim or not camera then
        -- Lock only applies while the configured hold bind is down; no stale target persists after release.
        H.aimTargetPlayer = nil
        if not H.settings.AimAssist then
            H.setAimStatus("Аим выключен. Включи помощь и удерживай назначенный бинд.", "Aim assist is off. Enable it and hold the configured aim bind.")
        elseif npcAimHasPriority then
            H.setAimStatus("NPC Aim активен — наведение передано NPC Aim.", "NPC Aim is active — aim control is handed to NPC Aim.")
        else
            H.setAimStatus("Аим включён — удерживай назначенный бинд.", "Aim assist enabled — hold the configured aim bind.")
        end
        return
    end

    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    local chosenPart, chosenPlayer
    local chosenDistance = math.huge

    -- Keep a valid target while the button is held, if lock is enabled.
    if H.settings.AimLock and H.aimTargetPlayer then
        local part, screenDistance = H.validAimTarget(H.aimTargetPlayer, camera, center)
        if part then
            chosenPart, chosenPlayer, chosenDistance = part, H.aimTargetPlayer, screenDistance
        else
            H.aimTargetPlayer = nil
        end
    end

    -- Acquire the closest valid target to the screen center if we don't hold a valid lock.
    if not chosenPart then
        local bestScore = H.settings.FOVRadius
        for _, player in ipairs(H.Players:GetPlayers()) do
            local part, screenDistance = H.validAimTarget(player, camera, center)
            if part and screenDistance < bestScore then
                bestScore = screenDistance
                chosenDistance = screenDistance
                chosenPart = part
                chosenPlayer = player
            end
        end
        H.aimTargetPlayer = chosenPlayer
    end

    if not chosenPart or not chosenPlayer then
        H.setAimStatus("Цель не найдена внутри FOV.", "No target found inside FOV.")
        if not H.settings.AimLock then H.aimTargetPlayer = nil end
        return
    end

    local predictionMs = math.clamp(tonumber(H.settings.AimPredictionMs) or 0, 0, 250)
    local targetVelocity = chosenPart.AssemblyLinearVelocity
    local targetCharacter = chosenPlayer.Character
    local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
    if targetRoot and targetRoot:IsA("BasePart") then
        targetVelocity = targetRoot.AssemblyLinearVelocity
    end
    local predictedPosition = chosenPart.Position + targetVelocity * (predictionMs / 1000)
    local goal = CFrame.lookAt(camera.CFrame.Position, predictedPosition)

    -- Speed is perceptually mapped: low values remain smooth; medium and high values are much more responsive.
    local speed = math.clamp(H.settings.AimStrengthPercent, 5, 100) / 100
    local responseRate = 3 + (speed ^ 1.35) * 100
    local frameTime = math.clamp(tonumber(deltaTime) or (1 / 60), 0, 1 / 20)
    local alpha = 1 - math.exp(-responseRate * frameTime)
    camera.CFrame = camera.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))

    local displayName = chosenPlayer.DisplayName or chosenPlayer.Name
    H.setAimStatus(
        string.format("Цель: %s | %d px | скорость %d%% | через стены: %s", displayName, math.floor(chosenDistance + 0.5), H.settings.AimStrengthPercent, H.settings.AimThroughWalls and "ВКЛ" or "ВЫКЛ"),
        string.format("Target: %s | %d px | speed %d%% | through walls: %s", displayName, math.floor(chosenDistance + 0.5), H.settings.AimStrengthPercent, H.settings.AimThroughWalls and "ON" or "OFF")
    )
end)

-- NPC-only target selection. When NPC Aim is enabled and the common hold bind is down,
-- it takes priority over player aim so two camera controllers never fight each other.
H.getNPCAimPart = function(model)
    if not model or not model:IsA("Model") then return nil end
    if H.settings.NPCAimPart == "Torso" then
        return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
    end
    return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
end
H.isModelVisibleToCamera = function(model, part, camera)
    if not model or not part or not camera then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {H.LocalPlayer.Character}
    params.IgnoreWater = true
    local direction = part.Position - camera.CFrame.Position
    local result = workspace:Raycast(camera.CFrame.Position, direction, params)
    return result == nil or result.Instance:IsDescendantOf(model)
end
H.validNPCAimTarget = function(model, camera, center)
    if not model or not model:IsA("Model") or not model:IsDescendantOf(workspace) or H.isPlayerCharacterModel(model) then return nil end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local part = H.getNPCAimPart(model)
    if not humanoid or humanoid.Health <= 0 or not part or not part:IsA("BasePart") then return nil end
    local localCharacter = H.LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    local root = model:FindFirstChild("HumanoidRootPart") or part
    if localRoot and root and root:IsA("BasePart") then
        local maxAimDistance = math.max(tonumber(H.settings.NPCAimMaxDistance) or 1500, 1)
        if (localRoot.Position - root.Position).Magnitude > maxAimDistance then return nil end
    end
    local point, onScreen = camera:WorldToViewportPoint(part.Position)
    if not onScreen or point.Z <= 0 then return nil end
    local screenDistance = (Vector2.new(point.X, point.Y) - center).Magnitude
    if screenDistance > math.clamp(tonumber(H.settings.NPCAimFOVRadius) or 180, 60, 1500) then return nil end
    if H.settings.NPCAimVisibleCheck and not H.settings.NPCAimThroughWalls and not H.isModelVisibleToCamera(model, part, camera) then return nil end
    return part, screenDistance
end
H.setNPCAimStatus = function(ruText, enText)
    if H.npcAimStatusLabel then H.npcAimStatusLabel.Text = H.currentLanguage == "RU" and ruText or enText end
end
pcall(function() H.RunService:UnbindFromRenderStep("NexusNPCAimAssist") end)
H.RunService:BindToRenderStep("NexusNPCAimAssist", Enum.RenderPriority.Camera.Value + 2, function(deltaTime)
    local camera = workspace.CurrentCamera
    local holding = H.settings.NPCAimAssist and H.isBindDown(H.settings.AimHoldBind)
    if not holding or not camera then
        H.aimTargetNPC = nil
        if not H.settings.NPCAimAssist then
            H.setNPCAimStatus("NPC Aim выключен. Включи помощь и удерживай назначенный бинд.", "NPC Aim is off. Enable it and hold the configured bind.")
        else
            H.setNPCAimStatus("NPC Aim включён — удерживай назначенный бинд.", "NPC Aim is enabled — hold the configured bind.")
        end
        return
    end

    H.aimTargetNPCScanElapsed += math.max(tonumber(deltaTime) or 0, 0)
    if H.aimTargetNPCScanElapsed >= 0.75 then
        H.aimTargetNPCScanElapsed = 0
        H.scanNPCs()
    end

    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    local chosenPart, chosenModel
    local chosenDistance = math.huge
    if H.settings.NPCAimLock and H.aimTargetNPC then
        local part, score = H.validNPCAimTarget(H.aimTargetNPC, camera, center)
        if part then chosenPart, chosenModel, chosenDistance = part, H.aimTargetNPC, score end
    end
    if not chosenPart then
        for model in pairs(H.npcHighlights) do
            local part, score = H.validNPCAimTarget(model, camera, center)
            if part and score < chosenDistance then
                chosenPart, chosenModel, chosenDistance = part, model, score
            end
        end
        H.aimTargetNPC = chosenModel
    end
    if not chosenPart or not chosenModel then
        H.setNPCAimStatus("Цель NPC не найдена внутри FOV.", "No NPC target found inside FOV.")
        if not H.settings.NPCAimLock then H.aimTargetNPC = nil end
        return
    end

    local predictionMs = math.clamp(tonumber(H.settings.NPCAimPredictionMs) or 0, 0, 250)
    local root = chosenModel:FindFirstChild("HumanoidRootPart")
    local velocity = root and root:IsA("BasePart") and root.AssemblyLinearVelocity or chosenPart.AssemblyLinearVelocity
    local predictedPosition = chosenPart.Position + velocity * (predictionMs / 1000)
    local goal = CFrame.lookAt(camera.CFrame.Position, predictedPosition)
    local speed = math.clamp(tonumber(H.settings.NPCAimStrengthPercent) or 25, 5, 100) / 100
    local responseRate = 3 + (speed ^ 1.35) * 100
    local frameTime = math.clamp(tonumber(deltaTime) or (1 / 60), 0, 1 / 20)
    local alpha = 1 - math.exp(-responseRate * frameTime)
    camera.CFrame = camera.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))
    H.setNPCAimStatus(
        string.format("NPC-цель: %s | %d px | скорость %d%%", chosenModel.Name, math.floor(chosenDistance + 0.5), H.settings.NPCAimStrengthPercent),
        string.format("NPC target: %s | %d px | smoothing %d%%", chosenModel.Name, math.floor(chosenDistance + 0.5), H.settings.NPCAimStrengthPercent)
    )
end)

-- In a normal LocalScript, `script` is an Instance. When source is executed
-- through loadstring, `script` may be nil, so guard the optional lifecycle hook.
-- This lifecycle hook is optional: `script` is not guaranteed in dynamically executed chunks.
if script and script.Destroying then
    script.Destroying:Connect(function()
    pcall(function() H.RunService:UnbindFromRenderStep("DevToolsAimAssist") end)
    pcall(function() H.RunService:UnbindFromRenderStep("NexusNPCAimAssist") end)
    if H.clearFlight then pcall(H.clearFlight) end
    H.restoreMovementOverrides(H.LocalPlayer.Character and H.LocalPlayer.Character:FindFirstChildOfClass("Humanoid"))
    if H.worldState.fullBrightApplied and H.worldState.savedFullBright then
        H.Lighting.Ambient = H.worldState.savedFullBright.Ambient
        H.Lighting.OutdoorAmbient = H.worldState.savedFullBright.OutdoorAmbient
        H.Lighting.Brightness = H.worldState.savedFullBright.Brightness
        H.Lighting.ExposureCompensation = H.worldState.savedFullBright.ExposureCompensation
    end
    if H.worldState.noFogApplied and H.worldState.savedFog then
        H.Lighting.FogStart = H.worldState.savedFog.FogStart
        H.Lighting.FogEnd = H.worldState.savedFog.FogEnd
    end
    if H.worldState.nightApplied and H.worldState.savedClockTime ~= nil then H.Lighting.ClockTime = H.worldState.savedClockTime end
    for object, wasEnabled in pairs(H.worldState.savedLowGraphics or {}) do
        if object and object.Parent then pcall(function() object.Enabled = wasEnabled end) end
    end
    for _, billboard in pairs(H.spawnMarkerObjects) do if billboard then billboard:Destroy() end end
    table.clear(H.spawnMarkerObjects)
end)
end -- script may be nil when loaded dynamically.

