H.makeButton(H.pages["Обзор"], "Обновить снимок диагностики", function()
    local character = H.LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local position = root and root.Position or Vector3.zero
    local velocity = root and root.AssemblyLinearVelocity.Magnitude or 0
    local pingMs = "n/a"
    local pingOK, pingValue = pcall(function() return H.LocalPlayer:GetNetworkPing() end)
    if pingOK and type(pingValue) == "number" then pingMs = tostring(math.floor(pingValue * 1000 + 0.5)) .. " ms" end
    local memoryMb = "n/a"
    local memoryOK, memoryValue = pcall(function() return H.Stats:GetTotalMemoryUsageMb() end)
    if memoryOK and type(memoryValue) == "number" then memoryMb = string.format("%.1f MB", memoryValue) end
    local snapshot = {
        "NEXUS HUB • DIAGNOSTIC SNAPSHOT",
        "PlaceId=" .. tostring(game.PlaceId),
        "JobId=" .. (game.JobId ~= "" and game.JobId or "Studio / unavailable"),
        "Players=" .. tostring(#H.Players:GetPlayers()),
        "LocalPlayer=" .. H.LocalPlayer.Name .. " (UserId " .. tostring(H.LocalPlayer.UserId) .. ")",
        "Team=" .. H.teamName(H.LocalPlayer),
        "Position=" .. string.format("%.2f, %.2f, %.2f", position.X, position.Y, position.Z),
        "Health=" .. tostring(humanoid and math.floor(humanoid.Health + 0.5) or "n/a"),
        "Velocity=" .. string.format("%.2f studs/s", velocity),
        "Ping=" .. pingMs,
        "Memory=" .. memoryMb,
        "ESP=" .. tostring(H.settings.ESP) .. " | AimAssist=" .. tostring(H.settings.AimAssist),
        "Preset/config fields can be exported from Settings."
    }
    if H.diagnosticsBox then H.diagnosticsBox.Text = table.concat(snapshot, "\n") end
end)
