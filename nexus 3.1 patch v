H.formatESPDistance = function(distance)
    if type(distance) ~= "number" or distance ~= distance or distance == math.huge or distance == -math.huge then
        return "--"
    end
    return tostring(math.max(0, math.floor(distance + 0.5)))
end

H.updateOffscreenIndicator = function(arrow, label, stroke, worldPosition, color, displayText, camera, enabled)
    if not arrow or not label then return end
    arrow.Visible = false
    label.Visible = false
    if not enabled or not camera or typeof(worldPosition) ~= "Vector3" then return end
    local point, onScreen = camera:WorldToViewportPoint(worldPosition)
    if onScreen and point.Z > 0 then return end

    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    local dx, dy = point.X - center.X, point.Y - center.Y
    -- Screen projection flips for points behind the camera; invert to keep the edge arrow directional.
    if point.Z <= 0 then dx, dy = -dx, -dy end
    if math.abs(dx) < 0.001 and math.abs(dy) < 0.001 then dy = -1 end

    local insetX, insetY = 28, 38
    local halfW = math.max(1, viewport.X * 0.5 - insetX)
    local halfH = math.max(1, viewport.Y * 0.5 - insetY)
    local scaleX = math.abs(dx) > 0.001 and halfW / math.abs(dx) or math.huge
    local scaleY = math.abs(dy) > 0.001 and halfH / math.abs(dy) or math.huge
    local scale = math.min(scaleX, scaleY)
    if scale == math.huge or scale <= 0 then scale = 1 end
    local x = math.clamp(center.X + dx * scale, insetX, math.max(insetX, viewport.X - insetX))
    local y = math.clamp(center.Y + dy * scale, insetY, math.max(insetY, viewport.Y - insetY))

    arrow.Position = UDim2.fromOffset(x, y)
    arrow.Rotation = math.deg(math.atan2(dy, dx))
    arrow.TextColor3 = color or Color3.fromRGB(72, 205, 255)
    arrow.Visible = true

    label.Text = tostring(displayText or "Target")
    label.TextColor3 = color or Color3.fromRGB(235, 245, 255)
    if stroke then stroke.Color = color or Color3.fromRGB(72, 205, 255) end
    if math.abs(dx) >= math.abs(dy) then
        if dx >= 0 then
            label.AnchorPoint = Vector2.new(1, 0.5)
            label.Position = UDim2.fromOffset(x - 15, y)
            label.TextXAlignment = Enum.TextXAlignment.Right
        else
            label.AnchorPoint = Vector2.new(0, 0.5)
            label.Position = UDim2.fromOffset(x + 15, y)
            label.TextXAlignment = Enum.TextXAlignment.Left
        end
    elseif dy >= 0 then
        label.AnchorPoint = Vector2.new(0.5, 1)
        label.Position = UDim2.fromOffset(x, y - 14)
        label.TextXAlignment = Enum.TextXAlignment.Center
    else
        label.AnchorPoint = Vector2.new(0.5, 0)
        label.Position = UDim2.fromOffset(x, y + 14)
        label.TextXAlignment = Enum.TextXAlignment.Center
    end
    label.Visible = true
end

-- NPC ESP: separate from player ESP. It highlights Humanoid models in Workspace that do not
-- belong to a Player.Character. NPCs spawned after activation are picked up automatically.
H.isPlayerCharacterModel = function(model)
    if not model then return false end
    if H.Players:GetPlayerFromCharacter(model) then return true end
    for _, player in ipairs(H.Players:GetPlayers()) do
        if player.Character == model then return true end
    end
    return false
end

H.findHumanoidModel = function(object)
    local current = object
    while current and current ~= workspace do
        if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
            return current
        end
        current = current.Parent
    end
    return nil
end

H.removeNPCESP = function(model)
    if not model then return end
    local data = H.npcHighlights[model]
    if not data then return end
    if data.ancestryConnection then pcall(function() data.ancestryConnection:Disconnect() end) end
    for _, key in ipairs({"highlight", "infoFrame", "healthBarBack", "boxFrame", "tracerFrame", "lookDirectionFrame", "offscreenArrow", "offscreenLabel"}) do
        local object = data[key]
        if object then pcall(function() object:Destroy() end) end
    end
    for _, line in ipairs(data.skeletonLines or {}) do
        if line then pcall(function() line:Destroy() end) end
    end
    H.npcHighlights[model] = nil
end

