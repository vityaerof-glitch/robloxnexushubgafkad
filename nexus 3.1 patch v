-- Draggable minimized Nexus mini-dock.
-- A short press opens the dashboard; releasing after a drag only leaves the dock in place.
H.miniDockPosition = H.openButton.Position
H.miniDockTargetPosition = H.openButton.Position
local currentDockSize = H.getMiniDockPixelSize and H.getMiniDockPixelSize() or 58
H.miniDockCenter = UDim2.fromOffset(H.miniDockPosition.X.Offset + currentDockSize / 2, H.miniDockPosition.Y.Offset + currentDockSize / 2)
H.miniDockPressed = false
H.miniDockDragged = false
H.miniDockDragStart = nil
H.miniDockStartPosition = nil
H.miniDockDragThreshold = 8

H.openButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        H.miniDockPressed = true
        H.miniDockDragged = false
        H.miniDockDragStart = input.Position
        H.miniDockStartPosition = H.openButton.Position
        H.miniDockTargetPosition = H.openButton.Position
    end
end)

H.UserInputService.InputChanged:Connect(function(input)
    if not H.miniDockPressed or not H.openButton.Visible or not H.miniDockDragStart or not H.miniDockStartPosition then
        return
    end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local delta = input.Position - H.miniDockDragStart
    if delta.Magnitude > H.miniDockDragThreshold then
        H.miniDockDragged = true
    end
    if not H.miniDockDragged then return end

    -- Keep the cursor-derived destination separate from the displayed position. The render loop
    -- eases the dock toward this destination using MiniDockDragUpdateRate.
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
    local dockSize = H.openButton.AbsoluteSize
    local x = H.miniDockStartPosition.X.Offset + delta.X
    local y = H.miniDockStartPosition.Y.Offset + delta.Y
    x = math.clamp(x, 0, math.max(0, viewport.X - dockSize.X))
    y = math.clamp(y, 0, math.max(0, viewport.Y - dockSize.Y))
    H.miniDockTargetPosition = UDim2.fromOffset(x, y)
end)

H.UserInputService.InputEnded:Connect(function(input)
    local isPointerRelease = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
    if not isPointerRelease or not H.miniDockPressed then return end

    -- Check the final release position too, so the last movement sample cannot turn a drag into a click.
    local wasDragged = H.miniDockDragged
    local finalDelta = Vector2.zero
    if H.miniDockDragStart then
        finalDelta = input.Position - H.miniDockDragStart
        if finalDelta.Magnitude > H.miniDockDragThreshold then
            wasDragged = true
        end
    end
    local shouldOpen = H.openButton.Visible and not wasDragged

    -- Finish at the exact release coordinate so the dock never drifts after the pointer is released.
    if wasDragged and H.miniDockStartPosition then
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
        local dockSize = H.openButton.AbsoluteSize
        local x = math.clamp(H.miniDockStartPosition.X.Offset + finalDelta.X, 0, math.max(0, viewport.X - dockSize.X))
        local y = math.clamp(H.miniDockStartPosition.Y.Offset + finalDelta.Y, 0, math.max(0, viewport.Y - dockSize.Y))
        H.openButton.Position = UDim2.fromOffset(x, y)
        H.miniDockTargetPosition = H.openButton.Position
        H.miniDockPosition = H.openButton.Position
        H.miniDockCenter = UDim2.fromOffset(x + dockSize.X / 2, y + dockSize.Y / 2)
    end

    H.miniDockPressed = false
    H.miniDockDragged = false
    H.miniDockDragStart = nil
    H.miniDockStartPosition = nil

    -- Do not use GuiButton.Activated here: Roblox may fire it after a drag release as well.
    -- Opening is explicitly tied to a pointer press/release with movement below the drag threshold.
    if shouldOpen then
        H.openMainAnimated()
    end
end)

-- Drag the menu using its header.
local dragging = false; H.dragStart = nil; H.startPosition = nil; H.dragInput = nil
H.header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        H.dragStart = input.Position
        H.startPosition = H.main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
H.header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then H.dragInput = input end
end)
H.UserInputService.InputChanged:Connect(function(input)
    if dragging and input == H.dragInput then
        local delta = input.Position - H.dragStart
        H.main.Position = UDim2.new(H.startPosition.X.Scale, H.startPosition.X.Offset + delta.X, H.startPosition.Y.Scale, H.startPosition.Y.Offset + delta.Y)
        H.menuTargetPosition = H.main.Position
    end
end)
H.UserInputService.InputBegan:Connect(function(input, gameProcessed)
    local token = H.inputToken(input)
    if not token then return end

    -- When rebinding, capture the next keyboard key or mouse button before normal actions.
    if H.waitingForBindSetting then
        local settingName = H.waitingForBindSetting
        H.waitingForBindSetting = nil
        if token == "Escape" then
            H.setBindStatus("Назначение отменено.", "Binding cancelled.")
            H.refreshKeybindButtons()
            return
        elseif token == "Backspace" then
            H.assignBinding(settingName, "None")
            return
        else
            if not H.assignBinding(settingName, token) then
                H.waitingForBindSetting = settingName
                H.refreshKeybindButtons()
            end
            return
        end
    end

    if input.UserInputType == Enum.UserInputType.Keyboard and H.commandPalette and H.commandPalette.Visible and token == "Escape" then
        H.commandPalette.Visible = false
        H.commandSearch:ReleaseFocus()
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard and H.UserInputService:GetFocusedTextBox() then return end

    if input.UserInputType == Enum.UserInputType.Keyboard and token == "P"
        and (H.UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or H.UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
        if H.commandPaletteToggle then H.commandPaletteToggle() end
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard and token == "K"
        and (H.UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or H.UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
        if H.searchBox and H.searchBox.Parent then H.searchBox:CaptureFocus(); H.searchBox.CursorPosition = #H.searchBox.Text + 1 end
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard and token == "Escape" and H.main and H.main.Visible then
        if H.closeMainAnimated then H.closeMainAnimated() end
        return
    end

    -- The menu bind works even if Roblox marks the event as processed.
    if H.settings.MenuBind ~= "None" and token == H.settings.MenuBind then
        H.toggleMenuAnimated()
        return
    end

    -- Run configured toggle actions. AimHoldBind is a hold-to-aim trigger, not a toggle.
    for _, definition in ipairs(H.keybindDefinitions) do
        if definition.action ~= "menu" and definition.action ~= "aimhold"
            and H.settings[definition.setting] ~= "None" and token == H.settings[definition.setting] then
            local action = definition.action
            if action == "serverhop" then
                H.sendServerHopRequest("hop")
            elseif action == "esp" then
                H.settings.ESP = not H.settings.ESP
                if H.toggleRenderers.ESP then H.toggleRenderers.ESP() end
            elseif action == "aim" then
                H.settings.AimAssist = not H.settings.AimAssist
                if H.toggleRenderers.AimAssist then H.toggleRenderers.AimAssist() end
            elseif action == "fly" then
                H.settings.Fly = not H.settings.Fly
                if H.toggleRenderers.Fly then H.toggleRenderers.Fly() end
                if not H.settings.Fly and H.clearFlight then H.clearFlight() end
            elseif action == "noclip" then
                H.settings.Noclip = not H.settings.Noclip
                if H.toggleRenderers.Noclip then H.toggleRenderers.Noclip() end
            elseif action == "bhop" then
                H.settings.BunnyHop = not H.settings.BunnyHop
                if H.toggleRenderers.BunnyHop then H.toggleRenderers.BunnyHop() end
            elseif action == "crosshair" then
                H.settings.Crosshair = not H.settings.Crosshair
                if H.toggleRenderers.Crosshair then H.toggleRenderers.Crosshair() end
            elseif action == "aimthroughwalls" then
                H.settings.AimThroughWalls = not H.settings.AimThroughWalls
                H.settings.AimVisibleCheck = not H.settings.AimThroughWalls
                if H.toggleRenderers.AimThroughWalls then H.toggleRenderers.AimThroughWalls() end
                if H.toggleRenderers.AimVisibleCheck then H.toggleRenderers.AimVisibleCheck() end
            elseif action == "fovcircle" then
                H.settings.AimCircle = not H.settings.AimCircle
                if H.toggleRenderers.AimCircle then H.toggleRenderers.AimCircle() end
            elseif action == "infinitejump" then
                H.settings.InfiniteJump = not H.settings.InfiniteJump
                if H.toggleRenderers.InfiniteJump then H.toggleRenderers.InfiniteJump() end
            elseif action == "walkspeed" then
                H.settings.WalkSpeedBoost = not H.settings.WalkSpeedBoost
                if H.toggleRenderers.WalkSpeedBoost then H.toggleRenderers.WalkSpeedBoost() end
            elseif action == "jumpboost" then
                H.settings.JumpBoost = not H.settings.JumpBoost
                if H.toggleRenderers.JumpBoost then H.toggleRenderers.JumpBoost() end
            elseif action == "fullbright" then
                H.settings.FullBright = not H.settings.FullBright
                if H.toggleRenderers.FullBright then H.toggleRenderers.FullBright() end
            elseif action == "nofog" then
                H.settings.NoFog = not H.settings.NoFog
                if H.toggleRenderers.NoFog then H.toggleRenderers.NoFog() end
            end
            break
        end
    end
end)

