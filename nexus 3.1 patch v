H.RunService.RenderStepped:Connect(function(deltaTime)
    -- Smooth mini-dock drag. The slider selects a target tracking rate (120–360 Hz); Roblox
    -- still renders at the client's actual frame rate, so values above client FPS reduce lag
    -- but cannot force the game or display to render more frames.
    if H.miniDockPressed and H.miniDockDragged and H.openButton and H.openButton.Visible and H.miniDockTargetPosition then
        local rate = math.clamp(math.floor(tonumber(H.settings.MiniDockDragUpdateRate) or 240), 120, 360)
        local dt = math.max(tonumber(deltaTime) or 0, 0)
        local alpha = 1 - math.exp(-rate * dt)
        local currentPosition = Vector2.new(H.openButton.Position.X.Offset, H.openButton.Position.Y.Offset)
        local targetPosition = Vector2.new(H.miniDockTargetPosition.X.Offset, H.miniDockTargetPosition.Y.Offset)
        local nextPosition = currentPosition:Lerp(targetPosition, alpha)
        if (targetPosition - nextPosition).Magnitude < 0.35 then nextPosition = targetPosition end
        H.openButton.Position = UDim2.fromOffset(nextPosition.X, nextPosition.Y)
        H.miniDockPosition = H.openButton.Position
        local dockSize = H.openButton.AbsoluteSize
        H.miniDockCenter = UDim2.fromOffset(nextPosition.X + dockSize.X / 2, nextPosition.Y + dockSize.Y / 2)
    end

    local camera = workspace.CurrentCamera
    local myCharacter = H.LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")

    -- Overview cards sample lightweight client/network metrics once per second.
    H.dashboardMetricElapsed = (H.dashboardMetricElapsed or 0) + math.max(tonumber(deltaTime) or 0, 0)
    H.dashboardMetricFrames = (H.dashboardMetricFrames or 0) + 1
    if H.dashboardMetricElapsed >= 1.0 then
        local sampleTime = math.max(H.dashboardMetricElapsed, 0.001)
        local fps = math.floor((H.dashboardMetricFrames / sampleTime) + 0.5)
        local pingText = "n/a"
        local pingOK, pingValue = pcall(function() return H.LocalPlayer:GetNetworkPing() end)
        if pingOK and type(pingValue) == "number" then pingText = string.format("%d ms", math.floor(pingValue * 1000 + 0.5)) end
        local memoryText = "n/a"
        local memoryOK, memoryValue = pcall(function() return H.Stats:GetTotalMemoryUsageMb() end)
        if memoryOK and type(memoryValue) == "number" then memoryText = string.format("%.0f MB", memoryValue) end
        H.dashboardMetricValues = {FPS = tostring(fps), PING = pingText, MEMORY = memoryText, PLAYERS = tostring(#H.Players:GetPlayers())}
        for metricKey, valueLabel in pairs(H.dashboardMetricCards or {}) do
            if valueLabel and valueLabel.Parent then valueLabel.Text = H.dashboardMetricValues[metricKey] or "--" end
        end
        H.dashboardMetricElapsed = 0
        H.dashboardMetricFrames = 0
    end

    -- HUD collection is intentionally throttled; it never scans Workspace per frame.
    if H.debugHud then
        H.debugHud.Visible = H.settings.ShowDebugHUD == true
        if H.debugHud.Visible then
            H.debugHudElapsed = (H.debugHudElapsed or 0) + math.max(tonumber(deltaTime) or 0, 0)
            H.debugHudFrameCount = (H.debugHudFrameCount or 0) + 1
            if H.debugHudElapsed >= 0.5 then
                local sampleTime = math.max(H.debugHudElapsed, 0.001)
                H.debugHudFPS = math.floor((H.debugHudFrameCount / sampleTime) + 0.5)
                local pingText = "n/a"
                local pingOK, pingValue = pcall(function() return H.LocalPlayer:GetNetworkPing() end)
                if pingOK and type(pingValue) == "number" then pingText = string.format("%d ms", math.floor(pingValue * 1000 + 0.5)) end
                local memoryText = "n/a"
                local memoryOK, memoryValue = pcall(function() return H.Stats:GetTotalMemoryUsageMb() end)
                if memoryOK and type(memoryValue) == "number" then memoryText = string.format("%.0f MB", memoryValue) end
                local npcCount = 0
                for model in pairs(H.npcHighlights or {}) do
                    if model and model.Parent and model:IsDescendantOf(workspace) and not H.isPlayerCharacterModel(model) then npcCount += 1 end
                end
                local targetName = "-"
                if H.aimTargetNPC and H.aimTargetNPC.Parent then targetName = "NPC: " .. tostring(H.aimTargetNPC.Name)
                elseif H.aimTargetPlayer and H.aimTargetPlayer.Parent == H.Players then targetName = "Player: " .. tostring(H.aimTargetPlayer.Name) end
                local posText = myRoot and string.format("%.0f, %.0f, %.0f", myRoot.Position.X, myRoot.Position.Y, myRoot.Position.Z) or "n/a"
                H.debugHudText.Text = string.format(
                    "FPS  %d    PING  %s\nPlayers  %d    NPCs  %d\nMemory  %s\nPage  %s\nTarget  %s\nXYZ  %s",
                    H.debugHudFPS, pingText, #H.Players:GetPlayers(), npcCount, memoryText,
                    tostring(H.currentPageName or "-"), targetName, posText
                )
                H.debugHudElapsed = 0
                H.debugHudFrameCount = 0
            end
        end
    end

    -- ESP geometry updates are capped independently from Roblox's actual rendered FPS.
    -- In normal mode the maximum refresh setting is 120-240 Hz; since this callback runs on
    -- RenderStepped, actual updates can never exceed the client's rendered frame rate.
    -- Soft Optimization retains its dedicated 15-45 Hz low-overhead rate. Aim callbacks are separate.
    local shouldUpdateESP = false
    H._softESPAccumulator = (H._softESPAccumulator or 0) + math.max(tonumber(deltaTime) or 0, 0)
    local refreshRate
    if H.settings.SoftOptimization then
        refreshRate = math.clamp(math.floor(tonumber(H.settings.OptimizeESPUpdateRate) or 30), 15, 45)
    else
        refreshRate = math.clamp(math.floor(tonumber(H.settings.MaxESPUpdateRate) or 240), 120, 240)
    end
    local updateInterval = 1 / refreshRate
    if H._softESPAccumulator >= updateInterval then
        shouldUpdateESP = true
        -- Drop missed intervals instead of trying to catch up after a frame-time spike.
        H._softESPAccumulator = H._softESPAccumulator % updateInterval
    end

    -- Full, independent NPC Visuals renderer. Player ESP toggles/settings do not affect this path.
    if shouldUpdateESP then
    for model, data in pairs(H.npcHighlights) do
        local humanoid = model and model:FindFirstChildOfClass("Humanoid")
        local root = model and (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head"))
        local head = model and (model:FindFirstChild("Head") or root)
        if not model or not model.Parent or not model:IsDescendantOf(workspace) or H.isPlayerCharacterModel(model) then
            H.removeNPCESP(model)
        else
            local distance = (myRoot and root and root:IsA("BasePart"))
                and (myRoot.Position - root.Position).Magnitude or math.huge
            local maxDistance = math.max(tonumber(H.settings.NPCMaxESPDistance) or 1500, 1)
            local alive = humanoid ~= nil and humanoid.Health > 0 and root ~= nil and root:IsA("BasePart")
            local showNPC = H.settings.NPCESP and alive and distance <= maxDistance
            local distanceFade = H.settings.NPCESPDistanceFade
                and (math.clamp(distance / maxDistance, 0, 1) * 0.38) or 0
            local color = H.npcColorOverride or (H.activeTheme and H.activeTheme.accent) or Color3.fromRGB(72, 205, 255)

            if data.highlight then
                data.highlight.Adornee = model
                data.highlight.FillColor = color
                data.highlight.OutlineColor = color
                data.highlight.FillTransparency = math.clamp(0.74 + distanceFade * 0.5, 0, 0.98)
                data.highlight.OutlineTransparency = math.clamp(distanceFade * 0.5, 0, 0.85)
                data.highlight.Enabled = showNPC and H.settings.NPCHighlight
            end

            local boxX, boxY, boxWidth, boxHeight
            if showNPC and camera and (H.settings.NPCBoxes or (H.settings.NPCHealth and H.settings.NPCVerticalHealthBar)) then
                boxX, boxY, boxWidth, boxHeight = H.getScreenBounds(model, camera)
            end

            if data.infoFrame and data.infoFrame.Parent then
                local anyInfoEnabled = H.settings.NPCNames or H.settings.NPCTypeLabels or H.settings.NPCHealth or H.settings.NPCDistance
                local screenPart = head
                local screenPoint, onScreen = nil, false
                if camera and screenPart then screenPoint, onScreen = camera:WorldToViewportPoint(screenPart.Position) end
                if camera and root and (not screenPoint or not onScreen or screenPoint.Z <= 0) then
                    screenPart = root
                    screenPoint, onScreen = camera:WorldToViewportPoint(root.Position)
                end
                local inFront = screenPoint ~= nil and screenPoint.Z > 0
                data.infoFrame.Visible = showNPC and anyInfoEnabled and camera ~= nil and screenPart ~= nil and onScreen and inFront
                if data.infoFrame.Visible then
                    data.infoFrame.Position = UDim2.fromOffset(screenPoint.X, math.max(86, screenPoint.Y - 8))
                end
                data.nameLabel.Visible = H.settings.NPCNames
                data.typeLabel.Visible = H.settings.NPCTypeLabels
                data.healthLabel.Visible = H.settings.NPCHealth
                data.distanceLabel.Visible = H.settings.NPCDistance
                local textSize = math.clamp(tonumber(H.settings.NPCESPTextSize) or 12, 9, 20)
                data.nameLabel.Text = model.Name
                data.nameLabel.TextSize = textSize
                data.nameLabel.TextColor3 = color
                data.nameLabel.TextTransparency = distanceFade * 0.45
                local npcType = model:GetAttribute("NPCType") or model:GetAttribute("Role")
                    or model:GetAttribute("Faction") or model:GetAttribute("TeamName")
                    or model:GetAttribute("Type") or "NPC"
                data.typeLabel.Text = (H.currentLanguage == "RU" and "ТИП: " or "TYPE: ") .. tostring(npcType)
                data.typeLabel.TextSize = math.max(8, textSize - 2)
                data.typeLabel.TextColor3 = color
                data.typeLabel.TextTransparency = distanceFade * 0.45
                data.healthLabel.TextSize = math.max(8, textSize - 2)
                data.healthLabel.TextTransparency = distanceFade * 0.45
                data.distanceLabel.TextSize = math.max(8, textSize - 2)
                data.distanceLabel.TextTransparency = distanceFade * 0.45
                if humanoid then
                    local maxHealth = math.max(humanoid.MaxHealth, 1)
                    local health = math.clamp(humanoid.Health, 0, maxHealth)
                    local ratio = math.clamp(health / maxHealth, 0, 1)
                    data.healthLabel.Text = string.format("HP: %d / %d", math.floor(health + 0.5), math.floor(maxHealth + 0.5))
                    data.healthFill.Size = UDim2.new(1, 0, ratio, 0)
                    data.healthFill.BackgroundColor3 = Color3.new(1 - ratio, math.max(ratio, 0.12), 0.06)
                else
                    data.healthLabel.Text = "HP: --"
                    data.healthFill.Size = UDim2.new(1, 0, 0, 0)
                end
                data.distanceLabel.Text = myRoot and root
                    and string.format("%s: %d studs", H.tr("Дистанция"), math.floor(distance + 0.5))
                    or H.tr("Дистанция: --")
            end

            local npcScreenPart = root or head
            local npcOffscreenText = string.format("%s  •  %s studs", tostring(model.Name), H.formatESPDistance(distance))
            H.updateOffscreenIndicator(
                data.offscreenArrow, data.offscreenLabel, data.offscreenStroke,
                npcScreenPart and npcScreenPart.Position or nil, color, npcOffscreenText, camera,
                showNPC and H.settings.NPCOffscreenIndicators
            )

            if data.boxFrame then
                data.boxFrame.Visible = showNPC and H.settings.NPCBoxes and boxX ~= nil
                data.boxFrame.BackgroundColor3 = color
                data.boxFrame.BackgroundTransparency = H.settings.NPCESPBoxFill
                    and math.clamp(1 - (math.clamp(tonumber(H.settings.NPCESPBoxFillOpacityPercent) or 15, 5, 45) / 100) + distanceFade * 0.12, 0.5, 1)
                    or 1
                if data.boxStroke then
                    data.boxStroke.Color = color
                    data.boxStroke.Thickness = math.clamp(tonumber(H.settings.NPCESPBoxThickness) or 2, 1, 4)
                    data.boxStroke.Transparency = math.clamp(distanceFade * 0.65, 0, 0.85)
                end
                if showNPC and H.settings.NPCBoxes and boxX then
                    data.boxFrame.Position = UDim2.fromOffset(boxX, boxY)
                    data.boxFrame.Size = UDim2.fromOffset(boxWidth, boxHeight)
                    data.boxFrame.Visible = true
                end
            end

            if data.healthBarBack then
                local barOn = showNPC and H.settings.NPCHealth and H.settings.NPCVerticalHealthBar and humanoid ~= nil and boxX ~= nil and boxHeight ~= nil
                data.healthBarBack.Visible = barOn
                if barOn then
                    data.healthBarBack.Position = UDim2.fromOffset(boxX - 5, boxY)
                    data.healthBarBack.Size = UDim2.fromOffset(4, math.max(8, boxHeight))
                    local healthRatio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                    data.healthFill.Size = UDim2.new(1, 0, healthRatio, 0)
                    data.healthFill.BackgroundColor3 = Color3.new(1 - healthRatio, math.max(healthRatio, 0.12), 0.06)
                end
            end

            if data.tracerFrame then
                data.tracerFrame.Visible = false
                data.tracerFrame.BackgroundColor3 = color
                data.tracerFrame.BackgroundTransparency = distanceFade * 0.55
                if showNPC and H.settings.NPCTracers and camera and root then
                    local point, onScreen = camera:WorldToViewportPoint(root.Position)
                    if onScreen and point.Z > 0 then
                        local viewport = camera.ViewportSize
                        local x0, y0 = viewport.X * 0.5, viewport.Y
                        local dx, dy = point.X - x0, point.Y - y0
                        data.tracerFrame.Position = UDim2.fromOffset((x0 + point.X) * 0.5, (y0 + point.Y) * 0.5)
                        data.tracerFrame.Size = UDim2.fromOffset(math.max(1, math.sqrt(dx * dx + dy * dy)), 1.5)
                        data.tracerFrame.Rotation = math.deg(math.atan2(dy, dx))
                        data.tracerFrame.Visible = true
                    end
                end
            end

            if data.lookDirectionFrame then
                data.lookDirectionFrame.Visible = false
                local directionPart = head or root
                if showNPC and H.settings.NPCShowLookDirection and camera and directionPart then
                    local lengthStuds = math.clamp(tonumber(H.settings.NPCLookDirectionLength) or 18, 5, 80)
                    local a, onA = camera:WorldToViewportPoint(directionPart.Position)
                    local b, onB = camera:WorldToViewportPoint(directionPart.Position + directionPart.CFrame.LookVector * lengthStuds)
                    if onA and onB and a.Z > 0 and b.Z > 0 then
                        local dx, dy = b.X - a.X, b.Y - a.Y
                        local lengthPx = math.sqrt(dx * dx + dy * dy)
                        data.lookDirectionFrame.Position = UDim2.fromOffset((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5)
                        data.lookDirectionFrame.Size = UDim2.fromOffset(math.max(1, lengthPx), 2)
                        data.lookDirectionFrame.Rotation = math.deg(math.atan2(dy, dx))
                        data.lookDirectionFrame.BackgroundColor3 = color
                        data.lookDirectionFrame.Visible = lengthPx >= 2
                    end
                end
            end

            for index, pair in ipairs(H.skeletonPairs) do
                local line = data.skeletonLines[index]
                if line then
                    line.Visible = false
                    if showNPC and H.settings.NPCSkeleton and camera then
                        local partA = model:FindFirstChild(pair[1])
                        local partB = model:FindFirstChild(pair[2])
                        if partA and partB and partA:IsA("BasePart") and partB:IsA("BasePart") then
                            local a, onA = camera:WorldToViewportPoint(partA.Position)
                            local b, onB = camera:WorldToViewportPoint(partB.Position)
                            if onA and onB and a.Z > 0 and b.Z > 0 then
                                local dx, dy = b.X - a.X, b.Y - a.Y
                                local lengthPx = math.sqrt(dx * dx + dy * dy)
                                line.Position = UDim2.fromOffset((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5)
                                line.Size = UDim2.fromOffset(math.max(lengthPx, 1), 2)
                                line.Rotation = math.deg(math.atan2(dy, dx))
                                line.BackgroundColor3 = color
                                line.BackgroundTransparency = distanceFade * 0.55
                                line.Visible = true
                            end
                        end
                    end
                end
            end
        end
    end
    end -- shouldUpdateESP: finish NPC visual geometry updates.

    H.applyMovementSettings()
    H.applyWorldSettings()
    H.applyCameraSettings(camera)
    H.updateCrosshair(camera)

    local aimMarkerVisible = false
    local aimMarkerPoint = nil
    local markerSetting, lineSetting = H.settings.ShowAimTargetMarker, H.settings.ShowAimTargetLine
    local aimPartForMarker = nil
    local aimColor = H.aimColorOverride or H.activeTheme.accent
    if H.aimTargetNPC and H.aimTargetNPC.Parent and H.getNPCAimPart then
        aimPartForMarker = H.getNPCAimPart(H.aimTargetNPC)
        markerSetting, lineSetting = H.settings.ShowNPCAimTargetMarker, H.settings.ShowNPCAimTargetLine
    elseif H.aimTargetPlayer and H.aimTargetPlayer.Parent == H.Players then
        aimPartForMarker = H.getAimPart and H.getAimPart(H.aimTargetPlayer) or nil
    end
    if camera and aimPartForMarker then
        local point, onScreen = camera:WorldToViewportPoint(aimPartForMarker.Position)
        if onScreen and point.Z > 0 then
            aimMarkerPoint = Vector2.new(point.X, point.Y)
            aimMarkerVisible = true
        end
    end
    if H.aimTargetMarker then
        H.aimTargetMarker.Visible = markerSetting and aimMarkerVisible
        if markerSetting and aimMarkerVisible and aimMarkerPoint then
            H.aimTargetMarker.Position = UDim2.fromOffset(aimMarkerPoint.X, aimMarkerPoint.Y)
            H.aimTargetMarkerStroke.Color = aimColor
            H.aimTargetMarkerCenter.BackgroundColor3 = aimColor
        end
    end
    if H.aimTargetLine then
        H.aimTargetLine.Visible = lineSetting and aimMarkerVisible and camera ~= nil and aimMarkerPoint ~= nil
        if H.aimTargetLine.Visible then
            local viewport = camera.ViewportSize
            local x0, y0 = viewport.X * 0.5, viewport.Y * 0.5
            local dx, dy = aimMarkerPoint.X - x0, aimMarkerPoint.Y - y0
            H.aimTargetLine.Position = UDim2.fromOffset((x0 + aimMarkerPoint.X) * 0.5, (y0 + aimMarkerPoint.Y) * 0.5)
            H.aimTargetLine.Size = UDim2.fromOffset(math.max(1, math.sqrt(dx * dx + dy * dy)), 1.5)
            H.aimTargetLine.Rotation = math.deg(math.atan2(dy, dx))
            H.aimTargetLine.BackgroundColor3 = aimColor
        end
    end

    if H.settings.BunnyHop and not H.settings.Fly and myHumanoid and myHumanoid.Health > 0
        and H.UserInputService:IsKeyDown(Enum.KeyCode.Space)
        and myHumanoid.FloorMaterial ~= Enum.Material.Air then
        myHumanoid.Jump = true
    end

    if H.settings.Fly then
        if H.setupFlight() and H.flyVelocity and H.flyGyro and camera then
            H.flyVelocity.Velocity = H.flightDirection(camera) * H.settings.FlySpeed
            H.flyGyro.CFrame = camera.CFrame
        end
    elseif H.flyVelocity or H.flyGyro then
        H.clearFlight()
    end

    if shouldUpdateESP then
    for player, data in pairs(H.tracked) do
        local character = player.Character
        if character and data.character ~= character then
            task.defer(function()
                if player.Parent == H.Players and player.Character == character then
                    H.createESP(player)
                end
            end)
            continue
        end
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local valid = character ~= nil and root ~= nil
        local distanceFromMe = (myRoot and root) and (myRoot.Position - root.Position).Magnitude or math.huge
        local withinRange = distanceFromMe <= H.settings.MaxESPDistance
        local allowedByTeam = not H.settings.OnlyEnemies or H.isEnemy(player)
        local allowedByFriend = not H.settings.SkipFriends or H.friendCache[player] ~= true
        local showPlayer = H.settings.ESP and valid and withinRange and allowedByTeam and allowedByFriend
        local distanceFade = H.settings.ESPDistanceFade
            and (math.clamp(distanceFromMe / math.max(tonumber(H.settings.MaxESPDistance) or 1, 1), 0, 1) * 0.38)
            or 0
        if data.infoFrame and data.infoFrame.Parent then
            local anyInfoEnabled = H.settings.Names or H.settings.TeamLabels or H.settings.Health or H.settings.Distance
            local screenPart = character and character:FindFirstChild("Head")
            local screenPoint, onScreen = nil, false
            if camera and screenPart then
                screenPoint, onScreen = camera:WorldToViewportPoint(screenPart.Position)
            end
            -- Fall back to the root when the head is above/outside the viewport.
            if camera and root and (not screenPoint or not onScreen or screenPoint.Z <= 0) then
                screenPart = root
                screenPoint, onScreen = camera:WorldToViewportPoint(root.Position)
            end
            local inFront = screenPoint ~= nil and screenPoint.Z > 0
            data.infoFrame.Visible = showPlayer and anyInfoEnabled and camera ~= nil and screenPart ~= nil and onScreen and inFront
            if data.infoFrame.Visible then
                data.infoFrame.Position = UDim2.fromOffset(screenPoint.X, math.max(86, screenPoint.Y - 8))
            end
            data.nameLabel.Visible = H.settings.Names
            data.teamLabel.Visible = H.settings.TeamLabels
            data.healthLabel.Visible = H.settings.Health
            data.distanceLabel.Visible = H.settings.Distance
            data.healthBarBack.Visible = false -- updated beside the ESP box below
            data.nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
            data.nameLabel.TextSize = math.clamp(tonumber(H.settings.ESPTextSize) or 12, 9, 20)
            data.nameLabel.TextTransparency = distanceFade * 0.45
            data.nameLabel.TextColor3 = H.playerColor(player)
            data.teamLabel.Text = (H.sameTeam(player, H.LocalPlayer) and H.tr("СОЮЗНИК: ") or H.tr("КОМАНДА: ")) .. H.teamName(player)
            data.teamLabel.TextSize = math.max(8, math.clamp(tonumber(H.settings.ESPTextSize) or 12, 9, 20) - 2)
            data.teamLabel.TextTransparency = distanceFade * 0.45
            data.teamLabel.TextColor3 = H.playerColor(player)
            data.healthLabel.TextSize = math.max(8, math.clamp(tonumber(H.settings.ESPTextSize) or 12, 9, 20) - 2)
            data.healthLabel.TextTransparency = distanceFade * 0.45
            data.distanceLabel.TextSize = math.max(8, math.clamp(tonumber(H.settings.ESPTextSize) or 12, 9, 20) - 2)
            data.distanceLabel.TextTransparency = distanceFade * 0.45
            if humanoid then
                local maxHealth = math.max(humanoid.MaxHealth, 1)
                local health = math.clamp(humanoid.Health, 0, maxHealth)
                local ratio = math.clamp(health / maxHealth, 0, 1)
                data.healthLabel.Text = string.format("HP: %d / %d", math.floor(health + 0.5), math.floor(maxHealth + 0.5))
                data.healthFill.Size = UDim2.new(1, 0, ratio, 0)
                data.healthFill.BackgroundColor3 = Color3.new(1 - ratio, math.max(ratio, 0.12), 0.08)
            else
                data.healthLabel.Text = "HP: --"
                data.healthFill.Size = UDim2.new(1, 0, 0, 0)
            end
            if myRoot and root then
                data.distanceLabel.Text = string.format("%s: %d studs", H.tr("Дистанция"), math.floor((myRoot.Position - root.Position).Magnitude + 0.5))
            else
                data.distanceLabel.Text = H.tr("Дистанция: --")
            end
        end
        local playerScreenPart = character and (root or character:FindFirstChild("Head"))
        local playerOffscreenText = string.format("%s  •  %s studs", tostring(player.DisplayName or player.Name), H.formatESPDistance(distanceFromMe))
        H.updateOffscreenIndicator(
            data.offscreenArrow, data.offscreenLabel, data.offscreenStroke,
            playerScreenPart and playerScreenPart.Position or nil, H.playerColor(player), playerOffscreenText, camera,
            showPlayer and H.settings.OffscreenIndicators
        )
        if data.highlight then
            data.highlight.Enabled = showPlayer and H.settings.Highlight
            data.highlight.FillColor = H.playerColor(player)
            data.highlight.OutlineColor = H.playerColor(player)
            data.highlight.FillTransparency = math.clamp(0.72 + distanceFade * 0.45, 0, 0.98)
            data.highlight.OutlineTransparency = math.clamp(distanceFade * 0.55, 0, 0.8)
        end
        local boxX, boxY, boxWidth, boxHeight
        if showPlayer and camera and (H.settings.Boxes or (H.settings.Health and H.settings.VerticalHealthBar)) then
            boxX, boxY, boxWidth, boxHeight = H.getScreenBounds(character, camera)
        end
        if data.boxFrame then
            data.boxFrame.Visible = showPlayer and H.settings.Boxes and boxX ~= nil
            data.boxFrame.BackgroundColor3 = H.playerColor(player)
            data.boxFrame.BackgroundTransparency = H.settings.ESPBoxFill
                and math.clamp(1 - (math.clamp(tonumber(H.settings.ESPBoxFillOpacityPercent) or 12, 5, 45) / 100) + distanceFade * 0.12, 0.5, 1)
                or 1
            data.boxStroke.Color = H.playerColor(player)
            data.boxStroke.Thickness = math.clamp(tonumber(H.settings.ESPBoxThickness) or 2, 1, 4)
            data.boxStroke.Transparency = math.clamp(distanceFade * 0.65, 0, 0.85)
            if showPlayer and H.settings.Boxes and boxX then
                data.boxFrame.Position = UDim2.fromOffset(boxX, boxY)
                data.boxFrame.Size = UDim2.fromOffset(boxWidth, boxHeight)
                data.boxFrame.Visible = true
            else
                data.boxFrame.Visible = false
            end
        end
        if data.healthBarBack then
            local barOn = showPlayer and H.settings.Health and H.settings.VerticalHealthBar and humanoid ~= nil and boxX ~= nil and boxHeight ~= nil
            data.healthBarBack.Visible = barOn
            if barOn then
                data.healthBarBack.Position = UDim2.fromOffset(boxX - 5, boxY)
                data.healthBarBack.Size = UDim2.fromOffset(4, math.max(8, boxHeight))
                data.healthFill.Size = UDim2.new(1, 0, math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1), 0)
                local healthRatio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                data.healthFill.BackgroundColor3 = Color3.new(1 - healthRatio, math.max(healthRatio, 0.12), 0.06)
            end
        end
        if data.tracerFrame then
            data.tracerFrame.Visible = showPlayer and H.settings.Tracers
            data.tracerFrame.BackgroundColor3 = H.playerColor(player)
            data.tracerFrame.BackgroundTransparency = distanceFade * 0.55
            if showPlayer and H.settings.Tracers and camera and root then
                local point, onScreen = camera:WorldToViewportPoint(root.Position)
                if onScreen and point.Z > 0 then
                    local viewport = camera.ViewportSize
                    local x0, y0 = viewport.X * 0.5, viewport.Y
                    local x1, y1 = point.X, point.Y
                    local dx, dy = x1 - x0, y1 - y0
                    data.tracerFrame.Position = UDim2.fromOffset((x0 + x1) * 0.5, (y0 + y1) * 0.5)
                    data.tracerFrame.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.5)
                    data.tracerFrame.Rotation = math.deg(math.atan2(dy, dx))
                    data.tracerFrame.Visible = true
                else
                    data.tracerFrame.Visible = false
                end
            end
        end
        if data.lookDirectionFrame then
            local lookLine = data.lookDirectionFrame
            local head = character and character:FindFirstChild("Head")
            local shouldDrawLook = showPlayer and H.settings.ShowLookDirection and camera ~= nil and head ~= nil
            if shouldDrawLook then
                local lengthStuds = math.clamp(tonumber(H.settings.LookDirectionLength) or 18, 5, 80)
                local startPoint, startOnScreen = camera:WorldToViewportPoint(head.Position)
                local endWorld = head.Position + head.CFrame.LookVector * lengthStuds
                local endPoint, endOnScreen = camera:WorldToViewportPoint(endWorld)
                if startOnScreen and endOnScreen and startPoint.Z > 0 and endPoint.Z > 0 then
                    local dx, dy = endPoint.X - startPoint.X, endPoint.Y - startPoint.Y
                    local lengthPixels = math.sqrt(dx * dx + dy * dy)
                    lookLine.Position = UDim2.fromOffset((startPoint.X + endPoint.X) * 0.5, (startPoint.Y + endPoint.Y) * 0.5)
                    lookLine.Size = UDim2.fromOffset(math.max(1, lengthPixels), 2)
                    lookLine.Rotation = math.deg(math.atan2(dy, dx))
                    lookLine.BackgroundColor3 = H.playerColor(player)
                    lookLine.Visible = lengthPixels >= 2
                else
                    lookLine.Visible = false
                end
            else
                lookLine.Visible = false
            end
        end
        H.updateSkeleton(player, data, character, camera)
    end
    end -- shouldUpdateESP: finish player visual geometry updates.

    -- The RAGE line diagnoses visibility only; wall penetration is not implemented in this client script.
    if H.wallRayFrame then
        H.wallRayFrame.Visible = false
        if H.settings.ShowShotRayDebug and camera then
            local targetPlayer = H.selectedTarget
            local targetCharacter = targetPlayer and targetPlayer.Character
            local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
            local targetPart = targetCharacter and (targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart"))
            if targetPlayer and targetPlayer ~= H.LocalPlayer and targetPlayer.Parent == H.Players and targetHumanoid and targetHumanoid.Health > 0 and targetPart then
                local viewport = camera.ViewportSize
                local targetPoint, targetOnScreen = camera:WorldToViewportPoint(targetPart.Position)
                if targetOnScreen and targetPoint.Z > 0 then
                    local x0, y0 = viewport.X * 0.5, viewport.Y * 0.5
                    local x1, y1 = targetPoint.X, targetPoint.Y
                    local dx, dy = x1 - x0, y1 - y0
                    H.wallRayFrame.Position = UDim2.fromOffset((x0 + x1) * 0.5, (y0 + y1) * 0.5)
                    H.wallRayFrame.Size = UDim2.fromOffset(math.max(1, math.sqrt(dx * dx + dy * dy)), 2)
                    H.wallRayFrame.Rotation = math.deg(math.atan2(dy, dx))
                    local rayClear = H.isVisibleToCamera(targetPlayer, targetPart, camera)
                    H.wallRayFrame.BackgroundColor3 = rayClear and Color3.fromRGB(70, 230, 130) or Color3.fromRGB(255, 70, 95)
                    H.wallRayFrame.Visible = true
                    H.wallRayElapsed += deltaTime
                    if H.wallRayElapsed >= 0.2 and H.wallRayStatus then
                        H.wallRayElapsed = 0
                        local statusRU = rayClear and ("ЛУЧ СВОБОДЕН: " .. targetPlayer.Name) or ("ПРЕПЯТСТВИЕ: " .. targetPlayer.Name)
                        local statusEN = rayClear and ("RAY CLEAR: " .. targetPlayer.Name) or ("OBSTRUCTED: " .. targetPlayer.Name)
                        H.wallRayStatus.Text = H.currentLanguage == "RU" and statusRU or statusEN
                    end
                elseif H.wallRayStatus then
                    H.wallRayStatus.Text = H.currentLanguage == "RU" and "Цель вне экрана." or "Target is off screen."
                end
            elseif H.wallRayStatus then
                H.wallRayStatus.Text = H.currentLanguage == "RU" and "Выбери живого игрока во вкладке Игроки." or "Select a living player in Players."
            end
        end
    end

    H.fovCircle.Visible = H.settings.AimCircle
    if camera then
        local fovViewport = camera.ViewportSize
        local fovCenterX, fovCenterY = fovViewport.X * 0.5, fovViewport.Y * 0.5
        -- Align both circles with WorldToViewportPoint's viewport coordinate system.
        H.fovCircle.Position = UDim2.fromOffset(fovCenterX, fovCenterY)
        H.npcAimFovCircle.Position = UDim2.fromOffset(fovCenterX, fovCenterY)
        if H.fovRadiusHud then
            H.fovRadiusHud.Visible = H.settings.AimCircle
            local targetRadiusText = tostring(math.floor(H.settings.FOVRadius + 0.5))
            local displayRadiusText = tostring(math.floor(H.settings.FOVRadius * H.settings.AimFOVDisplayScalePercent / 100 + 0.5))
            H.fovRadiusHud.Text = H.currentLanguage == "RU"
                and ("Выбор: " .. targetRadiusText .. " px | круг: " .. displayRadiusText .. " px")
                or ("Target: " .. targetRadiusText .. " px | display: " .. displayRadiusText .. " px")
            H.fovRadiusHud.Position = UDim2.fromOffset(fovCenterX, math.max(14, fovCenterY - H.settings.FOVRadius * (H.settings.AimFOVDisplayScalePercent / 100) - 18))
            H.fovRadiusHud.TextColor3 = H.aimColorOverride or H.activeTheme.accent
        end
        if H.npcAimFovHud then
            H.npcAimFovHud.Visible = H.settings.NPCAimCircle and (H.settings.NPCAimAssist or H.settings.NPCAimCirclePreview)
            local npcTargetRadiusText = tostring(math.floor(H.settings.NPCAimFOVRadius + 0.5))
            local npcDisplayRadiusText = tostring(math.floor(H.settings.NPCAimFOVRadius * H.settings.NPCAimFOVDisplayScalePercent / 100 + 0.5))
            H.npcAimFovHud.Text = H.currentLanguage == "RU"
                and ("NPC выбор: " .. npcTargetRadiusText .. " px | круг: " .. npcDisplayRadiusText .. " px")
                or ("NPC target: " .. npcTargetRadiusText .. " px | display: " .. npcDisplayRadiusText .. " px")
            H.npcAimFovHud.Position = UDim2.fromOffset(fovCenterX, math.max(14, fovCenterY - H.settings.NPCAimFOVRadius * (H.settings.NPCAimFOVDisplayScalePercent / 100) - 18))
            H.npcAimFovHud.TextColor3 = H.aimColorOverride or H.activeTheme.accent
        end
    end
    local pulseClock = os.clock()
    local aimPulseScale = 1
    if H.settings.AimFOVCirclePulse and not H.settings.ReduceMotion and not H.settings.SoftOptimization then
        aimPulseScale = 1 + math.sin(pulseClock * 2.1) * 0.025
    end
    local npcPulseScale = 1
    if H.settings.NPCAimFOVCirclePulse and not H.settings.ReduceMotion and not H.settings.SoftOptimization then
        npcPulseScale = 1 + math.sin(pulseClock * 2.1 + 0.8) * 0.025
    end
    local aimDisplayRadius = H.settings.FOVRadius * (H.settings.AimFOVDisplayScalePercent / 100) * aimPulseScale
    local npcAimDisplayRadius = H.settings.NPCAimFOVRadius * (H.settings.NPCAimFOVDisplayScalePercent / 100) * npcPulseScale
    H.fovCircle.Size = UDim2.fromOffset(aimDisplayRadius * 2, aimDisplayRadius * 2)
    H.npcAimFovCircle.Visible = H.settings.NPCAimCircle and (H.settings.NPCAimAssist or H.settings.NPCAimCirclePreview)
    H.npcAimFovCircle.Size = UDim2.fromOffset(npcAimDisplayRadius * 2, npcAimDisplayRadius * 2)
    H.fovStroke.Color = H.aimColorOverride or H.activeTheme.accent
    H.fovStroke.Thickness = H.settings.AimFOVCircleThickness
    H.fovStroke.Transparency = H.settings.AimFOVCircleTransparencyPercent / 100
    H.npcAimFovStroke.Color = H.aimColorOverride or H.activeTheme.accent
    H.npcAimFovStroke.Thickness = H.settings.NPCAimFOVCircleThickness
    H.npcAimFovStroke.Transparency = H.settings.NPCAimFOVCircleTransparencyPercent / 100
    for _, segment in ipairs(H.crosshairSegments or {}) do segment.Visible = H.settings.Crosshair end
    if H.fpsLabel then H.fpsLabel.Visible = H.settings.ShowFPS end
    if H.runtimeMetricsLabel then H.runtimeMetricsLabel.Visible = H.settings.ShowPing or H.settings.ShowMemory or H.settings.ShowPlayerCount end
    if H.coordinatesHud then H.coordinatesHud.Visible = H.settings.ShowCoordinates end
    if H.fpsLabel then
        H.fpsFrameCount += 1
        H.fpsElapsed += deltaTime
        if H.fpsElapsed >= 0.25 then
            local fps = math.floor(H.fpsFrameCount / math.max(H.fpsElapsed, 0.001) + 0.5)
            H.fpsLabel.Text = "FPS: " .. tostring(fps)
            H.fpsFrameCount, H.fpsElapsed = 0, 0
        end
    end
    H.dashboardRefreshElapsed += deltaTime
    if H.dashboardRefreshElapsed >= 0.5 then
        H.dashboardRefreshElapsed = 0
        local localRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        local healthText = myHumanoid and (tostring(math.floor(myHumanoid.Health + 0.5)) .. "/" .. tostring(math.floor(myHumanoid.MaxHealth + 0.5))) or "--"
