H.getMiniDockPixelSize = function()
    local scale = math.clamp((tonumber(H.settings and H.settings.MiniDockScalePercent) or 100) / 100, 0.5, 2)
    return math.clamp(math.floor(58 * scale + 0.5), 29, 116)
end
H.getMiniDockCompactPixelSize = function()
    return math.max(22, math.floor(H.getMiniDockPixelSize() * (34 / 58) + 0.5))
end
H.applyMiniDockScale = function()
    if not H.openButton or not H.openButton.Parent then return end
    local size = H.getMiniDockPixelSize()
    H.openButton.Size = UDim2.fromOffset(size, size)
    local inset = math.clamp(math.floor(size * 0.14 + 0.5), 3, 8)
    if H.miniLogoImage then H.miniLogoImage.Size = UDim2.new(1, -inset * 2, 1, -inset * 2) end
