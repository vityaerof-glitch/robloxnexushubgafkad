H.applyUIPreset = function(presetName)
    local presets = {
        NEBULA = {theme = 8, scale = 100, animation = 110, reduce = false, optimized = false, debug = false},
        COMPACT = {theme = H.themeIndex, scale = 82, animation = 85, reduce = false, optimized = true, debug = false},
        SHOWCASE = {theme = 9, scale = 105, animation = 135, reduce = false, optimized = false, debug = true},
        ACCESSIBLE = {theme = H.themeIndex, scale = 115, animation = 80, reduce = true, optimized = false, debug = false},
        PERFORMANCE = {theme = H.themeIndex, scale = 90, animation = 70, reduce = true, optimized = true, debug = false},
    }
    local preset = presets[presetName]
    if not preset then return end
    H.settings.UIScalePercent = preset.scale
    H.settings.AnimationSpeedPercent = preset.animation
    H.settings.ReduceMotion = preset.reduce
    H.settings.SoftOptimization = preset.optimized
    H.settings.ShowDebugHUD = preset.debug
    if presetName == "NEBULA" then H.applyTheme(8) elseif presetName == "SHOWCASE" then H.applyTheme(9) end
    for key, setter in pairs(H.sliderSetters) do
        if H.settings[key] ~= nil and type(H.settings[key]) == "number" then pcall(setter, H.settings[key]) end
    end
    for key, render in pairs(H.toggleRenderers) do pcall(render) end
    if H.updateResponsiveScale then H.updateResponsiveScale() end
    if H.showToast then H.showToast("Интерфейсный профиль: " .. presetName) end
    if H.savePersistentSettings then task.defer(function() pcall(H.savePersistentSettings, false) end) end
end
