            object.BackgroundColor3 = H.activeTheme.header
        elseif role == "panel" then
            object.BackgroundColor3 = H.activeTheme.panel
            if object:IsA("TextLabel") then object.TextColor3 = H.activeTheme.text end
        elseif role == "input" then
            object.BackgroundColor3 = H.activeTheme.input
