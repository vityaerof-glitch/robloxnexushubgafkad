-- Four compact telemetry cards keep the dashboard useful at a glance; values update at 1 Hz.
H.dashboardMetricCards = {}
H.dashboardMetricValues = {FPS = "--", PING = "--", MEMORY = "--", PLAYERS = "--"}
H.dashboardMetricRow = Instance.new("Frame")
