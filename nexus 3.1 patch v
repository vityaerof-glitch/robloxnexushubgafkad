H.dashboardMetricRow.Size = UDim2.new(1, -5, 0, 74)
H.dashboardMetricRow.BackgroundTransparency = 1
H.dashboardMetricRow.BorderSizePixel = 0
H.dashboardMetricRow.LayoutOrder = #H.pages["Обзор"]:GetChildren() + 1
H.dashboardMetricRow.Parent = H.pages["Обзор"]
local metricLayout = Instance.new("UIListLayout")
metricLayout.FillDirection = Enum.FillDirection.Horizontal
metricLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
metricLayout.VerticalAlignment = Enum.VerticalAlignment.Center
metricLayout.Padding = UDim.new(0, 8)
metricLayout.Parent = H.dashboardMetricRow
local metricSpecs = {
    {key = "FPS", title = "FPS", note = "FRAME RATE"},
    {key = "PING", title = "PING", note = "NETWORK"},
    {key = "MEMORY", title = "MEMORY", note = "CLIENT MB"},
    {key = "PLAYERS", title = "PLAYERS", note = "IN SESSION"},
}
for _, spec in ipairs(metricSpecs) do
    local card = Instance.new("Frame")
    card.Name = "Metric_" .. spec.key
    card:SetAttribute("ThemeRole", "panel")
    card.Size = UDim2.new(0.25, -6, 1, 0)
    card.BackgroundColor3 = H.activeTheme.panel
    card.BorderSizePixel = 0
    card.Parent = H.dashboardMetricRow
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
    local edge = Instance.new("UIStroke", card)
    edge:SetAttribute("ThemeRole", "accentStroke")
    edge.Transparency = 0.76
    edge.Thickness = 1
    local topLine = Instance.new("Frame")
    topLine:SetAttribute("ThemeRole", "accentFill")
    topLine.BorderSizePixel = 0
    topLine.Position = UDim2.new(0, 10, 0, 0)
    topLine.Size = UDim2.new(1, -20, 0, 2)
    topLine.Parent = card
    Instance.new("UICorner", topLine).CornerRadius = UDim.new(1, 0)
    local heading = Instance.new("TextLabel")
    heading:SetAttribute("ThemeRole", "mutedText")
    heading.BackgroundTransparency = 1
    heading.Position = UDim2.fromOffset(10, 9)
    heading.Size = UDim2.new(1, -20, 0, 12)
    heading.Text = spec.title
    heading.TextColor3 = H.activeTheme.muted
    heading.Font = Enum.Font.GothamBold
    heading.TextSize = 8
    heading.TextXAlignment = Enum.TextXAlignment.Left
    heading.Parent = card
    local value = Instance.new("TextLabel")
    value.Name = "Value"
    value:SetAttribute("ThemeRole", "text")
    value:SetAttribute("NoLocalize", true)
    value.BackgroundTransparency = 1
    value.Position = UDim2.fromOffset(10, 22)
    value.Size = UDim2.new(1, -20, 0, 25)
    value.Text = H.dashboardMetricValues[spec.key]
    value.TextColor3 = H.activeTheme.text
    value.Font = Enum.Font.GothamBlack
    value.TextSize = 19
    value.TextXAlignment = Enum.TextXAlignment.Left
    value.Parent = card
    local note = Instance.new("TextLabel")
    note:SetAttribute("ThemeRole", "mutedText")
    note.BackgroundTransparency = 1
    note.Position = UDim2.fromOffset(10, 49)
    note.Size = UDim2.new(1, -20, 0, 12)
    note.Text = spec.note
    note.TextColor3 = H.activeTheme.muted
    note.Font = Enum.Font.Gotham
    note.TextSize = 7
    note.TextXAlignment = Enum.TextXAlignment.Left
    note.Parent = card
    H.dashboardMetricCards[spec.key] = value
end
