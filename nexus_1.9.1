H.tr = function(text)
    if H.currentLanguage == "RU" then return text end
    local key = H.upperCategoryKeys[text] or text
    local locale = H.localeTables[H.currentLanguage] or H.translations
    local value = locale[key] or H.translations[key] or key
    if H.upperCategoryKeys[text] then
        return string.upper(value)
    end
    return value
end

H.setTextLocalized = function(object, russianText)
    if not object then return end
    object:SetAttribute("RUText", russianText)
    object.Text = H.tr(russianText)
end

H.refreshLanguage = function()
    for _, object in ipairs(H.gui:GetDescendants()) do
        local russianText = object:GetAttribute("RUText")
        if russianText and not object:GetAttribute("NoLocalize") and (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
            object.Text = H.tr(russianText)
        end
    end
    for _, refresher in ipairs(H.languageRefreshers) do
        pcall(refresher)
    end
    if H.searchBox then H.searchBox.PlaceholderText = H.tr("Поиск настроек / Search settings") end
    if H.languageButton then H.languageButton.Text = H.tr("Язык / Language") .. ": " .. (H.languageNames[H.currentLanguage] or H.currentLanguage) end
    if H.themeButton and H.activeTheme then H.themeButton.Text = H.tr("Тема GUI") .. ": " .. H.activeTheme.name end
    if H.updateTeamStatus then task.defer(H.updateTeamStatus) end
end

H.getTeam = function(player)
    if not player then return nil end
    if player.Team then return player.Team end
    if player.Neutral then return nil end
    for _, team in ipairs(H.Teams:GetTeams()) do
        if team.TeamColor == player.TeamColor then return team end
    end
    return nil
end

H.teamName = function(player)
    local team = H.getTeam(player)
    if team then return team.Name end
    if player and not player.Neutral then return player.TeamColor.Name .. " (TeamColor)" end
    return "Neutral / не задана"
end

H.sameTeam = function(a, b)
    if not a or not b then return false end
    if a.Neutral or b.Neutral then return false end
    local ta, tb = H.getTeam(a), H.getTeam(b)
    if ta and tb then return ta == tb end
    return a.TeamColor == b.TeamColor
end

H.playerColor = function(player)
    if H.espColorOverride then return H.espColorOverride end
    if H.settings.TeamColors and player then
        local team = H.getTeam(player)
        if team then return team.TeamColor.Color end
        if not player.Neutral then return player.TeamColor.Color end
    end
    return H.activeTheme.accent
end

