H.applyBuiltinPreset = function(name)
    local profile = H.builtinConfigPresets[name]
    if not profile then return end
    local mergedPresetSettings = {}
    for key, value in pairs(H.defaultSettings) do mergedPresetSettings[key] = value end
    for key, value in pairs(profile.settings) do mergedPresetSettings[key] = value end
    if H.applyImportedConfig({settings = mergedPresetSettings}) then
        if H.configNameBox then H.configNameBox.Text = name end
        local description = profile.description or "Preset loaded."
        if H.configStatusLabel then
            H.configStatusLabel.Size = UDim2.new(1, -5, 0, 70)
            H.configStatusLabel.Text = H.currentLanguage == "RU"
                and ("Профиль " .. name .. " применён. " .. description)
                or ("Preset " .. name .. " applied. " .. description)
        end
        -- Update currently rendered controls immediately after applying a preset.
        for _, render in pairs(H.toggleRenderers) do pcall(render) end
        for key, setter in pairs(H.sliderSetters) do
            if H.settings[key] ~= nil and type(H.settings[key]) == "number" then pcall(setter, H.settings[key]) end
        end
        H.refreshKeybindButtons()
    end
end

