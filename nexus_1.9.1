                H.serverHopStatus.Text = (ru and "Ошибка Server Hop: " or "Server Hop error: ") .. tostring(detail or "unknown error")
            elseif kind == "studio" then
                H.serverHopStatus.Text = ru and "Телепорты не тестируются в Studio. Запусти опубликованную игру в приложении Roblox." or "Teleporting cannot be tested in Studio. Join the published experience in the Roblox app."
