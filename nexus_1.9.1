    H.releaseCardStroke.Color = H.activeTheme.accent
    H.releaseCardStroke.Thickness = 1.4
    H.releaseCardStroke.Transparency = 0.12

    H.releaseScale = Instance.new("UIScale")
    H.releaseScale.Name = "ReleaseCardScale"
    H.releaseScale.Scale = 0.93
    H.releaseScale.Parent = H.releaseCard
    H.releaseScaleTarget = 1
    H.releaseAnimating = true
    H.updateReleaseScale = function()
        local camera = workspace.CurrentCamera
        if not camera or not H.releaseScale or not H.releaseScale.Parent then return end
        local viewport = camera.ViewportSize
        H.releaseScaleTarget = math.clamp(math.min((viewport.X - 28) / 780, (viewport.Y - 28) / 570), 0.55, 1)
        if not H.releaseAnimating then H.releaseScale.Scale = H.releaseScaleTarget end
    end
    H.updateReleaseScale()
    if H.releaseViewportConnection then pcall(function() H.releaseViewportConnection:Disconnect() end) end
