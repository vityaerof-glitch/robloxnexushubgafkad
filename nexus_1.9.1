        H.TweenService:Create(H.releaseOverlay, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
        H.TweenService:Create(H.releaseScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = math.max(0.72, H.releaseScale.Scale * 0.94)}):Play()
        for _, object in ipairs(H.releaseOverlay:GetDescendants()) do
