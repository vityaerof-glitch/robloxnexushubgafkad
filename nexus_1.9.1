H.updateCrosshair = function(camera)
    if not camera then return end
    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local size = H.settings.CrosshairSize
    local gap = 4
    local thickness = 2
    local segments = H.crosshairSegments
    segments[1].Position = UDim2.fromOffset(center.X, center.Y - gap - size / 2)
    segments[1].Size = UDim2.fromOffset(thickness, size)
    segments[2].Position = UDim2.fromOffset(center.X, center.Y + gap + size / 2)
    segments[2].Size = UDim2.fromOffset(thickness, size)
    segments[3].Position = UDim2.fromOffset(center.X - gap - size / 2, center.Y)
    segments[3].Size = UDim2.fromOffset(size, thickness)
    segments[4].Position = UDim2.fromOffset(center.X + gap + size / 2, center.Y)
    segments[4].Size = UDim2.fromOffset(size, thickness)
    for _, segment in ipairs(segments) do
        segment.Visible = H.settings.Crosshair
        segment.BackgroundColor3 = H.mainStroke.Color
    end
    H.centerDot.Visible = H.settings.Crosshair
    H.centerDot.Position = UDim2.fromOffset(center.X, center.Y)
    H.centerDot.BackgroundColor3 = H.mainStroke.Color
end

H.applySearchFilter = function()
    local query = string.lower(H.searchBox.Text or "")
    for pageName, controls in pairs(H.pageControls) do
        for _, control in ipairs(controls) do
            if control and control.Parent then
                local russianSearch = tostring(control:GetAttribute("SearchText") or "")
                local displaySearch = tostring(control:GetAttribute("RUText") or "")
                if control:IsA("TextLabel") or control:IsA("TextButton") or control:IsA("TextBox") then
                    displaySearch = displaySearch .. " " .. tostring(control.Text)
                end
                local searchable = string.lower(russianSearch .. " " .. displaySearch .. " " .. H.tr(russianSearch))
                local visible = query == "" or string.find(searchable, query, 1, true) ~= nil
                control.Visible = visible
            end
        end
    end
end
H.searchBox:GetPropertyChangedSignal("Text"):Connect(H.applySearchFilter)

H.removeESP = function(player)
    local data = H.tracked[player]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.infoFrame then data.infoFrame:Destroy() end
    if data.healthBarBack then data.healthBarBack:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    if data.boxFrame then data.boxFrame:Destroy() end
    if data.tracerFrame then data.tracerFrame:Destroy() end
    if data.lookDirectionFrame then data.lookDirectionFrame:Destroy() end
    for _, line in ipairs(data.skeletonLines or {}) do
        if line then line:Destroy() end
    end
    H.tracked[player] = nil
end

