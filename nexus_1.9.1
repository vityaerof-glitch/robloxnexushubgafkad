H.findPaletteChoice = function(choices, key)
    for _, choice in ipairs(choices) do
        if choice.key == key then return choice end
    end
    return choices[1]
end
H.applyGuiAccentByName = function(key)
    local choice = H.findPaletteChoice(H.guiAccentChoices, key)
    H.guiAccentName = choice.key
    if choice.key == "DEFAULT" then
        H.guiAccentColor = nil
    else
        H.guiAccentColor = choice.color
    end
    if H.applyTheme then H.applyTheme(H.themeIndex) end
end
H.applyESPColorByName = function(key)
    local choice = H.findPaletteChoice(H.espColorChoices, key)
    H.espColorName = choice.key
    if choice.key == "TEAM" then
        H.espColorOverride = nil
    else
        H.espColorOverride = choice.color
    end
    if H.refreshVisuals then pcall(H.refreshVisuals) end
    if H.espPaletteRefresh then pcall(H.espPaletteRefresh) end
end
H.makePalettePanel = function(parent, panelName, titleText, choices, getSelectedKey, onSelected)
    local pageName = parent.Name:gsub("^Page_", "")
    local holder = Instance.new("Frame")
    holder.Name = panelName
    holder:SetAttribute("ThemeRole", "panel")
    holder:SetAttribute("SearchText", titleText .. " color palette colour accent esp")
    holder.Size = UDim2.new(1, -5, 0, 78)
    holder.BackgroundColor3 = H.activeTheme.panel
    holder.BorderSizePixel = 0
    holder.Parent = parent
    if H.pageControls[pageName] then table.insert(H.pageControls[pageName], holder) end
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

    local title = Instance.new("TextLabel")
    title.Name = "PaletteTitle"
    title:SetAttribute("ThemeRole", "text")
    title.Position = UDim2.fromOffset(9, 4)
    title.Size = UDim2.new(1, -18, 0, 17)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextColor3 = H.activeTheme.text
    title.Font = Enum.Font.GothamBold
    title.TextSize = 10
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = holder

    local swatchRow = Instance.new("Frame")
    swatchRow.Name = "Swatches"
    swatchRow.Position = UDim2.fromOffset(8, 25)
    swatchRow.Size = UDim2.new(1, -16, 0, 27)
    swatchRow.BackgroundTransparency = 1
    swatchRow.Parent = holder
    local rowLayout = Instance.new("UIListLayout")
    rowLayout.FillDirection = Enum.FillDirection.Horizontal
    rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
    rowLayout.Padding = UDim.new(0, 5)
    rowLayout.Parent = swatchRow

    local selectedLabel = Instance.new("TextLabel")
    selectedLabel.Name = "PaletteSelection"
    selectedLabel:SetAttribute("ThemeRole", "text")
    selectedLabel.Position = UDim2.fromOffset(9, 54)
    selectedLabel.Size = UDim2.new(1, -18, 0, 16)
    selectedLabel.BackgroundTransparency = 1
    selectedLabel.TextColor3 = H.activeTheme.muted
    selectedLabel.Font = Enum.Font.GothamMedium
    selectedLabel.TextSize = 9
    selectedLabel.TextXAlignment = Enum.TextXAlignment.Left
    selectedLabel.Parent = holder

    local buttons = {}
    local refresh = function()
        local selectedKey = getSelectedKey()
        local selectedChoice = H.findPaletteChoice(choices, selectedKey)
        selectedLabel.Text = (H.currentLanguage == "RU" and "Выбрано: " or "Selected: ") .. (selectedChoice and selectedChoice.label or tostring(selectedKey))
        for _, item in ipairs(buttons) do
            local selected = item.key == selectedKey
            item.stroke.Color = selected and H.activeTheme.accent or H.activeTheme.track
            item.stroke.Thickness = selected and 2 or 1
            item.stroke.Transparency = selected and 0 or 0.35
            item.button.Size = selected and UDim2.fromOffset(34, 27) or UDim2.fromOffset(32, 25)
            if item.choice.key == "DEFAULT" then
                item.button.BackgroundColor3 = H.guiAccentColor or H.themePresets[H.themeIndex].accent
            end
        end
    end
    for index, choice in ipairs(choices) do
        local button = Instance.new("TextButton")
        button.Name = string.format("Swatch_%02d_%s", index, choice.key)
        button.LayoutOrder = index
        button.Size = UDim2.fromOffset(32, 25)
        button.BackgroundColor3 = choice.color
        button.BorderSizePixel = 0
        button.Text = choice.short or ""
        button.TextColor3 = (choice.key == "ICE" or choice.key == "WHITE" or choice.key == "DEFAULT") and Color3.fromRGB(18, 24, 34) or Color3.fromRGB(255, 255, 255)
        button.Font = Enum.Font.GothamBlack
        button.TextSize = 8
        button.AutoButtonColor = false
        button:SetAttribute("SearchText", choice.label .. " " .. choice.key .. " palette color colour")
        button.Parent = swatchRow
        Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
        local stroke = Instance.new("UIStroke", button)
        stroke.Thickness = 1
        stroke.Color = H.activeTheme.track
        stroke.Transparency = 0.35
        buttons[#buttons + 1] = {key = choice.key, button = button, stroke = stroke, choice = choice}
        button.Activated:Connect(function()
            onSelected(choice.key)
            refresh()
        end)
        button.MouseEnter:Connect(function()
            H.TweenService:Create(button, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(34, 27)}):Play()
        end)
        button.MouseLeave:Connect(function()
            refresh()
        end)
    end
    return refresh
end
