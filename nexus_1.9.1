-- Full GUI palette selector. Changing a theme recolors the complete menu, not only the outline.
H.applyTheme = function(index)
    H.themeIndex = ((math.floor(tonumber(index) or 1) - 1) % #H.themePresets) + 1
    H.activeTheme = table.clone(H.themePresets[H.themeIndex])
    if H.guiAccentColor then
        H.activeTheme.accent = H.guiAccentColor
        -- Derive tab/button active shades from the chosen accent while retaining theme contrast.
        H.activeTheme.active = H.activeTheme.background:Lerp(H.guiAccentColor, 0.34)
        H.activeTheme.selectedTab = H.activeTheme.background:Lerp(H.guiAccentColor, 0.29)
    end
    for _, object in ipairs(H.gui:GetDescendants()) do
        local role = object:GetAttribute("ThemeRole")
        if role == "background" then
            object.BackgroundColor3 = H.activeTheme.background
        elseif role == "header" then
            object.BackgroundColor3 = H.activeTheme.header
        elseif role == "panel" then
            object.BackgroundColor3 = H.activeTheme.panel
            if object:IsA("TextLabel") then object.TextColor3 = H.activeTheme.text end
        elseif role == "input" then
            object.BackgroundColor3 = H.activeTheme.input
            if object:IsA("TextBox") then
                object.TextColor3 = H.activeTheme.text
                object.PlaceholderColor3 = H.activeTheme.muted
            end
        elseif role == "button" then
            object.BackgroundColor3 = H.activeTheme.control
            if object:IsA("TextButton") then object.TextColor3 = H.activeTheme.text end
        elseif role == "tab" then
            local tabName = object:GetAttribute("ThemeTabName")
            object.BackgroundColor3 = (tabName == H.currentPageName) and H.activeTheme.selectedTab or H.activeTheme.control
            object.TextColor3 = H.activeTheme.text
        elseif role == "page" then
            object.ScrollBarImageColor3 = H.activeTheme.accent
        elseif role == "text" then
            object.TextColor3 = H.activeTheme.text
        elseif role == "sliderTrack" then
            object.BackgroundColor3 = H.activeTheme.track
        elseif role == "sliderKnob" then
            object.BackgroundColor3 = H.activeTheme.text
        elseif role == "accentFill" then
            object.BackgroundColor3 = H.activeTheme.accent
        elseif role == "accentText" then
            object.TextColor3 = H.activeTheme.accent
        elseif role == "accentStroke" then
            if object:IsA("UIStroke") then object.Color = H.activeTheme.accent end
        elseif role == "headerGradient" then
            if object:IsA("UIGradient") then object.Color = ColorSequence.new(H.activeTheme.header, H.activeTheme.background) end
        elseif role == "miniGradient" then
            if object:IsA("UIGradient") then object.Color = ColorSequence.new(H.activeTheme.accent, H.activeTheme.header) end
        elseif role == "danger" then
            object.BackgroundColor3 = H.activeTheme.danger
        elseif role == "open" then
            object.BackgroundColor3 = H.activeTheme.accent
            object.TextColor3 = Color3.new(1, 1, 1)
        end
    end
    H.main.BackgroundColor3 = H.activeTheme.background
    H.header.BackgroundColor3 = H.activeTheme.header
    H.status.BackgroundColor3 = H.activeTheme.panel
    H.status.TextColor3 = H.activeTheme.text
    H.title.TextColor3 = H.activeTheme.accent
    if H.versionBadge then H.versionBadge.TextColor3 = H.activeTheme.accent; H.versionBadge.BackgroundColor3 = H.activeTheme.panel end
    H.authorLabel.TextColor3 = H.activeTheme.muted
    local useEmbeddedLogo = H.embeddedLogoCanvas ~= nil and not H.hasNexusLogoAsset
    H.brandMark.BackgroundColor3 = useEmbeddedLogo and Color3.fromRGB(5, 2, 14) or H.activeTheme.accent
    H.brandGlyph.TextColor3 = Color3.fromRGB(10, 22, 34)
    if H.openButton then H.openButton.BackgroundColor3 = useEmbeddedLogo and Color3.fromRGB(5, 2, 14) or H.activeTheme.accent end
    if H.openButtonGradient then H.openButtonGradient.Color = useEmbeddedLogo and ColorSequence.new(Color3.fromRGB(24, 5, 50), Color3.fromRGB(5, 2, 14)) or ColorSequence.new(H.activeTheme.accent, H.activeTheme.header) end
    H.headerBadge.BackgroundColor3 = H.activeTheme.panel
    H.headerBadge.TextColor3 = H.activeTheme.text
    H.sidebarFooter.TextColor3 = H.activeTheme.muted
    H.mainStroke.Color = H.activeTheme.accent
    for key, button in pairs(H.settingsButtons) do
        if button and button.Parent then
            button.BackgroundColor3 = H.settings[key] and H.activeTheme.active or H.activeTheme.control
            button.TextColor3 = H.activeTheme.text
        end
    end
    for name, tab in pairs(H.tabs) do
        tab.BackgroundColor3 = (name == H.currentPageName) and H.activeTheme.selectedTab or H.activeTheme.control
        tab.TextColor3 = H.activeTheme.text
        if H.tabAccents[name] then H.tabAccents[name].Visible = name == H.currentPageName end
        local tabStroke = tab:FindFirstChildOfClass("UIStroke")
        if tabStroke then tabStroke.Color = H.activeTheme.accent; tabStroke.Transparency = name == H.currentPageName and 0.58 or 1 end
        local iconLabel = tab:FindFirstChild("Icon")
        if iconLabel then iconLabel.TextColor3 = H.activeTheme.accent end
    end
    if H.searchBox then
        H.searchBox.BackgroundColor3 = H.activeTheme.input
        H.searchBox.TextColor3 = H.activeTheme.text
        H.searchBox.PlaceholderColor3 = H.activeTheme.muted
        H.tabBar.ScrollBarImageColor3 = H.activeTheme.accent
        H.searchStroke.Color = H.activeTheme.accent
        H.contentStroke.Color = H.activeTheme.accent
        H.statusStroke.Color = H.activeTheme.accent
        H.sidebarStroke.Color = H.activeTheme.accent
    end
    if H.fovStroke then H.fovStroke.Color = H.activeTheme.accent end
    for _, segment in ipairs(H.crosshairSegments or {}) do segment.BackgroundColor3 = H.activeTheme.accent end
    if H.centerDot then H.centerDot.BackgroundColor3 = H.activeTheme.accent end
    if H.fpsLabel then H.fpsLabel.TextColor3 = H.activeTheme.accent end
    if H.runtimeMetricsLabel then H.runtimeMetricsLabel.TextColor3 = H.activeTheme.text; H.runtimeMetricsLabel.BackgroundColor3 = H.activeTheme.background end
    if H.coordinatesHud then H.coordinatesHud.TextColor3 = H.activeTheme.text; H.coordinatesHud.BackgroundColor3 = H.activeTheme.background end
    for _, object in ipairs(H.gui:GetDescendants()) do
        if object:IsA("Frame") and object.Name == "SkeletonLine" and not H.settings.TeamColors then
            object.BackgroundColor3 = H.activeTheme.accent
        end
    end
    if H.themeButton then H.themeButton.Text = H.tr("Тема GUI") .. ": " .. H.activeTheme.name end
    if H.guiAccentPaletteRefresh then pcall(H.guiAccentPaletteRefresh) end
    if H.espPaletteRefresh then pcall(H.espPaletteRefresh) end
end

