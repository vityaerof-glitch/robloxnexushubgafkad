H.makeButton = function(parent, text, callback)
    local button = Instance.new("TextButton")
    button:SetAttribute("ThemeRole", "button")
    button.Size = UDim2.new(1, -5, 0, 38)
    button.BackgroundColor3 = Color3.fromRGB(39, 44, 56)
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.TextColor3 = Color3.fromRGB(245, 248, 252)
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 12
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.TextWrapped = true
    button.Active = true
    H.setTextLocalized(button, text)
    local hoverStroke = Instance.new("UIStroke")
    hoverStroke:SetAttribute("ThemeRole", "accentStroke")
    hoverStroke.Color = H.activeTheme.accent
    hoverStroke.Thickness = 1
    hoverStroke.Transparency = 1
    hoverStroke.Parent = button
    button.MouseEnter:Connect(function()
        local toggleKey = button:GetAttribute("ToggleSetting")
        local hoverColor = toggleKey and H.settings[toggleKey] and H.activeTheme.active or H.activeTheme.control:Lerp(H.activeTheme.accent, 0.16)
        H.TweenService:Create(button, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = hoverColor}):Play()
        hoverStroke.Transparency = 0.3
    end)
    button.MouseLeave:Connect(function()
        local toggleKey = button:GetAttribute("ToggleSetting")
        local baseColor = (toggleKey and H.settings[toggleKey]) and H.activeTheme.active or H.activeTheme.control
        H.TweenService:Create(button, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = baseColor}):Play()
        hoverStroke.Transparency = 1
    end)
    button:SetAttribute("SearchText", text)
    button.Parent = parent
    local buttonPadding = Instance.new("UIPadding", button)
    buttonPadding.PaddingLeft = UDim.new(0, 12)
    buttonPadding.PaddingRight = UDim.new(0, 10)
    if parent:IsA("ScrollingFrame") and H.pageControls[parent.Name:gsub("^Page_", "")] then
        table.insert(H.pageControls[parent.Name:gsub("^Page_", "")], button)
    end
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    button.Activated:Connect(callback)
    return button
end

