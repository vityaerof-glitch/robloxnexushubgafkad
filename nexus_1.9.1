H.isEnemy = function(player)
    if not player or player == H.LocalPlayer then return false end
    local localTeam = H.getTeam(H.LocalPlayer)
    local targetTeam = H.getTeam(player)
    if localTeam and targetTeam then return localTeam ~= targetTeam end
    if not H.LocalPlayer.Neutral and not player.Neutral then return H.LocalPlayer.TeamColor ~= player.TeamColor end
    -- In teamless test maps, treat other players as potential targets.
    return true
end

H.isVisibleToCamera = function(player, part, camera)
    if not player or not part or not camera then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {H.LocalPlayer.Character}
    params.IgnoreWater = true
    local direction = part.Position - camera.CFrame.Position
    local result = workspace:Raycast(camera.CFrame.Position, direction, params)
    return result == nil or (player.Character and result.Instance:IsDescendantOf(player.Character))
end

H.getScreenBounds = function(character, camera)
    if not character or not camera then return nil end
    local ok, boxCFrame, boxSize = pcall(function() return character:GetBoundingBox() end)
    if not ok or not boxCFrame or not boxSize then return nil end
    local half = boxSize * 0.5
    local points = {}
    for _, x in ipairs({-1, 1}) do
        for _, y in ipairs({-1, 1}) do
            for _, z in ipairs({-1, 1}) do
                local world = boxCFrame:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
                local screen, visible = camera:WorldToViewportPoint(world)
                if visible and screen.Z > 0 then table.insert(points, Vector2.new(screen.X, screen.Y)) end
            end
        end
    end
    if #points < 2 then return nil end
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    for _, point in ipairs(points) do
        minX, minY = math.min(minX, point.X), math.min(minY, point.Y)
        maxX, maxY = math.max(maxX, point.X), math.max(maxY, point.Y)
    end
    if maxX - minX < 2 or maxY - minY < 2 then return nil end
    return minX, minY, maxX - minX, maxY - minY
end

H.refreshVisuals = function()
    for player, data in pairs(H.tracked) do
        local character = player.Character
        local valid = character ~= nil and character.Parent ~= nil
        local enabled = H.settings.ESP and valid
        if data.highlight then
            data.highlight.Enabled = enabled and H.settings.Highlight
            local color = H.playerColor(player)
            data.highlight.FillColor = color
            data.highlight.OutlineColor = color
        end
        if data.infoFrame then
            data.infoFrame.Visible = enabled and (H.settings.Names or H.settings.TeamLabels or H.settings.Health or H.settings.Distance)
            data.nameLabel.Visible = H.settings.Names
            data.teamLabel.Visible = H.settings.TeamLabels
            data.healthLabel.Visible = H.settings.Health
            data.distanceLabel.Visible = H.settings.Distance
            data.healthBarBack.Visible = false -- positioned beside the ESP box in RenderStepped
            data.nameLabel.TextColor3 = H.playerColor(player)
            data.teamLabel.TextColor3 = H.playerColor(player)
        end
        for _, line in ipairs(data.skeletonLines or {}) do
            line.Visible = enabled and H.settings.Skeleton
        end
        if data.lookDirectionFrame then
            data.lookDirectionFrame.Visible = enabled and H.settings.ShowLookDirection
        end
    end
end

H.watchPlayer = function(player)
    if player == H.LocalPlayer or H.playerConnections[player] then return end
    local added = player.CharacterAdded:Connect(function(character)
        task.wait(0.2)
        if player.Parent == H.Players and player.Character == character then
            H.createESP(player)
            H.refreshVisuals()
        end
    end)
    local removing = player.CharacterRemoving:Connect(function()
        H.removeESP(player)
    end)
    H.playerConnections[player] = {added, removing}
    task.spawn(function()
        local ok, isFriend = pcall(function() return H.LocalPlayer:IsFriendsWith(player.UserId) end)
        if ok then H.friendCache[player] = isFriend end
    end)
    if player.Character then task.defer(H.createESP, player) end
end

for _, player in ipairs(H.Players:GetPlayers()) do H.watchPlayer(player) end
H.Players.PlayerAdded:Connect(H.watchPlayer)
H.Players.PlayerRemoving:Connect(function(player)
    H.removeESP(player)
    local connections = H.playerConnections[player]
    if connections then
        for _, connection in ipairs(connections) do connection:Disconnect() end
    end
    H.playerConnections[player] = nil
    H.friendCache[player] = nil
    if H.selectedTarget == player then H.selectedTarget = nil end
    if H.aimTargetPlayer == player then H.aimTargetPlayer = nil end
    if H.spectating and H.selectedTarget == nil then
        local camera = workspace.CurrentCamera
        local humanoid = H.LocalPlayer.Character and H.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if camera then camera.CameraSubject = humanoid end
        H.spectating = false
    end
    if H.targetStatusLabel then H.refreshTargetStatus() end
end)

H.clearFlight = function()
    if H.flyVelocity then H.flyVelocity:Destroy(); H.flyVelocity = nil end
    if H.flyGyro then H.flyGyro:Destroy(); H.flyGyro = nil end
    local character = H.LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if H.oldPlatformStand ~= nil then
            humanoid.PlatformStand = H.oldPlatformStand
        else
            humanoid.PlatformStand = false
        end
        if H.oldAutoRotate ~= nil then
            humanoid.AutoRotate = H.oldAutoRotate
        else
            humanoid.AutoRotate = true
        end
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

H.setupFlight = function()
    local character = H.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return false end
    if H.flyVelocity and H.flyVelocity.Parent == root and H.flyGyro and H.flyGyro.Parent == root then return true end
    H.clearFlight()
    H.oldAutoRotate = humanoid.AutoRotate
    H.oldPlatformStand = humanoid.PlatformStand
    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    H.flyVelocity = Instance.new("BodyVelocity")
    H.flyVelocity.Name = "DevToolsFlyVelocity"
    H.flyVelocity.MaxForce = Vector3.new(1e7, 1e7, 1e7)
    H.flyVelocity.P = 1e5
    H.flyVelocity.Velocity = Vector3.zero
    H.flyVelocity.Parent = root
    H.flyGyro = Instance.new("BodyGyro")
    H.flyGyro.Name = "DevToolsFlyGyro"
    H.flyGyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
    H.flyGyro.P = 1e5
    H.flyGyro.CFrame = workspace.CurrentCamera.CFrame
    H.flyGyro.Parent = root
    return true
end

H.flightDirection = function(camera)
    local direction = Vector3.zero
    if H.UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
    if H.UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
    if H.UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
    if H.UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
    if H.UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
    if H.UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or H.UserInputService:IsKeyDown(Enum.KeyCode.C) then direction -= Vector3.yAxis end
    if direction.Magnitude > 0 then return direction.Unit end
    return Vector3.zero
end

-- Team status updater and event listeners are initialized near the Teams UI above.

H.updateSkeleton = function(player, data, character, camera)
    local myRoot = H.LocalPlayer.Character and H.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetRoot = character and character:FindFirstChild("HumanoidRootPart")
    local inRange = myRoot and targetRoot and (myRoot.Position - targetRoot.Position).Magnitude <= H.settings.MaxESPDistance
    local allowedTeam = not H.settings.OnlyEnemies or H.isEnemy(player)
    local allowedFriend = not H.settings.SkipFriends or H.friendCache[player] ~= true
    local visible = H.settings.ESP and H.settings.Skeleton and character ~= nil and camera ~= nil and inRange and allowedTeam and allowedFriend
    if not visible then
        for _, line in ipairs(data.skeletonLines) do line.Visible = false end
        return
    end
    local color = H.playerColor(player)
    for index, pair in ipairs(H.skeletonPairs) do
        local line = data.skeletonLines[index]
        local partA = character:FindFirstChild(pair[1])
        local partB = character:FindFirstChild(pair[2])
        if partA and partB then
            local a, onA = camera:WorldToViewportPoint(partA.Position)
            local b, onB = camera:WorldToViewportPoint(partB.Position)
            if onA and onB and a.Z > 0 and b.Z > 0 then
                local dx, dy = b.X - a.X, b.Y - a.Y
                local length = math.sqrt(dx * dx + dy * dy)
                line.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
                line.Size = UDim2.fromOffset(math.max(length, 1), 2)
                line.Rotation = math.deg(math.atan2(dy, dx))
                line.BackgroundColor3 = color
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

