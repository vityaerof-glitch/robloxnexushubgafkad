-- Initialize team status immediately after creating the label. This keeps the UI
-- from remaining on its loading placeholder if a later feature fails to initialize.
H.updateTeamStatus = function()
    local ok, result = pcall(function()
        local teamObjects = H.Teams:GetTeams()
        local counts, legacy = {}, {}
        for _, team in ipairs(teamObjects) do
            counts[team.Name] = 0
        end

        for _, player in ipairs(H.Players:GetPlayers()) do
            local team = H.getTeam(player)
            if team then
                counts[team.Name] = (counts[team.Name] or 0) + 1
            elseif player and not player.Neutral then
                local colorName = player.TeamColor and player.TeamColor.Name or "Unknown"
                local key = colorName .. " (TeamColor)"
                legacy[key] = (legacy[key] or 0) + 1
            end
        end

        local lines = {H.tr("Твоя команда: ") .. H.teamName(H.LocalPlayer)}
        local names = {}
        for name in pairs(counts) do table.insert(names, name) end
        for name in pairs(legacy) do table.insert(names, name) end
        table.sort(names)

        if #names == 0 then
            table.insert(lines, H.tr("Команды не назначены — создай объекты Team в сервисе Teams."))
        else
            for _, name in ipairs(names) do
                local count = counts[name] or legacy[name] or 0
                table.insert(lines, name .. ": " .. tostring(count) .. " " .. H.tr("игрок(ов)"))
            end
        end

        local joined = table.concat(lines, "\n")
        if H.status and H.status.Parent then
            H.status.Text = "  " .. joined:gsub("\n", "\n  ")
        end
        if H.teamCountsLabel and H.teamCountsLabel.Parent then
            H.teamCountsLabel.Text = joined
        end
        return joined
    end)

    if not ok then
        warn("[Nexus Hub] Team status update failed: " .. tostring(result))
        local fallback = H.currentLanguage == "RU"
            and "Не удалось прочитать команды. Проверь View → Output."
            or "Couldn't read teams. Check View → Output."
        if H.status and H.status.Parent then H.status.Text = fallback end
        if H.teamCountsLabel and H.teamCountsLabel.Parent then H.teamCountsLabel.Text = fallback end
    end
end

H.teamStatusPlayerConnections = {}
H.watchTeamStatusPlayer = function(player)
    if not player then return end
    local previous = H.teamStatusPlayerConnections[player]
    if previous then
        for _, connection in ipairs(previous) do
            pcall(function() connection:Disconnect() end)
        end
    end
    local connections = {}
    for _, propertyName in ipairs({"Team", "Neutral", "TeamColor"}) do
        table.insert(connections, player:GetPropertyChangedSignal(propertyName):Connect(function()
            task.defer(H.updateTeamStatus)
        end))
    end
    H.teamStatusPlayerConnections[player] = connections
end

for _, existingTeamPlayer in ipairs(H.Players:GetPlayers()) do
    H.watchTeamStatusPlayer(existingTeamPlayer)
end
H.Players.PlayerAdded:Connect(function(player)
    H.watchTeamStatusPlayer(player)
    task.defer(H.updateTeamStatus)
end)
H.Players.PlayerRemoving:Connect(function(player)
    local connections = H.teamStatusPlayerConnections[player]
    if connections then
        for _, connection in ipairs(connections) do
            pcall(function() connection:Disconnect() end)
        end
    end
    H.teamStatusPlayerConnections[player] = nil
    task.defer(H.updateTeamStatus)
end)
H.Teams.ChildAdded:Connect(function()
    task.defer(H.updateTeamStatus)
end)
H.Teams.ChildRemoved:Connect(function()
    task.defer(H.updateTeamStatus)
end)
