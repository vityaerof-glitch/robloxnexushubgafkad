H.configBounds = {
    MaxESPDistance = {100, 5000}, FOVRadius = {60, 1500}, AimStrengthPercent = {5, 100},
    FlySpeed = {20, 500}, WalkSpeed = {16, 150}, JumpPower = {25, 180},
    CrosshairSize = {3, 24}, CameraFOV = {50, 120},
}
H.configMessage = function(text)
    if H.configStatusLabel then H.configStatusLabel.Text = H.tr(text) end
end
H.copySettings = function()
    local copy = {}
    for key, value in pairs(H.settings) do
        if type(value) == "boolean" or type(value) == "number" or type(value) == "string" then copy[key] = value end
    end
    return copy
end
H.applyImportedConfig = function(payload)
    if type(payload) ~= "table" then return false end
    local incoming = type(payload.settings) == "table" and payload.settings or payload
    for key, defaultValue in pairs(H.defaultSettings) do
        local value = incoming[key]
        if value ~= nil and type(value) == type(defaultValue) then
            if key == "AimPart" and value ~= "Head" and value ~= "Torso" then
                -- ignore invalid target-part value
            elseif type(value) == "number" then
                local bounds = H.configBounds[key]
                if bounds then value = math.clamp(value, bounds[1], bounds[2]) end
                H.settings[key] = value
            else
                H.settings[key] = value
            end
        end
    end
    local language = payload.language
    if type(language) == "string" and table.find(H.languageOrder, language) then H.currentLanguage = language end
    if type(payload.themeIndex) == "number" and H.applyTheme then H.applyTheme(payload.themeIndex) end
    if type(payload.guiAccentName) == "string" and H.applyGuiAccentByName then H.applyGuiAccentByName(payload.guiAccentName) end
    if type(payload.espColorName) == "string" and H.applyESPColorByName then H.applyESPColorByName(payload.espColorName) end
    -- Validate imported keybind strings without accepting arbitrary invalid names.
    local allowedMouseBindings = {MouseButton1 = true, MouseButton2 = true, MouseButton3 = true}
    for _, bindSetting in ipairs({"MenuBind", "ServerHopBind", "ESPToggleBind", "AimToggleBind", "FlyToggleBind", "NoclipToggleBind", "BunnyHopToggleBind", "CrosshairToggleBind", "AimHoldBind", "AimThroughWallsToggleBind", "FOVCircleToggleBind", "InfiniteJumpToggleBind", "WalkSpeedBoostToggleBind", "JumpBoostToggleBind", "FullBrightToggleBind", "NoFogToggleBind"}) do
        local importedKey = H.settings[bindSetting]
        local valid = importedKey == "None" or (type(importedKey) == "string" and allowedMouseBindings[importedKey] == true)
        if type(importedKey) == "string" and not valid then
            local ok, item = pcall(function() return Enum.KeyCode[importedKey] end)
            valid = ok and item ~= nil and item ~= Enum.KeyCode.Unknown
        end
        if not valid then H.settings[bindSetting] = H.defaultSettings[bindSetting] end
    end
    -- Keep the two UI toggles in sync, including configs created by older versions.
    H.settings.AimVisibleCheck = not H.settings.AimThroughWalls
    for key, render in pairs(H.toggleRenderers) do pcall(render) end
    for key, setter in pairs(H.sliderSetters) do
        if type(H.settings[key]) == "number" then pcall(setter, H.settings[key]) end
    end
    for _, refresher in ipairs(H.languageRefreshers) do pcall(refresher) end
    H.refreshLanguage()
    H.aimTargetPlayer = nil
    if H.refreshVisuals then H.refreshVisuals() end
    if H.updateTeamStatus then H.updateTeamStatus() end
    if H.targetStatusLabel and H.refreshTargetStatus then H.refreshTargetStatus() end
    return true
end
H.saveConfigAction = function()
    local name = string.gsub(H.configNameBox and H.configNameBox.Text or "", "^%s*(.-)%s*$", "%1")
    if name == "" then H.configMessage("Сначала введи имя конфига."); return end
    H.configPresets[name] = {settings = H.copySettings(), language = H.currentLanguage, themeIndex = H.themeIndex, guiAccentName = H.guiAccentName, espColorName = H.espColorName, schemaVersion = 1}
    H.configMessage("Конфиг сохранён в памяти текущего запуска.")
end
H.loadConfigAction = function()
    local name = string.gsub(H.configNameBox and H.configNameBox.Text or "", "^%s*(.-)%s*$", "%1")
    if name == "" then H.configMessage("Сначала введи имя конфига."); return end
    local profile = H.configPresets[name]
    if not profile then H.configMessage("Конфиг с таким именем не найден."); return end
    if H.applyImportedConfig(profile) then H.configMessage("Конфиг загружен.") end
end
H.deleteConfigAction = function()
    local name = string.gsub(H.configNameBox and H.configNameBox.Text or "", "^%s*(.-)%s*$", "%1")
    if name == "" then H.configMessage("Сначала введи имя конфига."); return end
    if H.configPresets[name] then H.configPresets[name] = nil; H.configMessage("Конфиг удалён.") else H.configMessage("Конфиг с таким именем не найден.") end
end
H.exportConfigAction = function()
    local payload = {schemaVersion = 1, language = H.currentLanguage, themeIndex = H.themeIndex, guiAccentName = H.guiAccentName, espColorName = H.espColorName, settings = H.copySettings()}
    local ok, encoded = pcall(function() return H.HttpService:JSONEncode(payload) end)
    if not ok then H.configMessage("Ошибка JSON: проверь скопированный текст."); return end
    if H.configJsonBox then H.configJsonBox.Text = encoded end
    H.configMessage("JSON готов к копированию. Скопируй текст вручную.")
end
H.importConfigAction = function()
    local raw = H.configJsonBox and H.configJsonBox.Text or ""
    local ok, decoded = pcall(function() return H.HttpService:JSONDecode(raw) end)
    if not ok or type(decoded) ~= "table" or not H.applyImportedConfig(decoded) then
        H.configMessage("Ошибка JSON: проверь скопированный текст.")
        return
    end
    H.configMessage("Конфиг импортирован.")
end

