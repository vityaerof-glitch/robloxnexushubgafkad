        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 16)
    end)
    H.pages[name] = page

    tab.Activated:Connect(function()
        H.currentPageName = name
        H.currentPage = H.pages[name]
