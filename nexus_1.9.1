H.addToggle = function(pageName, key, label)
    local button
    local function render()
        local russianText = label .. ": " .. (H.settings[key] and "ВКЛ" or "ВЫКЛ")
        button:SetAttribute("RUText", russianText)
        button:SetAttribute("SearchText", label)
        button.Text = H.tr(label) .. ": " .. H.tr(H.settings[key] and "ВКЛ" or "ВЫКЛ")
        button.BackgroundColor3 = H.settings[key] and H.activeTheme.active or H.activeTheme.control
    end
    button = H.makeButton(H.pages[pageName], "", function()
        H.settings[key] = not H.settings[key]
        local relatedKey = nil
        if key == "AimThroughWalls" then
            -- A clear ON/OFF mode: through-wall ON bypasses LOS; OFF requires visible targets.
            H.settings.AimVisibleCheck = not H.settings.AimThroughWalls
            relatedKey = "AimVisibleCheck"
        elseif key == "AimVisibleCheck" then
            H.settings.AimThroughWalls = not H.settings.AimVisibleCheck
            relatedKey = "AimThroughWalls"
        end
        render()
        if relatedKey and H.toggleRenderers[relatedKey] then
            H.toggleRenderers[relatedKey]()
        end
        if key == "Fly" and not H.settings.Fly then
            -- Actual flight cleanup is handled in RenderStepped.
        end
    end)
    button:SetAttribute("ToggleSetting", key)
    H.settingsButtons[key] = button
    H.toggleRenderers[key] = render
    H.buttonNames[key] = label
    table.insert(H.languageRefreshers, render)
    render()
end

H.addSlider = function(pageName, label, minimum, maximum, initial, step, onChanged, settingKey)
    local parent = H.pages[pageName]
    local holder = Instance.new("Frame")
    holder:SetAttribute("ThemeRole", "panel")
    holder.Size = UDim2.new(1, -5, 0, 55)
    holder.BackgroundColor3 = H.activeTheme.panel
    holder.BorderSizePixel = 0
    holder.Parent = parent
    holder:SetAttribute("SearchItem", true)
    holder:SetAttribute("SearchText", label)
    if parent:IsA("ScrollingFrame") and H.pageControls[parent.Name:gsub("^Page_", "")] then
        table.insert(H.pageControls[parent.Name:gsub("^Page_", "")], holder)
    end
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)
    local sliderStroke = Instance.new("UIStroke", holder)
    sliderStroke:SetAttribute("ThemeRole", "accentStroke")
    sliderStroke.Color = H.activeTheme.accent
    sliderStroke.Transparency = 0.91
    sliderStroke.Thickness = 1
    local valueLabel = Instance.new("TextLabel")
    valueLabel:SetAttribute("ThemeRole", "text")
    valueLabel.Position = UDim2.fromOffset(9, 2)
    valueLabel.Size = UDim2.new(1, -18, 0, 23)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextColor3 = Color3.fromRGB(235, 240, 248)
    valueLabel.Font = Enum.Font.GothamMedium
    valueLabel.TextSize = 11
    valueLabel.TextXAlignment = Enum.TextXAlignment.Left
    valueLabel.Parent = holder
    local track = Instance.new("TextButton")
    track:SetAttribute("ThemeRole", "sliderTrack")
    track.Position = UDim2.new(0, 9, 0, 32)
    track.Size = UDim2.new(1, -18, 0, 9)
    track.BackgroundColor3 = H.activeTheme.track
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = holder
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame")
    fill:SetAttribute("ThemeRole", "accentFill")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = H.activeTheme.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame")
    knob:SetAttribute("ThemeRole", "sliderKnob")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(245, 250, 255)
    knob.BorderSizePixel = 0
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local value = initial
    local dragging = false
    local function render(nextValue, notify)
        if step and step > 0 then
            nextValue = minimum + math.floor((nextValue - minimum) / step + 0.5) * step
        end
        value = math.clamp(nextValue, minimum, maximum)
        local alpha = (value - minimum) / (maximum - minimum)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        local russianText = label .. ": " .. tostring(value)
        valueLabel:SetAttribute("RUText", russianText)
        valueLabel:SetAttribute("SearchText", label)
        valueLabel.Text = H.tr(label) .. ": " .. tostring(value)
        if notify then onChanged(value) end
    end
    local function setAt(x)
        local width = math.max(track.AbsoluteSize.X, 1)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        render(minimum + alpha * (maximum - minimum), true)
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setAt(input.Position.X)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setAt(input.Position.X)
        end
    end)
    H.UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setAt(input.Position.X)
        end
    end)
    H.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    table.insert(H.languageRefreshers, function() render(value, false) end)
    if settingKey then
        H.sliderSetters[settingKey] = function(nextValue)
            render(nextValue, false)
            onChanged(value)
        end
    end
    table.insert(H.sliderResetters, function()
        render(initial, false)
        onChanged(initial)
    end)
    render(initial, false)
end

