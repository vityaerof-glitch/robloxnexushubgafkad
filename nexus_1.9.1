H.mouseTokenByType = {
    [Enum.UserInputType.MouseButton1] = "MouseButton1",
    [Enum.UserInputType.MouseButton2] = "MouseButton2",
    [Enum.UserInputType.MouseButton3] = "MouseButton3",
}
H.inputToken = function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
        return input.KeyCode.Name
    end
    return H.mouseTokenByType[input.UserInputType]
end
H.keyNameIsValid = function(keyName)
    if keyName == "None" then return true end
    if keyName == "MouseButton1" or keyName == "MouseButton2" or keyName == "MouseButton3" then return true end
    if type(keyName) ~= "string" or #keyName > 40 then return false end
    local ok, item = pcall(function() return Enum.KeyCode[keyName] end)
    return ok and item ~= nil and item ~= Enum.KeyCode.Unknown
end
H.inputMatchesBind = function(input, bindName)
    if not bindName or bindName == "None" then return false end
    return H.inputToken(input) == bindName
end
H.isBindDown = function(bindName)
    if not bindName or bindName == "None" then return false end
    if bindName == "MouseButton1" or bindName == "MouseButton2" or bindName == "MouseButton3" then
        local userInputType = Enum.UserInputType[bindName]
        return userInputType ~= nil and H.UserInputService:IsMouseButtonPressed(userInputType)
    end
    local keyCode = Enum.KeyCode[bindName]
    return keyCode ~= nil and keyCode ~= Enum.KeyCode.Unknown and H.UserInputService:IsKeyDown(keyCode)
end
H.assignBinding = function(settingName, keyName)
    if not H.keyNameIsValid(keyName) then return false end
    if keyName ~= "None" then
        for _, other in ipairs(H.keybindDefinitions) do
            if other.setting ~= settingName and H.settings[other.setting] == keyName then
                H.setBindStatus("Эта клавиша уже назначена другому действию.", "That key is already assigned to another action.")
                return false
            end
        end
    end
    H.settings[settingName] = keyName
    H.refreshKeybindButtons()
    H.setBindStatus(keyName == "None" and "Бинд снят." or ("Клавиша сохранена: " .. H.prettyBindName(keyName)), keyName == "None" and "Binding cleared." or ("Key saved: " .. H.prettyBindName(keyName)))
    return true
end

-- Animated menu transitions: the full dashboard shrinks toward the top-left mini dock.
H.menuAnimating = false
H.menuTargetSize = H.main.Size
H.menuTargetPosition = H.main.Position
H.miniDockCenter = UDim2.fromOffset(47, 47)

H.showOpenButtonAnimated = function()
    if not H.openButton or not H.openButton.Parent then return end
    if H.embeddedLogoCanvas then H.mountEmbeddedLogo(H.openButton, H.openButton.ZIndex + 1) end
    H.openButton.Visible = true
    H.openButton.Position = UDim2.fromOffset(18, 18)
    H.openButton.Size = UDim2.fromOffset(34, 34)
    H.openButton.Rotation = -18
    H.openButton.BackgroundTransparency = 0.20
    H.openButton.TextTransparency = (H.hasNexusLogoAsset or H.embeddedLogoCanvas ~= nil) and 1 or 0
    if H.miniLogoImage then H.miniLogoImage.ImageTransparency = (H.hasNexusLogoAsset or H.embeddedLogoCanvas ~= nil) and 1 or 0 end
    if H.openStroke then H.openStroke.Transparency = 1 end
    local info = TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    H.TweenService:Create(H.openButton, info, {
        Size = UDim2.fromOffset(58, 58),
        Rotation = 0,
        BackgroundTransparency = 0,
        TextTransparency = (H.hasNexusLogoAsset or H.embeddedLogoCanvas ~= nil) and 1 or 0,
    }):Play()
    if H.miniLogoImage and H.hasNexusLogoAsset then
        H.TweenService:Create(H.miniLogoImage, info, {ImageTransparency = 0}):Play()
    end
    if H.openStroke then H.TweenService:Create(H.openStroke, info, {Transparency = 0.12}):Play() end
end

H.openMainAnimated = function()
    if H.menuAnimating or not H.main or H.main.Visible then return end
    local fromMiniDock = H.openButton and H.openButton.Visible
    H.menuAnimating = true
    if H.embeddedLogoCanvas and H.brandMark then H.mountEmbeddedLogo(H.brandMark, H.brandMark.ZIndex + 1) end
    H.openButton.Visible = false
    H.main.Visible = true
    H.main.Size = H.menuTargetSize
    if fromMiniDock then
        H.main.Position = H.miniDockCenter
        H.main.BackgroundTransparency = 0.06
        H.menuScaleValue.Value = 0.055
    else
        -- First opening after the release-notes screen should grow in the center, not from an invisible icon.
        H.main.Position = UDim2.new(H.menuTargetPosition.X.Scale, H.menuTargetPosition.X.Offset, H.menuTargetPosition.Y.Scale, H.menuTargetPosition.Y.Offset + 12)
        H.main.BackgroundTransparency = 0
        H.menuScaleValue.Value = 0.90
    end
    if H.mainStroke then H.mainStroke.Transparency = 1 end
    local info = fromMiniDock
        and TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        or TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local positionInfo = fromMiniDock
        and TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        or TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local scaleTween = H.TweenService:Create(H.menuScaleValue, info, {Value = 1})
    H.TweenService:Create(H.main, positionInfo, {
        Position = H.menuTargetPosition,
        BackgroundTransparency = 0,
    }):Play()
    if H.mainStroke then H.TweenService:Create(H.mainStroke, info, {Transparency = 0.14}):Play() end
    scaleTween.Completed:Connect(function()
        if not H.main or not H.main.Parent then return end
        H.main.Position = H.menuTargetPosition
        H.menuScaleValue.Value = 1
        H.menuAnimating = false
    end)
    scaleTween:Play()
end

H.closeMainAnimated = function()
    if H.menuAnimating or not H.main or not H.main.Visible then return end
    H.menuAnimating = true
    local info = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    local scaleTween = H.TweenService:Create(H.menuScaleValue, info, {Value = 0.055})
    H.TweenService:Create(H.main, info, {
        Position = H.miniDockCenter,
        BackgroundTransparency = 0.18,
    }):Play()
    if H.mainStroke then H.TweenService:Create(H.mainStroke, info, {Transparency = 1}):Play() end
    scaleTween.Completed:Connect(function()
        if not H.main or not H.main.Parent then return end
        H.main.Visible = false
        H.main.Position = H.menuTargetPosition
        H.main.BackgroundTransparency = 0
        H.menuScaleValue.Value = 1
        H.menuAnimating = false
        H.showOpenButtonAnimated()
    end)
    scaleTween:Play()
end

H.toggleMenuAnimated = function()
    if H.menuAnimating then return end
    if H.main.Visible then H.closeMainAnimated() else H.openMainAnimated() end
end

H.closeButton.Activated:Connect(H.closeMainAnimated)
if H.minimizeButton then H.minimizeButton.Activated:Connect(H.closeMainAnimated) end
H.openButton.Activated:Connect(H.openMainAnimated)

-- Drag the menu using its header.
local dragging = false; H.dragStart = nil; H.startPosition = nil; H.dragInput = nil
H.header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        H.dragStart = input.Position
        H.startPosition = H.main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
H.header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then H.dragInput = input end
end)
H.UserInputService.InputChanged:Connect(function(input)
    if dragging and input == H.dragInput then
        local delta = input.Position - H.dragStart
        H.main.Position = UDim2.new(H.startPosition.X.Scale, H.startPosition.X.Offset + delta.X, H.startPosition.Y.Scale, H.startPosition.Y.Offset + delta.Y)
        H.menuTargetPosition = H.main.Position
    end
end)
H.UserInputService.InputBegan:Connect(function(input, gameProcessed)
    local token = H.inputToken(input)
    if not token then return end

    -- When rebinding, capture the next keyboard key or mouse button before normal actions.
    if H.waitingForBindSetting then
        local settingName = H.waitingForBindSetting
        H.waitingForBindSetting = nil
        if token == "Escape" then
            H.setBindStatus("Назначение отменено.", "Binding cancelled.")
            H.refreshKeybindButtons()
            return
        elseif token == "Backspace" then
            H.assignBinding(settingName, "None")
            return
        else
            if not H.assignBinding(settingName, token) then
                H.waitingForBindSetting = settingName
                H.refreshKeybindButtons()
            end
            return
        end
    end

    if input.UserInputType == Enum.UserInputType.Keyboard and H.UserInputService:GetFocusedTextBox() then return end

    -- The menu bind works even if Roblox marks the event as processed.
    if H.settings.MenuBind ~= "None" and token == H.settings.MenuBind then
        H.toggleMenuAnimated()
        return
    end

    -- Run configured toggle actions. AimHoldBind is a hold-to-aim trigger, not a toggle.
    for _, definition in ipairs(H.keybindDefinitions) do
        if definition.action ~= "menu" and definition.action ~= "aimhold"
            and H.settings[definition.setting] ~= "None" and token == H.settings[definition.setting] then
            local action = definition.action
            if action == "serverhop" then
                H.sendServerHopRequest("hop")
            elseif action == "esp" then
                H.settings.ESP = not H.settings.ESP
                if H.toggleRenderers.ESP then H.toggleRenderers.ESP() end
            elseif action == "aim" then
                H.settings.AimAssist = not H.settings.AimAssist
                if H.toggleRenderers.AimAssist then H.toggleRenderers.AimAssist() end
            elseif action == "fly" then
                H.settings.Fly = not H.settings.Fly
                if H.toggleRenderers.Fly then H.toggleRenderers.Fly() end
                if not H.settings.Fly and H.clearFlight then H.clearFlight() end
            elseif action == "noclip" then
                H.settings.Noclip = not H.settings.Noclip
                if H.toggleRenderers.Noclip then H.toggleRenderers.Noclip() end
            elseif action == "bhop" then
                H.settings.BunnyHop = not H.settings.BunnyHop
                if H.toggleRenderers.BunnyHop then H.toggleRenderers.BunnyHop() end
            elseif action == "crosshair" then
                H.settings.Crosshair = not H.settings.Crosshair
                if H.toggleRenderers.Crosshair then H.toggleRenderers.Crosshair() end
            elseif action == "aimthroughwalls" then
                H.settings.AimThroughWalls = not H.settings.AimThroughWalls
                H.settings.AimVisibleCheck = not H.settings.AimThroughWalls
                if H.toggleRenderers.AimThroughWalls then H.toggleRenderers.AimThroughWalls() end
                if H.toggleRenderers.AimVisibleCheck then H.toggleRenderers.AimVisibleCheck() end
            elseif action == "fovcircle" then
                H.settings.AimCircle = not H.settings.AimCircle
                if H.toggleRenderers.AimCircle then H.toggleRenderers.AimCircle() end
            elseif action == "infinitejump" then
                H.settings.InfiniteJump = not H.settings.InfiniteJump
                if H.toggleRenderers.InfiniteJump then H.toggleRenderers.InfiniteJump() end
            elseif action == "walkspeed" then
                H.settings.WalkSpeedBoost = not H.settings.WalkSpeedBoost
                if H.toggleRenderers.WalkSpeedBoost then H.toggleRenderers.WalkSpeedBoost() end
            elseif action == "jumpboost" then
                H.settings.JumpBoost = not H.settings.JumpBoost
                if H.toggleRenderers.JumpBoost then H.toggleRenderers.JumpBoost() end
            elseif action == "fullbright" then
                H.settings.FullBright = not H.settings.FullBright
                if H.toggleRenderers.FullBright then H.toggleRenderers.FullBright() end
            elseif action == "nofog" then
                H.settings.NoFog = not H.settings.NoFog
                if H.toggleRenderers.NoFog then H.toggleRenderers.NoFog() end
            end
            break
        end
    end
end)

H.LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if H.settings.Fly then H.clearFlight() end
end)

H.worldState = {
    fullBrightApplied = false,
    noFogApplied = false,
    nightApplied = false,
    savedFullBright = nil,
    savedFog = nil,
    savedClockTime = nil,
    lowGraphicsApplied = false,
    savedLowGraphics = {},
}

H.setLowGraphicsObject = function(object)
    if not object then return end
    local hasEnabled = object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
        or object:IsA("Fire") or object:IsA("Smoke") or object:IsA("Sparkles") or object:IsA("PostEffect")
    if not hasEnabled then return end
    if H.worldState.savedLowGraphics[object] == nil then
        H.worldState.savedLowGraphics[object] = object.Enabled
    end
    object.Enabled = false
end

H.applyLowGraphicsSetting = function()
    if H.settings.LowGraphics and not H.worldState.lowGraphicsApplied then
        H.worldState.lowGraphicsApplied = true
        for _, root in ipairs({workspace, H.Lighting}) do
            for _, object in ipairs(root:GetDescendants()) do H.setLowGraphicsObject(object) end
        end
    elseif not H.settings.LowGraphics and H.worldState.lowGraphicsApplied then
        for object, wasEnabled in pairs(H.worldState.savedLowGraphics) do
            if object and object.Parent then pcall(function() object.Enabled = wasEnabled end) end
        end
        table.clear(H.worldState.savedLowGraphics)
        H.worldState.lowGraphicsApplied = false
    end
end
workspace.DescendantAdded:Connect(function(object)
    if H.settings.LowGraphics and H.worldState.lowGraphicsApplied then H.setLowGraphicsObject(object) end
end)
H.Lighting.DescendantAdded:Connect(function(object)
    if H.settings.LowGraphics and H.worldState.lowGraphicsApplied then H.setLowGraphicsObject(object) end
end)

H.applyWorldSettings = function()
    H.applyLowGraphicsSetting()
    if H.settings.FullBright then
        if not H.worldState.fullBrightApplied then
            H.worldState.savedFullBright = {
                Ambient = H.Lighting.Ambient,
                OutdoorAmbient = H.Lighting.OutdoorAmbient,
                Brightness = H.Lighting.Brightness,
                ExposureCompensation = H.Lighting.ExposureCompensation,
            }
            H.worldState.fullBrightApplied = true
        end
        H.Lighting.Ambient = Color3.fromRGB(190, 190, 190)
        H.Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
        H.Lighting.Brightness = 3
        H.Lighting.ExposureCompensation = 0.25
    elseif H.worldState.fullBrightApplied then
        local saved = H.worldState.savedFullBright or H.originalLighting
        H.Lighting.Ambient = saved.Ambient
        H.Lighting.OutdoorAmbient = saved.OutdoorAmbient
        H.Lighting.Brightness = saved.Brightness
        H.Lighting.ExposureCompensation = saved.ExposureCompensation
        H.worldState.fullBrightApplied = false
        H.worldState.savedFullBright = nil
    end

    if H.settings.NoFog then
        if not H.worldState.noFogApplied then
            H.worldState.savedFog = {FogStart = H.Lighting.FogStart, FogEnd = H.Lighting.FogEnd}
            H.worldState.noFogApplied = true
        end
        H.Lighting.FogStart = 0
        H.Lighting.FogEnd = 1000000
    elseif H.worldState.noFogApplied then
        local saved = H.worldState.savedFog or H.originalLighting
        H.Lighting.FogStart = saved.FogStart
        H.Lighting.FogEnd = saved.FogEnd
        H.worldState.noFogApplied = false
        H.worldState.savedFog = nil
    end

    if H.settings.NightMode then
        if not H.worldState.nightApplied then
            H.worldState.savedClockTime = H.Lighting.ClockTime
            H.worldState.nightApplied = true
        end
        H.Lighting.ClockTime = 0
    elseif H.worldState.nightApplied then
        H.Lighting.ClockTime = H.worldState.savedClockTime or H.originalLighting.ClockTime
        H.worldState.nightApplied = false
        H.worldState.savedClockTime = nil
    end
end

H.restoreMovementOverrides = function(humanoid)
    if humanoid then
        if H.oldWalkSpeed ~= nil then humanoid.WalkSpeed = H.oldWalkSpeed end
        if H.oldJumpPower ~= nil and H.oldUseJumpPower ~= nil then
            humanoid.UseJumpPower = H.oldUseJumpPower
            humanoid.JumpPower = H.oldJumpPower
            if H.oldJumpHeight ~= nil then humanoid.JumpHeight = H.oldJumpHeight end
        end
    end
    H.oldWalkSpeed, H.oldJumpPower, H.oldJumpHeight, H.oldUseJumpPower = nil, nil, nil, nil
    for part, canCollide in pairs(H.savedCollision) do
        if part and part.Parent then pcall(function() part.CanCollide = canCollide end) end
    end
    table.clear(H.savedCollision)
    H.noclipCharacter = nil
end

H.applyMovementSettings = function()
    local character = H.LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if H.settings.WalkSpeedBoost then
            if H.oldWalkSpeed == nil then H.oldWalkSpeed = humanoid.WalkSpeed end
            humanoid.WalkSpeed = H.settings.WalkSpeed
        elseif H.oldWalkSpeed ~= nil then
            humanoid.WalkSpeed = H.oldWalkSpeed
            H.oldWalkSpeed = nil
        end
        if H.settings.JumpBoost then
            if H.oldJumpPower == nil then
                H.oldJumpPower = humanoid.JumpPower
                H.oldJumpHeight = humanoid.JumpHeight
                H.oldUseJumpPower = humanoid.UseJumpPower
            end
            if humanoid.UseJumpPower then humanoid.JumpPower = H.settings.JumpPower
            else humanoid.JumpHeight = math.max(7, H.settings.JumpPower / 7) end
        elseif H.oldJumpPower ~= nil then
            humanoid.UseJumpPower = H.oldUseJumpPower
            humanoid.JumpPower = H.oldJumpPower
            if H.oldJumpHeight ~= nil then humanoid.JumpHeight = H.oldJumpHeight end
            H.oldWalkSpeed = H.oldWalkSpeed
            H.oldJumpPower, H.oldJumpHeight, H.oldUseJumpPower = nil, nil, nil
        end
    end
    if H.settings.Noclip and character then
        if H.noclipCharacter ~= character then
            for part, canCollide in pairs(H.savedCollision) do
                if part and part.Parent then pcall(function() part.CanCollide = canCollide end) end
            end
            table.clear(H.savedCollision)
            H.noclipCharacter = character
        end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if H.savedCollision[part] == nil then H.savedCollision[part] = part.CanCollide end
                part.CanCollide = false
            end
        end
    elseif next(H.savedCollision) ~= nil then
        for part, canCollide in pairs(H.savedCollision) do
            if part and part.Parent then pcall(function() part.CanCollide = canCollide end) end
        end
        table.clear(H.savedCollision)
        H.noclipCharacter = nil
    end
end

H.applyCameraSettings = function(camera)
    if not camera then return end
    if H.settings.CustomCameraFOV then
        if not H.cameraFOVWasApplied then H.oldCameraFOV = camera.FieldOfView end
        camera.FieldOfView = H.settings.CameraFOV
        H.cameraFOVWasApplied = true
    elseif H.cameraFOVWasApplied then
        if H.oldCameraFOV then camera.FieldOfView = H.oldCameraFOV end
        H.cameraFOVWasApplied = false
        H.oldCameraFOV = nil
    end
end

H.createSpawnMarker = function(spawnLocation)
    if not spawnLocation or not spawnLocation:IsA("SpawnLocation") or H.spawnMarkerObjects[spawnLocation] then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DevToolsSpawnMarker"
    billboard.Adornee = spawnLocation
    billboard.Size = UDim2.fromOffset(150, 28)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 5000
    billboard.Parent = H.PlayerGui
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundColor3 = H.activeTheme.background
    label.BackgroundTransparency = 0.12
    label.BorderSizePixel = 0
    label.Text = "SPAWN • " .. spawnLocation.Name
    label.TextColor3 = H.activeTheme.accent
    label.TextStrokeTransparency = 0.7
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.Parent = billboard
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 5)
    local stroke = Instance.new("UIStroke", label)
    stroke.Color = H.activeTheme.accent
    stroke.Transparency = 0.2
    H.spawnMarkerObjects[spawnLocation] = billboard
end

H.updateSpawnMarkers = function()
    if H.settings.ShowSpawnMarkers and not H.spawnMarkersApplied then
        H.spawnMarkersApplied = true
        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("SpawnLocation") then H.createSpawnMarker(object) end
        end
    elseif not H.settings.ShowSpawnMarkers and H.spawnMarkersApplied then
        for object, billboard in pairs(H.spawnMarkerObjects) do
            if billboard then billboard:Destroy() end
            H.spawnMarkerObjects[object] = nil
        end
        H.spawnMarkersApplied = false
    end
    for object, billboard in pairs(H.spawnMarkerObjects) do
        if not object or not object.Parent then
            if billboard then billboard:Destroy() end
            H.spawnMarkerObjects[object] = nil
        elseif billboard then
            local character = H.LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            billboard.Enabled = H.settings.ShowSpawnMarkers and (not root or (object.Position - root.Position).Magnitude <= H.settings.MaxESPDistance)
        end
    end
end
workspace.DescendantAdded:Connect(function(object)
    if H.settings.ShowSpawnMarkers and H.spawnMarkersApplied and object:IsA("SpawnLocation") then task.defer(H.createSpawnMarker, object) end
end)

H.setLoadingProgress(0.90, "Запуск обновлений и горячих клавиш...")
H.RunService.RenderStepped:Connect(function(deltaTime)
    local camera = workspace.CurrentCamera
    local myCharacter = H.LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")

    H.applyMovementSettings()
    H.applyWorldSettings()
    H.applyCameraSettings(camera)
    H.updateCrosshair(camera)

    if H.settings.BunnyHop and not H.settings.Fly and myHumanoid and myHumanoid.Health > 0
        and H.UserInputService:IsKeyDown(Enum.KeyCode.Space)
        and myHumanoid.FloorMaterial ~= Enum.Material.Air then
        myHumanoid.Jump = true
    end

    if H.settings.Fly then
        if H.setupFlight() and H.flyVelocity and H.flyGyro and camera then
            H.flyVelocity.Velocity = H.flightDirection(camera) * H.settings.FlySpeed
            H.flyGyro.CFrame = camera.CFrame
        end
    elseif H.flyVelocity or H.flyGyro then
        H.clearFlight()
    end

    for player, data in pairs(H.tracked) do
        local character = player.Character
        if character and data.character ~= character then
            task.defer(function()
                if player.Parent == H.Players and player.Character == character then
                    H.createESP(player)
                end
            end)
            continue
        end
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local valid = character ~= nil and root ~= nil
        local distanceFromMe = (myRoot and root) and (myRoot.Position - root.Position).Magnitude or math.huge
        local withinRange = distanceFromMe <= H.settings.MaxESPDistance
        local allowedByTeam = not H.settings.OnlyEnemies or H.isEnemy(player)
        local allowedByFriend = not H.settings.SkipFriends or H.friendCache[player] ~= true
        local showPlayer = H.settings.ESP and valid and withinRange and allowedByTeam and allowedByFriend
        if data.infoFrame and data.infoFrame.Parent then
            local anyInfoEnabled = H.settings.Names or H.settings.TeamLabels or H.settings.Health or H.settings.Distance
            local screenPart = character and character:FindFirstChild("Head")
            local screenPoint, onScreen = nil, false
            if camera and screenPart then
                screenPoint, onScreen = camera:WorldToViewportPoint(screenPart.Position)
            end
            -- Fall back to the root when the head is above/outside the viewport.
            if camera and root and (not screenPoint or not onScreen or screenPoint.Z <= 0) then
                screenPart = root
                screenPoint, onScreen = camera:WorldToViewportPoint(root.Position)
            end
            local inFront = screenPoint ~= nil and screenPoint.Z > 0
            data.infoFrame.Visible = showPlayer and anyInfoEnabled and camera ~= nil and screenPart ~= nil and onScreen and inFront
            if data.infoFrame.Visible then
                data.infoFrame.Position = UDim2.fromOffset(screenPoint.X, math.max(86, screenPoint.Y - 8))
            end
            data.nameLabel.Visible = H.settings.Names
            data.teamLabel.Visible = H.settings.TeamLabels
            data.healthLabel.Visible = H.settings.Health
            data.distanceLabel.Visible = H.settings.Distance
            data.healthBarBack.Visible = false -- updated beside the ESP box below
            data.nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
            data.nameLabel.TextColor3 = H.playerColor(player)
            data.teamLabel.Text = (H.sameTeam(player, H.LocalPlayer) and H.tr("СОЮЗНИК: ") or H.tr("КОМАНДА: ")) .. H.teamName(player)
            data.teamLabel.TextColor3 = H.playerColor(player)
            if humanoid then
                local maxHealth = math.max(humanoid.MaxHealth, 1)
                local health = math.clamp(humanoid.Health, 0, maxHealth)
                local ratio = math.clamp(health / maxHealth, 0, 1)
                data.healthLabel.Text = string.format("HP: %d / %d", math.floor(health + 0.5), math.floor(maxHealth + 0.5))
                data.healthFill.Size = UDim2.new(1, 0, ratio, 0)
                data.healthFill.BackgroundColor3 = Color3.new(1 - ratio, math.max(ratio, 0.12), 0.08)
            else
                data.healthLabel.Text = "HP: --"
                data.healthFill.Size = UDim2.new(1, 0, 0, 0)
            end
            if myRoot and root then
                data.distanceLabel.Text = string.format("%s: %d studs", H.tr("Дистанция"), math.floor((myRoot.Position - root.Position).Magnitude + 0.5))
            else
                data.distanceLabel.Text = H.tr("Дистанция: --")
            end
        end
        if data.highlight then
            data.highlight.Enabled = showPlayer and H.settings.Highlight
            data.highlight.FillColor = H.playerColor(player)
            data.highlight.OutlineColor = H.playerColor(player)
        end
        local boxX, boxY, boxWidth, boxHeight
        if showPlayer and camera and (H.settings.Boxes or (H.settings.Health and H.settings.VerticalHealthBar)) then
            boxX, boxY, boxWidth, boxHeight = H.getScreenBounds(character, camera)
        end
        if data.boxFrame then
            data.boxFrame.Visible = showPlayer and H.settings.Boxes and boxX ~= nil
            data.boxStroke.Color = H.playerColor(player)
            if showPlayer and H.settings.Boxes and boxX then
                data.boxFrame.Position = UDim2.fromOffset(boxX, boxY)
                data.boxFrame.Size = UDim2.fromOffset(boxWidth, boxHeight)
                data.boxFrame.Visible = true
            else
                data.boxFrame.Visible = false
            end
        end
        if data.healthBarBack then
            local barOn = showPlayer and H.settings.Health and H.settings.VerticalHealthBar and humanoid ~= nil and boxX ~= nil and boxHeight ~= nil
            data.healthBarBack.Visible = barOn
            if barOn then
                data.healthBarBack.Position = UDim2.fromOffset(boxX - 5, boxY)
                data.healthBarBack.Size = UDim2.fromOffset(4, math.max(8, boxHeight))
                data.healthFill.Size = UDim2.new(1, 0, math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1), 0)
                local healthRatio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                data.healthFill.BackgroundColor3 = Color3.new(1 - healthRatio, math.max(healthRatio, 0.12), 0.06)
            end
        end
        if data.tracerFrame then
            data.tracerFrame.Visible = showPlayer and H.settings.Tracers
            data.tracerFrame.BackgroundColor3 = H.playerColor(player)
            if showPlayer and H.settings.Tracers and camera and root then
                local point, onScreen = camera:WorldToViewportPoint(root.Position)
                if onScreen and point.Z > 0 then
                    local viewport = camera.ViewportSize
                    local x0, y0 = viewport.X * 0.5, viewport.Y
                    local x1, y1 = point.X, point.Y
                    local dx, dy = x1 - x0, y1 - y0
                    data.tracerFrame.Position = UDim2.fromOffset((x0 + x1) * 0.5, (y0 + y1) * 0.5)
                    data.tracerFrame.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.5)
                    data.tracerFrame.Rotation = math.deg(math.atan2(dy, dx))
                    data.tracerFrame.Visible = true
                else
                    data.tracerFrame.Visible = false
                end
            end
        end
        if data.lookDirectionFrame then
            local lookLine = data.lookDirectionFrame
            local head = character and character:FindFirstChild("Head")
            local shouldDrawLook = showPlayer and H.settings.ShowLookDirection and camera ~= nil and head ~= nil
            if shouldDrawLook then
                local lengthStuds = math.clamp(tonumber(H.settings.LookDirectionLength) or 18, 5, 80)
                local startPoint, startOnScreen = camera:WorldToViewportPoint(head.Position)
                local endWorld = head.Position + head.CFrame.LookVector * lengthStuds
                local endPoint, endOnScreen = camera:WorldToViewportPoint(endWorld)
                if startOnScreen and endOnScreen and startPoint.Z > 0 and endPoint.Z > 0 then
                    local dx, dy = endPoint.X - startPoint.X, endPoint.Y - startPoint.Y
                    local lengthPixels = math.sqrt(dx * dx + dy * dy)
                    lookLine.Position = UDim2.fromOffset((startPoint.X + endPoint.X) * 0.5, (startPoint.Y + endPoint.Y) * 0.5)
                    lookLine.Size = UDim2.fromOffset(math.max(1, lengthPixels), 2)
                    lookLine.Rotation = math.deg(math.atan2(dy, dx))
                    lookLine.BackgroundColor3 = H.playerColor(player)
                    lookLine.Visible = lengthPixels >= 2
                else
                    lookLine.Visible = false
                end
            else
                lookLine.Visible = false
            end
        end
        H.updateSkeleton(player, data, character, camera)
    end

    -- The RAGE line diagnoses visibility only; wall penetration is not implemented in this client script.
    if H.wallRayFrame then
        H.wallRayFrame.Visible = false
        if H.settings.ShowShotRayDebug and camera then
            local targetPlayer = H.selectedTarget
            local targetCharacter = targetPlayer and targetPlayer.Character
            local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
            local targetPart = targetCharacter and (targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart"))
            if targetPlayer and targetPlayer ~= H.LocalPlayer and targetPlayer.Parent == H.Players and targetHumanoid and targetHumanoid.Health > 0 and targetPart then
                local viewport = camera.ViewportSize
                local targetPoint, targetOnScreen = camera:WorldToViewportPoint(targetPart.Position)
                if targetOnScreen and targetPoint.Z > 0 then
                    local x0, y0 = viewport.X * 0.5, viewport.Y * 0.5
                    local x1, y1 = targetPoint.X, targetPoint.Y
                    local dx, dy = x1 - x0, y1 - y0
                    H.wallRayFrame.Position = UDim2.fromOffset((x0 + x1) * 0.5, (y0 + y1) * 0.5)
                    H.wallRayFrame.Size = UDim2.fromOffset(math.max(1, math.sqrt(dx * dx + dy * dy)), 2)
                    H.wallRayFrame.Rotation = math.deg(math.atan2(dy, dx))
                    local rayClear = H.isVisibleToCamera(targetPlayer, targetPart, camera)
                    H.wallRayFrame.BackgroundColor3 = rayClear and Color3.fromRGB(70, 230, 130) or Color3.fromRGB(255, 70, 95)
                    H.wallRayFrame.Visible = true
                    H.wallRayElapsed += deltaTime
                    if H.wallRayElapsed >= 0.2 and H.wallRayStatus then
                        H.wallRayElapsed = 0
                        local statusRU = rayClear and ("ЛУЧ СВОБОДЕН: " .. targetPlayer.Name) or ("ПРЕПЯТСТВИЕ: " .. targetPlayer.Name)
                        local statusEN = rayClear and ("RAY CLEAR: " .. targetPlayer.Name) or ("OBSTRUCTED: " .. targetPlayer.Name)
                        H.wallRayStatus.Text = H.currentLanguage == "RU" and statusRU or statusEN
                    end
                elseif H.wallRayStatus then
                    H.wallRayStatus.Text = H.currentLanguage == "RU" and "Цель вне экрана." or "Target is off screen."
                end
            elseif H.wallRayStatus then
                H.wallRayStatus.Text = H.currentLanguage == "RU" and "Выбери живого игрока во вкладке Игроки." or "Select a living player in Players."
            end
        end
    end

    H.fovCircle.Visible = H.settings.AimCircle
    if camera then
        local fovViewport = camera.ViewportSize
        local fovCenterX, fovCenterY = fovViewport.X * 0.5, fovViewport.Y * 0.5
        -- Align the circle with the exact center used by WorldToViewportPoint in target selection.
        H.fovCircle.Position = UDim2.fromOffset(fovCenterX, fovCenterY)
        if H.fovRadiusHud then
            H.fovRadiusHud.Visible = H.settings.AimCircle
            H.fovRadiusHud.Text = "FOV: " .. tostring(math.floor(H.settings.FOVRadius + 0.5)) .. " px"
            H.fovRadiusHud.Position = UDim2.fromOffset(fovCenterX, math.max(14, fovCenterY - H.settings.FOVRadius - 18))
            H.fovRadiusHud.TextColor3 = H.activeTheme.accent
        end
    end
    H.fovCircle.Size = UDim2.fromOffset(H.settings.FOVRadius * 2, H.settings.FOVRadius * 2)
    H.fovStroke.Color = H.settings.AimAssist and Color3.fromRGB(255, 185, 70) or H.mainStroke.Color
    for _, segment in ipairs(H.crosshairSegments or {}) do segment.Visible = H.settings.Crosshair end
    if H.fpsLabel then H.fpsLabel.Visible = H.settings.ShowFPS end
    if H.runtimeMetricsLabel then H.runtimeMetricsLabel.Visible = H.settings.ShowPing or H.settings.ShowMemory or H.settings.ShowPlayerCount end
    if H.coordinatesHud then H.coordinatesHud.Visible = H.settings.ShowCoordinates end
    if H.fpsLabel then
        H.fpsFrameCount += 1
        H.fpsElapsed += deltaTime
        if H.fpsElapsed >= 0.25 then
            local fps = math.floor(H.fpsFrameCount / math.max(H.fpsElapsed, 0.001) + 0.5)
            H.fpsLabel.Text = "FPS: " .. tostring(fps)
            H.fpsFrameCount, H.fpsElapsed = 0, 0
        end
    end
    H.dashboardRefreshElapsed += deltaTime
    if H.dashboardRefreshElapsed >= 0.5 then
        H.dashboardRefreshElapsed = 0
        local localRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        local healthText = myHumanoid and (tostring(math.floor(myHumanoid.Health + 0.5)) .. "/" .. tostring(math.floor(myHumanoid.MaxHealth + 0.5))) or "--"
        if H.coordinatesHud then
            if localRoot then
                local p = localRoot.Position
                H.coordinatesHud.Text = string.format("XYZ %.1f, %.1f, %.1f  |  V %.1f  |  HP %s", p.X, p.Y, p.Z, localRoot.AssemblyLinearVelocity.Magnitude, healthText)
            else
                H.coordinatesHud.Text = "XYZ: -- | VEL: -- | HP: --"
            end
        end
        if H.runtimeMetricsLabel then
            local fields = {}
            if H.settings.ShowPing then
                local pingText = "--"
                local ok, value = pcall(function() return H.LocalPlayer:GetNetworkPing() end)
                if ok and type(value) == "number" then pingText = tostring(math.floor(value * 1000 + 0.5)) .. " ms" end
                table.insert(fields, "PING " .. pingText)
            end
            if H.settings.ShowMemory then
                local memoryText = "--"
                local ok, value = pcall(function() return H.Stats:GetTotalMemoryUsageMb() end)
                if ok and type(value) == "number" then memoryText = string.format("%.0f MB", value) end
                table.insert(fields, "MEM " .. memoryText)
            end
            if H.settings.ShowPlayerCount then table.insert(fields, "PLAYERS " .. tostring(#H.Players:GetPlayers())) end
            H.runtimeMetricsLabel.Text = table.concat(fields, "  •  ")
            H.runtimeMetricsLabel.Size = UDim2.fromOffset(math.clamp(110 + #H.runtimeMetricsLabel.Text * 4.4, 180, 330), 22)
        end
        if H.dashboardStatusLabel then
            local uptime = math.floor(os.clock() - H.scriptStartedAt)
            local targetName = H.selectedTarget and H.selectedTarget.Parent == H.Players and H.selectedTarget.Name or (H.currentLanguage == "RU" and "не выбран" or "none")
            if H.currentLanguage == "RU" then
                H.dashboardStatusLabel.Text = string.format("PlaceId: %s  |  Игроки: %d  |  Время: %02d:%02d\nВыбранная цель: %s  |  HP: %s", tostring(game.PlaceId), #H.Players:GetPlayers(), math.floor(uptime / 60), uptime % 60, targetName, healthText)
            else
                H.dashboardStatusLabel.Text = string.format("PlaceId: %s  |  Players: %d  |  Uptime: %02d:%02d\nSelected target: %s  |  HP: %s", tostring(game.PlaceId), #H.Players:GetPlayers(), math.floor(uptime / 60), uptime % 60, targetName, healthText)
            end
        end
    end
    H.updateSpawnMarkers()

    -- Aim assist runs below at Camera priority + 1 so the default camera does not overwrite it.

    if H.selectedTarget and os.clock() - H.lastTargetRefresh > 0.5 then
        H.lastTargetRefresh = os.clock()
        H.refreshTargetStatus()
    end
    if os.clock() - H.lastTeamRefresh > 1 then
        H.lastTeamRefresh = os.clock()
        H.updateTeamStatus()
    end
end)

-- Rebuild visuals when settings change. Toggle callbacks only mutate local settings;
-- per-frame updater applies their effect. Refresh here for immediate button feedback.
for _, button in pairs(H.settingsButtons) do
    button.Activated:Connect(function()
        task.defer(function()
            if H.settings.Fly and not H.flyVelocity then
                -- Flight will attach on the next RenderStepped once the character is ready.
            elseif not H.settings.Fly and (H.flyVelocity or H.flyGyro) then
                H.clearFlight()
            end
        end)
    end)
end

-- Infinite jump is a client-side test convenience; secure movement with server validation if needed.
H.UserInputService.JumpRequest:Connect(function()
    if not H.settings.InfiniteJump or H.settings.Fly then return end
    local character = H.LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health > 0 then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

H.getAimPart = function(player)
    local character = player and player.Character
    if not character then return nil end
    if H.settings.AimPart == "Torso" then
        return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    end
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

H.validAimTarget = function(player, camera, center)
    if not player or player == H.LocalPlayer or player.Parent ~= H.Players then return nil end
    if H.settings.AimTeamCheck and not H.isEnemy(player) then return nil end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local part = H.getAimPart(player)
    if not humanoid or humanoid.Health <= 0 or not part then return nil end
    local point, onScreen = camera:WorldToViewportPoint(part.Position)
    if not onScreen or point.Z <= 0 then return nil end
    local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
    if distance > H.settings.FOVRadius then return nil end
    if not H.settings.AimThroughWalls and H.settings.AimVisibleCheck and not H.isVisibleToCamera(player, part, camera) then return nil end
    return part, distance
end

-- Bind after Roblox's default camera controller. This makes aim response reliable in the default camera.
pcall(function() H.RunService:UnbindFromRenderStep("DevToolsAimAssist") end)
H.setAimStatus = function(ruText, enText)
    if H.aimStatusLabel then
        H.aimStatusLabel.Text = H.currentLanguage == "RU" and ruText or enText
    end
end
H.RunService:BindToRenderStep("DevToolsAimAssist", Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
    local camera = workspace.CurrentCamera
    local holdingAim = H.settings.AimAssist and H.isBindDown(H.settings.AimHoldBind)
    if not holdingAim or not camera then
        -- Lock only applies while the configured hold bind is down; no stale target persists after release.
        H.aimTargetPlayer = nil
        if not H.settings.AimAssist then
            H.setAimStatus("Аим выключен. Включи помощь и удерживай назначенный бинд.", "Aim assist is off. Enable it and hold the configured aim bind.")
        else
            H.setAimStatus("Аим включён — удерживай назначенный бинд.", "Aim assist enabled — hold the configured aim bind.")
        end
        return
    end

    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    local chosenPart, chosenPlayer
    local chosenDistance = math.huge

    -- Keep a valid target while the button is held, if lock is enabled.
    if H.settings.AimLock and H.aimTargetPlayer then
        local part, screenDistance = H.validAimTarget(H.aimTargetPlayer, camera, center)
        if part then
            chosenPart, chosenPlayer, chosenDistance = part, H.aimTargetPlayer, screenDistance
        else
            H.aimTargetPlayer = nil
        end
    end

    -- Acquire the closest valid target to the screen center if we don't hold a valid lock.
    if not chosenPart then
        local bestScore = H.settings.FOVRadius
        for _, player in ipairs(H.Players:GetPlayers()) do
            local part, screenDistance = H.validAimTarget(player, camera, center)
            if part and screenDistance < bestScore then
                bestScore = screenDistance
                chosenDistance = screenDistance
                chosenPart = part
                chosenPlayer = player
            end
        end
        H.aimTargetPlayer = chosenPlayer
    end

    if not chosenPart or not chosenPlayer then
        H.setAimStatus("Цель не найдена внутри FOV.", "No target found inside FOV.")
        if not H.settings.AimLock then H.aimTargetPlayer = nil end
        return
    end

    local predictionMs = math.clamp(tonumber(H.settings.AimPredictionMs) or 0, 0, 250)
    local targetVelocity = chosenPart.AssemblyLinearVelocity
    local targetCharacter = chosenPlayer.Character
    local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
    if targetRoot and targetRoot:IsA("BasePart") then
        targetVelocity = targetRoot.AssemblyLinearVelocity
    end
    local predictedPosition = chosenPart.Position + targetVelocity * (predictionMs / 1000)
    local goal = CFrame.lookAt(camera.CFrame.Position, predictedPosition)

    -- Speed is perceptually mapped: low values remain smooth; medium and high values are much more responsive.
    local speed = math.clamp(H.settings.AimStrengthPercent, 5, 100) / 100
    local responseRate = 3 + (speed ^ 1.35) * 100
    local frameTime = math.clamp(tonumber(deltaTime) or (1 / 60), 0, 1 / 20)
    local alpha = 1 - math.exp(-responseRate * frameTime)
    camera.CFrame = camera.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))

    local displayName = chosenPlayer.DisplayName or chosenPlayer.Name
    H.setAimStatus(
        string.format("Цель: %s | %d px | скорость %d%% | через стены: %s", displayName, math.floor(chosenDistance + 0.5), H.settings.AimStrengthPercent, H.settings.AimThroughWalls and "ВКЛ" or "ВЫКЛ"),
        string.format("Target: %s | %d px | speed %d%% | through walls: %s", displayName, math.floor(chosenDistance + 0.5), H.settings.AimStrengthPercent, H.settings.AimThroughWalls and "ON" or "OFF")
    )
end)

-- In a normal LocalScript, `script` is an Instance. When source is executed
-- through loadstring, `script` may be nil, so guard the optional lifecycle hook.
-- This lifecycle hook is optional: `script` is not guaranteed in dynamically executed chunks.
if script and script.Destroying then
    script.Destroying:Connect(function()
    pcall(function() H.RunService:UnbindFromRenderStep("DevToolsAimAssist") end)
    if H.clearFlight then pcall(H.clearFlight) end
    H.restoreMovementOverrides(H.LocalPlayer.Character and H.LocalPlayer.Character:FindFirstChildOfClass("Humanoid"))
    if H.worldState.fullBrightApplied and H.worldState.savedFullBright then
        H.Lighting.Ambient = H.worldState.savedFullBright.Ambient
        H.Lighting.OutdoorAmbient = H.worldState.savedFullBright.OutdoorAmbient
        H.Lighting.Brightness = H.worldState.savedFullBright.Brightness
        H.Lighting.ExposureCompensation = H.worldState.savedFullBright.ExposureCompensation
    end
    if H.worldState.noFogApplied and H.worldState.savedFog then
        H.Lighting.FogStart = H.worldState.savedFog.FogStart
        H.Lighting.FogEnd = H.worldState.savedFog.FogEnd
    end
    if H.worldState.nightApplied and H.worldState.savedClockTime ~= nil then H.Lighting.ClockTime = H.worldState.savedClockTime end
    for object, wasEnabled in pairs(H.worldState.savedLowGraphics or {}) do
        if object and object.Parent then pcall(function() object.Enabled = wasEnabled end) end
    end
    for _, billboard in pairs(H.spawnMarkerObjects) do if billboard then billboard:Destroy() end end
    table.clear(H.spawnMarkerObjects)
end)
end -- script may be nil when loaded dynamically.

