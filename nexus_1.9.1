H.updateResponsiveScale = function()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    H.responsiveScaleTarget = math.clamp(math.min((viewport.X - 28) / 960, (viewport.Y - 36) / 700), 0.58, 1)
    H.responsiveScale.Scale = H.responsiveScaleTarget * (H.menuAnimationFactor or 1)
end
H.updateResponsiveScale()
H.bindViewportScale = function(camera)
    if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(H.updateResponsiveScale) end
end
