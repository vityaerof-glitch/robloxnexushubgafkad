                pcall(function() H.TweenService:Create(object, TweenInfo.new(0.15), {TextTransparency = 1}):Play() end)
            end
        end
        task.delay(0.2, function()
            if H.releaseOverlay and H.releaseOverlay.Parent then H.releaseOverlay:Destroy() end
            H.releaseOverlay = nil
            H.releaseClosing = false
            if H.openMainAnimated then H.openMainAnimated() end
        end)
    end)

    H.releaseScale.Scale = (H.releaseScaleTarget or 1) * 0.93
    H.TweenService:Create(H.releaseOverlay, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.22}):Play()
