            elseif kind == "found" then
                H.serverHopStatus.Text = (ru and "Сервер найден; выполняю переход… " or "Server found; teleporting… ") .. tostring(detail or "")
            elseif kind == "fresh" then
                H.serverHopStatus.Text = ru and "Другой активный сервер не найден. Создаю новый публичный экземпляр…" or "No other registered server found. Creating a new public instance…"
